# Local development defaults (docker compose in infra/docker). Copy to .env to override.
# These are throwaway local credentials, never production values. Production secrets come
# from the secrets manager (ARCHITECTURE §10, §20).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_VERSION=0.1.0
WEB_ORIGIN=http://localhost:3000
# Only when an edge proxy appends the real client IP to X-Forwarded-For (see docs/CONFIGURATION.md §8).
# TRUST_PROXY=10.0.0.0/8
# Development-only delivery to loopback Mailpit. Production must use disabled until a real
# notification provider is approved and implemented. Never expose Mailpit publicly.
AUTH_NOTIFICATION_TRANSPORT=development
AUTH_MAILPIT_PORT=8025
# Breached-password lookup for new passwords: off (default) or hibp (Have I Been Pwned range API,
# k-anonymity; fails open with a warning). See docs/CONFIGURATION.md §8.
AUTH_BREACHED_PASSWORD_CHECK=off
# "Continue with Google": set both from a Google Cloud OAuth client (type: Web application) whose
# authorised redirect URI is ${WEB_ORIGIN}/api/v1/auth/google/callback, e.g.
# http://localhost:3000/api/v1/auth/google/callback. Leave unset to hide Google sign-in.
# Put real values in apps/api/.env only; never commit the secret.
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# Every environment requires a random 32-byte encryption key (64 hex characters).
# Production also requires an Ed25519 PKCS8 PEM (base64 encoded) signing key.
# Development uses ephemeral signing; replacing encryption keys invalidates TOTP enrolments.
# AUTH_SIGNING_PRIVATE_KEY=
# AUTH_MFA_ENCRYPTION_KEY=

# Field-level encryption of labourer identifiers (D3.1): AES-256-GCM keys as "<version>:<64 hex>"
# (comma-separated during a rotation; new values use FIELD_ENCRYPTION_ACTIVE_KEY_VERSION or the
# highest version) and a separate HMAC key for blind indexes. Required in every environment:
# generate local values with
#   node -e "console.log('1:' + require('node:crypto').randomBytes(32).toString('hex'))"
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Production uses managed key material from the secrets manager / KMS, never these placeholders.
# Losing a key makes the values written with it unreadable. See docs/CONFIGURATION.md §8.
# FIELD_ENCRYPTION_KEYS=1:<64 hex characters>
# FIELD_ENCRYPTION_ACTIVE_KEY_VERSION=1
# FIELD_BLIND_INDEX_KEY=<64 hex characters>

# The API connects as pmb_app (no BYPASSRLS, no DDL). Migrations run as pmb_migrator.
DATABASE_URL=postgresql://pmb_app:pmb_app_dev@localhost:55432/pmb
DATABASE_MIGRATION_URL=postgresql://pmb_migrator:pmb_migrator_dev@localhost:55432/pmb

REDIS_URL=redis://localhost:56379

# S3-compatible storage (RustFS locally). The bucket is created on start-up in development only.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pmb-local
S3_ACCESS_KEY_ID=pmbdev
S3_SECRET_ACCESS_KEY=pmbdevsecret
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# Upload malware scanning: development (no-op that records "not_scanned"; refused in production) or
# disabled (uploads refused). ClamAV is the planned production scanner (ARCHITECTURE §17).
MALWARE_SCANNER=development
# VAT on BQ grand summaries (bq.vat.rate, COMPLIANCE-REVIEW): percent, snapshotted per BQ version.
BQ_VAT_RATE_PERCENT=16

API_DOCS_ENABLED=true
HEALTH_CHECK_TIMEOUT_MS=2000

# Optional: send traces to an OpenTelemetry collector (needs `pnpm start`, which preloads telemetry).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=pm-buddy-api
