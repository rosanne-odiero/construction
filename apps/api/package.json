{
  "name": "@pm-buddy/api",
  "version": "0.1.0",
  "private": true,
  "description": "PM-Buddy REST API (NestJS modular monolith)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node --enable-source-maps --import ./dist/telemetry.js dist/main.js",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.1.0",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.71.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@pm-buddy/domain": "workspace:*",
    "@pm-buddy/types": "workspace:*",
    "@pm-buddy/validation": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/server": "14.0.3",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "6.2.15",
    "nestjs-pino": "^5.3.1",
    "otpauth": "9.6.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.3.2",
    "@pm-buddy/config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "dotenv": "18.0.9",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
