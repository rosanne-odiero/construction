// PM-Buddy database schema. Tables arrive with their deliverables (identity in D1.3, tenancy in D1.4…).
// Row-level security policies, roles and helper functions live in SQL migrations (ARCHITECTURE §6).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  identifier          String               @unique @db.VarChar(254)
  displayName         String               @map("display_name") @db.VarChar(100)
  passwordHash        String               @map("password_hash")
  // A labourer's six-digit sign-in PIN (Argon2id); null for staff and client accounts.
  pinHash             String?              @map("pin_hash")
  pinPepperVersion    Int?                 @map("pin_pepper_version") @db.SmallInt
  verifiedAt          DateTime?            @map("verified_at") @db.Timestamptz
  failedLogins        Int                  @default(0) @map("failed_logins")
  lockedUntil         DateTime?            @map("locked_until") @db.Timestamptz
  mfaSecret           String?              @map("mfa_secret")
  mfaPending          String?              @map("mfa_pending")
  mfaPendingUntil     DateTime?            @map("mfa_pending_until") @db.Timestamptz
  mfaPendingSessionId String?              @map("mfa_pending_session_id") @db.Uuid
  // At least one MFA factor (TOTP secret or passkey). Maintained by app.maintain_user_mfa().
  mfaEnabled          Boolean              @default(false) @map("mfa_enabled")
  mfaCounter          BigInt               @default(-1) @map("mfa_counter")
  mfaFailedAttempts   Int                  @default(0) @map("mfa_failed_attempts")
  mfaLockedUntil      DateTime?            @map("mfa_locked_until") @db.Timestamptz
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  sessions            Session[]
  challenges          AuthChallenge[]
  recoveryCodes       RecoveryCode[]
  memberships         Membership[]
  passkeys            WebAuthnCredential[]
  identities          UserIdentity[]

  @@map("users")
}

// An external sign-in identity linked to a user (Google today). `subject` is the provider's
// stable account ID; the email is the provider-verified address at the last sign-in.
model UserIdentity {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String   @db.VarChar(20)
  subject    String   @db.VarChar(255)
  email      String   @db.VarChar(254)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("user_identities")
}

// Verification codes, reset tokens and WebAuthn challenges (stored as SHA-256 digests). Passkey
// challenges are also bound to the session that requested them.
model AuthChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  sessionId  String?   @map("session_id") @db.Uuid
  purpose    String    @db.VarChar(20)
  digest     String
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([sessionId, purpose])
  @@map("auth_challenges")
}

// A passkey (WebAuthn credential) used as a second factor and for step-up (ARCHITECTURE §7).
// User-scoped like sessions; the public key is not secret, the credential ID is never logged.
model WebAuthnCredential {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]
  name         String    @db.VarChar(60)
  deviceType   String    @map("device_type") @db.VarChar(20)
  backedUp     Boolean   @map("backed_up")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("webauthn_credentials")
}

model Session {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  activeTenantId String?         @map("active_tenant_id") @db.Uuid
  generation     Int             @default(0)
  mfaVerifiedAt  DateTime?       @map("mfa_verified_at") @db.Timestamptz
  authTime       DateTime        @default(now()) @map("auth_time") @db.Timestamptz
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt     DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt      DateTime        @map("expires_at") @db.Timestamptz
  idleExpiresAt  DateTime        @map("idle_expires_at") @db.Timestamptz
  revokedAt      DateTime?       @map("revoked_at") @db.Timestamptz
  // password | google | pin. PIN sessions may only use the labourer portal.
  authMethod     String          @default("password") @map("auth_method") @db.VarChar(10)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]
  challenges     AuthChallenge[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  digest    String    @id @db.VarChar(64)
  sessionId String    @map("session_id") @db.Uuid
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model RecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  digest     String    @unique @db.VarChar(64)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recovery_codes")
}

model Tenant {
  id                  String                 @id @default(uuid()) @map("tenant_id") @db.Uuid
  name                String                 @db.VarChar(150)
  createdBy           String                 @map("created_by") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz
  members             Membership[]
  projects            Project[]
  invites             Invitation[]
  audit               AuditEvent[]
  roles               TenantRole[]
  bqTemplates         BqMappingTemplate[]
  buildups            RateBuildup[]
  units               Unit[]
  materials           Material[]
  suppliers           Supplier[]
  procurementSettings ProcurementSettings?
  trades              Trade[]
  skillLevels         SkillLevel[]
  labourSettings      LabourSettings?
  labourers           Labourer[]
  attendanceSettings  AttendanceSettings?
  timesheetRules      TimesheetRuleVersion[]
  publicHolidays      PublicHoliday[]
  idempotency         IdempotencyRecord[]
  outboxEvents        OutboxEvent[]
  payrollSettings     PayrollSettings?
  statutoryRules      StatutoryRuleVersion[]
  minimumWages        MinimumWageRate[]
  spendingSettings    SpendingSettings?
  costCodes           CostCode[]
  qualitySettings     QualitySettings?
  checklistTemplates  ChecklistTemplate[]

  @@map("tenants")
}

// A custom company role: a named bundle of catalogue permissions (ARCHITECTURE §8). System roles
// live in code (packages/types SYSTEM_ROLE_PERMISSIONS) and are immutable.
model TenantRole {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String       @db.Citext
  permissions String[]
  tenantWide  Boolean      @default(false) @map("tenant_wide")
  createdBy   String       @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     Membership[]
  invitations Invitation[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("tenant_roles")
}

// `role` is a system role key, or "custom" with custom_role_id set (a composite tenant FK).
model Membership {
  tenantId     String              @map("tenant_id") @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  role         String              @db.VarChar(30)
  customRoleId String?             @map("custom_role_id") @db.Uuid
  joinedAt     DateTime            @default(now()) @map("joined_at") @db.Timestamptz
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole   TenantRole?         @relation(fields: [tenantId, customRoleId], references: [tenantId, id], onDelete: Restrict)
  projects     ProjectMembership[]
  labourViews  LabourSavedView[]

  @@id([tenantId, userId])
  @@index([userId])
  @@index([tenantId, customRoleId])
  @@map("memberships")
}

// A project (D2.1). Status follows packages/domain PROJECT_TRANSITIONS, enforced by the API and
// the app.guard_project() trigger; money is KES minor units; business dates are calendar dates.
model Project {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  code             String                 @db.VarChar(20)
  name             String                 @db.VarChar(150)
  description      String?                @db.VarChar(2000)
  clientName       String?                @map("client_name") @db.VarChar(150)
  clientEmail      String?                @map("client_email") @db.VarChar(254)
  clientPhone      String?                @map("client_phone") @db.VarChar(32)
  contractSumMinor BigInt?                @map("contract_sum_minor")
  currency         String                 @default("KES") @db.Char(3)
  contractType     String?                @map("contract_type") @db.VarChar(30)
  startDate        DateTime?              @map("start_date") @db.Date
  endDate          DateTime?              @map("end_date") @db.Date
  county           String?                @db.VarChar(30)
  town             String?                @db.VarChar(100)
  latitude         Decimal?               @db.Decimal(9, 6)
  longitude        Decimal?               @db.Decimal(9, 6)
  status           String                 @default("planning") @db.VarChar(20)
  version          Int                    @default(1)
  createdBy        String?                @map("created_by") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members          ProjectMembership[]
  invitations      InvitationProject[]
  statusChanges    ProjectStatusChange[]
  sites            Site[]
  wbsNodes         WbsNode[]
  milestones       Milestone[]
  bqs              Bq[]
  bqImports        BqImport[]
  instructions     Instruction[]
  variations       VariationOrder[]
  engagements      LabourEngagement[]
  labourRates      LabourRate[]
  gangs            Gang[]
  dnrEvents        DoNotRehireEvent[]
  timesheetRules   TimesheetRuleVersion[]
  timesheetPeriods TimesheetPeriod[]
  payCalendar      PayCalendar?
  allowances       PayrollAllowance[]
  outputs          PieceRateOutput[]
  advances         SalaryAdvance[]
  payrollBatches   PayrollBatch[]
  requisitions     Requisition[]
  rfqs             Rfq[]
  lpos             Lpo[]
  grns             Grn[]
  supplierInvoices SupplierInvoice[]
  scheduleSettings ScheduleSettings?
  scheduleItems    ScheduleActivity[]
  baselines        ScheduleBaseline[]
  scheduleDelays   ScheduleDelay[]
  budgets          Budget[]
  costJournals     CostJournal[]
  costEntries      CostEntry[]
  cashFlowItems    CashFlowItem[]

  completions ProjectCompletion[]

  contractSettings ContractSettings[]
  valuations       Valuation[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("projects")
}

// Append-only lifecycle history (no UPDATE/DELETE for the runtime role).
model ProjectStatusChange {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  fromStatus String   @map("from_status") @db.VarChar(20)
  toStatus   String   @map("to_status") @db.VarChar(20)
  reason     String?  @db.VarChar(500)
  changedBy  String   @map("changed_by") @db.Uuid
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamptz
  project    Project  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, projectId, changedAt])
  @@map("project_status_changes")
}

model Site {
  id                String                @id @default(uuid(7)) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  projectId         String                @map("project_id") @db.Uuid
  name              String                @db.VarChar(120)
  address           String?               @db.VarChar(250)
  version           Int                   @default(1)
  createdBy         String                @map("created_by") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project           Project               @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  geofences         SiteGeofence[]
  gangs             Gang[]
  attendanceDays    AttendanceDay[]
  attendanceRecords AttendanceRecord[]
  anomalies         AttendanceAnomaly[]
  adjustments       TimesheetAdjustment[]
  diaries           SiteDiary[]
  photos            SitePhoto[]
  requisitions      Requisition[]
  lpos              Lpo[]
  grns              Grn[]
  stores            Store[]
  pettyCashFloats   PettyCashFloat[]
  pettyCashExpenses PettyCashExpense[]
  costEntries       CostEntry[]
  costJournalLines  CostJournalLine[]
  inspections       Inspection[]
  snags             Snag[]
  cubeSets          CubeSet[]
  slumpTests        SlumpTest[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, name])
  @@map("sites")
}

model SiteDiary {
  id                    String          @id @default(uuid(7)) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  projectId             String          @map("project_id") @db.Uuid
  siteId                String          @map("site_id") @db.Uuid
  date                  DateTime        @db.Date
  workPerformed         String          @map("work_performed") @db.VarChar(6000)
  weather               String?         @db.VarChar(250)
  delays                String?         @db.VarChar(2000)
  workforceCount        Int?            @map("workforce_count")
  // D6.1: manual (typed in) or attendance (a snapshot by trade, re-checked by the database).
  workforceSource       String          @default("manual") @map("workforce_source") @db.VarChar(12)
  workforceSnapshotAt   DateTime?       @map("workforce_snapshot_at") @db.Timestamptz
  workforceMusterStatus String?         @map("workforce_muster_status") @db.VarChar(12)
  workforceByTrade      Json?           @map("workforce_by_trade")
  status                String          @default("draft") @db.VarChar(20)
  version               Int             @default(1)
  createdBy             String          @map("created_by") @db.Uuid
  submittedBy           String?         @map("submitted_by") @db.Uuid
  submittedAt           DateTime?       @map("submitted_at") @db.Timestamptz
  reviewedBy            String?         @map("reviewed_by") @db.Uuid
  reviewedAt            DateTime?       @map("reviewed_at") @db.Timestamptz
  reviewReason          String?         @map("review_reason") @db.VarChar(500)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  site                  Site            @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: Restrict, onUpdate: NoAction, map: "site_diaries_site_fkey")
  photos                SitePhoto[]
  scheduleDelays        ScheduleDelay[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, siteId, id])
  @@unique([tenantId, siteId, date])
  @@index([tenantId, projectId, id])
  @@map("site_diaries")
}

// One version of a site's geofence. Append-only: the database assigns `version` and
// `effective_from` (app.assign_geofence_version) and refuses updates; the newest version is in force.
model SiteGeofence {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  siteId        String   @map("site_id") @db.Uuid
  version       Int      @default(1)
  kind          String   @db.VarChar(10)
  centerLat     Decimal? @map("center_lat") @db.Decimal(9, 6)
  centerLng     Decimal? @map("center_lng") @db.Decimal(9, 6)
  radiusM       Int?     @map("radius_m")
  polygon       Json?
  areaM2        Decimal  @map("area_m2") @db.Decimal(12, 1)
  perimeterM    Decimal  @map("perimeter_m") @db.Decimal(10, 1)
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz
  createdBy     String   @map("created_by") @db.Uuid
  site          Site     @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Cascade)
  grns          Grn[]

  @@unique([tenantId, siteId, version])
  @@index([tenantId, siteId, effectiveFrom])
  @@map("site_geofences")
}

// A WBS node. Siblings' weights (basis points) must sum to 10,000 before progress is computable.
model WbsNode {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  projectId         String             @map("project_id") @db.Uuid
  parentId          String?            @map("parent_id") @db.Uuid
  code              String             @db.VarChar(30)
  name              String             @db.VarChar(150)
  sortOrder         Int                @default(0) @map("sort_order")
  weightBasisPoints Int                @default(0) @map("weight_basis_points")
  version           Int                @default(1)
  createdBy         String             @map("created_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project           Project            @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  parent            WbsNode?           @relation("WbsTree", fields: [tenantId, projectId, parentId], references: [tenantId, projectId, id], onDelete: NoAction)
  children          WbsNode[]          @relation("WbsTree")
  milestones        Milestone[]
  scheduleItems     ScheduleActivity[]
  inspections       Inspection[]

  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, code])
  @@index([tenantId, projectId, parentId, sortOrder])
  @@map("wbs_nodes")
}

// A milestone. Status follows packages/domain MILESTONE_TRANSITIONS (app.guard_milestone()).
model Milestone {
  id           String            @id @default(uuid(7)) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  projectId    String            @map("project_id") @db.Uuid
  wbsNodeId    String?           @map("wbs_node_id") @db.Uuid
  name         String            @db.VarChar(150)
  dueDate      DateTime          @map("due_date") @db.Date
  status       String            @default("planned") @db.VarChar(20)
  actualDate   DateTime?         @map("actual_date") @db.Date
  statusReason String?           @map("status_reason") @db.VarChar(500)
  version      Int               @default(1)
  createdBy    String            @map("created_by") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project      Project           @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  wbsNode      WbsNode?          @relation(fields: [tenantId, projectId, wbsNodeId], references: [tenantId, projectId, id], onDelete: NoAction)
  // The milestone's place in the schedule network, created when it first gets a dependency (D6.2).
  scheduleLink ScheduleActivity?

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, name])
  @@index([tenantId, projectId, dueDate])
  @@index([tenantId, projectId, wbsNodeId])
  @@map("milestones")
}

model ProjectMembership {
  tenantId    String     @map("tenant_id") @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  permissions String[]
  project     Project    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  membership  Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@id([tenantId, projectId, userId])
  @@map("project_memberships")
}

model Invitation {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  identifier   String              @db.VarChar(254)
  role         String              @db.VarChar(30)
  customRoleId String?             @map("custom_role_id") @db.Uuid
  digest       String              @unique @db.VarChar(64)
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz
  acceptedAt   DateTime?           @map("accepted_at") @db.Timestamptz
  createdBy    String              @map("created_by") @db.Uuid
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customRole   TenantRole?         @relation(fields: [tenantId, customRoleId], references: [tenantId, id], onDelete: Cascade)
  projects     InvitationProject[]

  @@unique([tenantId, id])
  @@index([identifier])
  @@index([tenantId, customRoleId])
  @@map("invitations")
}

model InvitationProject {
  tenantId     String     @map("tenant_id") @db.Uuid
  invitationId String     @map("invitation_id") @db.Uuid
  projectId    String     @map("project_id") @db.Uuid
  invitation   Invitation @relation(fields: [tenantId, invitationId], references: [tenantId, id], onDelete: Cascade)
  project      Project    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, invitationId, projectId])
  @@index([tenantId, projectId])
  @@map("invitation_projects")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceId   String   @map("resource_id")
  requestId    String   @map("request_id")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  sequence     BigInt   @default(autoincrement())
  previousHash String   @default("") @map("previous_hash")
  hash         String   @default("")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, sequence])
  @@map("audit_events")
}

// A saved BQ column mapping (D2.2), matched to a sheet by its header signature. Columns are offsets
// from the first header cell; dataOffset is firstDataRow − headerRow.
model BqMappingTemplate {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String   @db.VarChar(100)
  signature  String   @db.VarChar(500)
  columns    Json
  dataOffset Int      @map("data_offset")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, signature])
  @@map("bq_mapping_templates")
}

// A project's Bill of Quantities (one per project); its versions carry the history.
model Bq {
  id           String                @id @default(uuid(7)) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  projectId    String                @map("project_id") @db.Uuid
  name         String                @db.VarChar(150)
  createdBy    String                @map("created_by") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz
  project      Project               @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  versions     BqVersion[]
  variations   VariationOrder[]
  rateLinks    BqItemRateLink[]
  measurements ProgressMeasurement[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId])
  @@unique([tenantId, projectId, id])
  @@map("bqs")
}

// A BQ version. Version 1 (original contract) is imported as a draft and approved as the baseline;
// every later version comes from one approved variation (linear: one child per parent). Approved
// versions never change (app.guard_bq_version); totals are checked against the bills and items
// when the transaction commits (app.check_bq_version_totals).
model BqVersion {
  id              String                @id @default(uuid(7)) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  projectId       String                @map("project_id") @db.Uuid
  bqId            String                @map("bq_id") @db.Uuid
  versionNo       Int                   @map("version_no")
  status          String                @default("draft") @db.VarChar(20)
  source          String                @default("import") @db.VarChar(20)
  vatRatePercent  Decimal               @map("vat_rate_percent") @db.Decimal(7, 4)
  vatRuleKey      String                @map("vat_rule_key") @db.VarChar(40)
  vatRuleStatus   String                @map("vat_rule_status") @db.VarChar(30)
  rounding        String                @db.VarChar(20)
  subtotalMinor   BigInt                @map("subtotal_minor")
  vatMinor        BigInt                @map("vat_minor")
  grandTotalMinor BigInt                @map("grand_total_minor")
  billCount       Int                   @map("bill_count")
  itemCount       Int                   @map("item_count")
  createdBy       String                @map("created_by") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedBy       String                @map("updated_by") @db.Uuid
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version         Int                   @default(1)
  parentVersionId String?               @map("parent_version_id") @db.Uuid
  variationId     String?               @map("variation_id") @db.Uuid
  approvedBy      String?               @map("approved_by") @db.Uuid
  approvedAt      DateTime?             @map("approved_at") @db.Timestamptz
  bq              Bq                    @relation(fields: [tenantId, projectId, bqId], references: [tenantId, projectId, id], onDelete: Cascade)
  parent          BqVersion?            @relation("BqVersionHistory", fields: [tenantId, bqId, parentVersionId], references: [tenantId, bqId, id], onDelete: Restrict)
  children        BqVersion[]           @relation("BqVersionHistory")
  variation       VariationOrder?       @relation("VariationResult", fields: [tenantId, bqId, variationId], references: [tenantId, bqId, id], onDelete: Restrict)
  basedVariations VariationOrder[]      @relation("VariationBase")
  bills           BqBill[]
  imports         BqImport[]
  rateLinks       BqItemRateLink[]
  measurements    ProgressMeasurement[]
  budgets         Budget[]
  valuations      Valuation[]

  @@unique([tenantId, id])
  @@unique([tenantId, bqId, versionNo])
  @@unique([tenantId, bqId, id])
  @@unique([tenantId, parentVersionId])
  @@unique([tenantId, variationId])
  @@index([tenantId, projectId])
  @@map("bq_versions")
}

model BqBill {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  versionId       String          @map("version_id") @db.Uuid
  number          String          @db.VarChar(20)
  title           String          @db.VarChar(200)
  kind            String          @db.VarChar(20)
  sortOrder       Int             @map("sort_order")
  totalMinor      BigInt          @map("total_minor")
  sheetTotalMinor BigInt?         @map("sheet_total_minor")
  sourceSheet     String          @map("source_sheet") @db.VarChar(100)
  // Stable across versions (D2.3): variation lines and comparisons refer to it.
  lineageId       String          @map("lineage_id") @db.Uuid
  version         BqVersion       @relation(fields: [tenantId, versionId], references: [tenantId, id], onDelete: Cascade)
  sections        BqSection[]
  items           BqItem[]
  variationLines  VariationLine[]

  @@unique([tenantId, versionId, id])
  @@unique([tenantId, versionId, number])
  @@unique([tenantId, versionId, lineageId])
  @@index([tenantId, versionId, sortOrder])
  @@map("bq_bills")
}

// A section/element heading within a bill; notes keep preamble text found under the heading.
model BqSection {
  id             String          @id @default(uuid(7)) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  versionId      String          @map("version_id") @db.Uuid
  billId         String          @map("bill_id") @db.Uuid
  code           String?         @db.VarChar(30)
  title          String?         @db.VarChar(300)
  notes          String?         @db.VarChar(4000)
  sortOrder      Int             @map("sort_order")
  totalMinor     BigInt          @map("total_minor")
  lineageId      String          @map("lineage_id") @db.Uuid
  bill           BqBill          @relation(fields: [tenantId, versionId, billId], references: [tenantId, versionId, id], onDelete: Cascade)
  items          BqItem[]
  variationLines VariationLine[]

  @@unique([tenantId, versionId, id])
  @@unique([tenantId, versionId, lineageId])
  @@index([tenantId, versionId, billId, sortOrder])
  @@map("bq_sections")
}

// A BQ item. Quantity and rate are exact decimals; amounts are KES minor units. amountSource says
// how the amount was obtained (CHECK bq_items_amount_rule_check); the sheet's amount is kept apart.
model BqItem {
  id                String                @id @default(uuid(7)) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  versionId         String                @map("version_id") @db.Uuid
  billId            String                @map("bill_id") @db.Uuid
  sectionId         String?               @map("section_id") @db.Uuid
  lineageId         String                @map("lineage_id") @db.Uuid
  ref               String?               @db.VarChar(30)
  description       String                @db.VarChar(4000)
  unit              String?               @db.VarChar(10)
  unitRaw           String?               @map("unit_raw") @db.VarChar(30)
  quantity          Decimal?              @db.Decimal(20, 4)
  rate              Decimal?              @db.Decimal(20, 4)
  amountMinor       BigInt                @map("amount_minor")
  sheetAmountMinor  BigInt?               @map("sheet_amount_minor")
  amountSource      String                @map("amount_source") @db.VarChar(20)
  overrideReason    String?               @map("override_reason") @db.VarChar(500)
  kind              String                @db.VarChar(20)
  notes             String?               @db.VarChar(1000)
  // Null for items added by a variation (no spreadsheet row).
  sourceSheet       String?               @map("source_sheet") @db.VarChar(100)
  sourceRow         Int?                  @map("source_row")
  hasFormula        Boolean               @default(false) @map("has_formula")
  sortOrder         Int                   @map("sort_order")
  bill              BqBill                @relation(fields: [tenantId, versionId, billId], references: [tenantId, versionId, id], onDelete: Cascade)
  section           BqSection?            @relation(fields: [tenantId, versionId, sectionId], references: [tenantId, versionId, id], onDelete: Cascade)
  variationLines    VariationLine[]
  rateLinks         BqItemRateLink[]
  pieceRateOutputs  PieceRateOutput[]
  requisitionLines  RequisitionLine[]
  stockMovements    StockMovement[]
  stockEntries      StockLedgerEntry[]
  measurements      ProgressMeasurement[]
  scheduleItems     ScheduleActivity[]
  budgetLines       BudgetLine[]
  costEntries       CostEntry[]
  costJournalLines  CostJournalLine[]
  pettyCashExpenses PettyCashExpense[]
  inspections       Inspection[]
  valuationLines    ValuationLine[]
  valuationMaterial ValuationMaterial[]

  @@unique([tenantId, id])
  @@unique([tenantId, versionId, lineageId])
  @@index([tenantId, versionId, billId, sortOrder])
  @@index([tenantId, versionId, sectionId])
  @@map("bq_items")
}

// An uploaded BQ workbook and its import state (uploaded → parsed → mapped → validated →
// committed, or failed/abandoned; superseded when a later import replaces the draft). Source
// columns never change (app.guard_bq_import); imports are never deleted.
model BqImport {
  id            String     @id @default(uuid(7)) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  projectId     String     @map("project_id") @db.Uuid
  status        String     @default("uploaded") @db.VarChar(20)
  fileName      String     @map("file_name") @db.VarChar(150)
  fileType      String     @map("file_type") @db.VarChar(4)
  fileSizeBytes Int        @map("file_size_bytes")
  fileSha256    String     @map("file_sha256") @db.Char(64)
  sourceKey     String     @map("source_key") @db.VarChar(300)
  parsedKey     String?    @map("parsed_key") @db.VarChar(300)
  scanStatus    String     @map("scan_status") @db.VarChar(20)
  scanEngine    String     @map("scan_engine") @db.VarChar(60)
  scannedAt     DateTime   @map("scanned_at") @db.Timestamptz
  failureCode   String?    @map("failure_code") @db.VarChar(40)
  sheets        Json?
  mapping       Json?
  resolutions   Json       @default("{\"rows\": [], \"accepted\": []}")
  report        Json?
  reportDigest  String?    @map("report_digest") @db.Char(64)
  bqVersionId   String?    @map("bq_version_id") @db.Uuid
  uploadedBy    String     @map("uploaded_by") @db.Uuid
  committedBy   String?    @map("committed_by") @db.Uuid
  contributors  String[]   @default([]) @db.Uuid
  committedAt   DateTime?  @map("committed_at") @db.Timestamptz
  version       Int        @default(1)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project       Project    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  bqVersion     BqVersion? @relation(fields: [tenantId, bqVersionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, projectId, createdAt])
  @@index([tenantId, bqVersionId])
  @@map("bq_imports")
}

// An Architect's/Engineer's Instruction (D2.3): the register entry a variation is raised against.
// Number unique per project; attachments are metadata only (name and reference).
model Instruction {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  number      String           @db.VarChar(30)
  issuedOn    DateTime         @map("issued_on") @db.Date
  issuerName  String           @map("issuer_name") @db.VarChar(150)
  issuerRole  String           @map("issuer_role") @db.VarChar(30)
  subject     String           @db.VarChar(200)
  description String?          @db.VarChar(4000)
  attachments Json             @default("[]")
  status      String           @default("open") @db.VarChar(10)
  version     Int              @default(1)
  createdBy   String           @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedBy   String           @map("updated_by") @db.Uuid
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  project     Project          @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  variations  VariationOrder[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, number])
  @@map("instructions")
}

// A Variation Order (D2.3). Status follows packages/domain VARIATION_TRANSITIONS, enforced by the
// API and app.guard_variation_order; submission freezes a snapshot digest; a decision is made by
// someone other than the creator or submitter; approval creates the next BQ version atomically.
model VariationOrder {
  id             String                  @id @default(uuid(7)) @db.Uuid
  tenantId       String                  @map("tenant_id") @db.Uuid
  projectId      String                  @map("project_id") @db.Uuid
  bqId           String                  @map("bq_id") @db.Uuid
  instructionId  String                  @map("instruction_id") @db.Uuid
  baseVersionId  String                  @map("base_version_id") @db.Uuid
  number         String                  @db.VarChar(30)
  title          String                  @db.VarChar(200)
  description    String?                 @db.VarChar(4000)
  status         String                  @default("draft") @db.VarChar(20)
  additionsMinor BigInt                  @default(0) @map("additions_minor")
  omissionsMinor BigInt                  @default(0) @map("omissions_minor")
  netMinor       BigInt                  @default(0) @map("net_minor")
  lineCount      Int                     @default(0) @map("line_count")
  snapshotDigest String?                 @map("snapshot_digest") @db.Char(64)
  submittedBy    String?                 @map("submitted_by") @db.Uuid
  submittedAt    DateTime?               @map("submitted_at") @db.Timestamptz
  decidedBy      String?                 @map("decided_by") @db.Uuid
  decidedAt      DateTime?               @map("decided_at") @db.Timestamptz
  decisionReason String?                 @map("decision_reason") @db.VarChar(500)
  cancelReason   String?                 @map("cancel_reason") @db.VarChar(500)
  version        Int                     @default(1)
  createdBy      String                  @map("created_by") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedBy      String                  @map("updated_by") @db.Uuid
  updatedAt      DateTime                @default(now()) @map("updated_at") @db.Timestamptz
  contributors   String[]                @default([]) @db.Uuid
  project        Project                 @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  bq             Bq                      @relation(fields: [tenantId, projectId, bqId], references: [tenantId, projectId, id], onDelete: Cascade)
  instruction    Instruction             @relation(fields: [tenantId, projectId, instructionId], references: [tenantId, projectId, id], onDelete: Restrict)
  baseVersion    BqVersion               @relation("VariationBase", fields: [tenantId, bqId, baseVersionId], references: [tenantId, bqId, id], onDelete: Restrict)
  resultVersions BqVersion[]             @relation("VariationResult")
  lines          VariationLine[]
  statusChanges  VariationStatusChange[]

  @@unique([tenantId, id])
  @@unique([tenantId, bqId, id])
  @@unique([tenantId, id, baseVersionId])
  @@unique([tenantId, projectId, number])
  @@index([tenantId, projectId, status])
  @@index([tenantId, instructionId])
  @@map("variation_orders")
}

// One change in a variation, against the variation's base version (rebase cascades the version).
model VariationLine {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  variationId      String         @map("variation_id") @db.Uuid
  baseVersionId    String         @map("base_version_id") @db.Uuid
  lineNo           Int            @map("line_no")
  action           String         @db.VarChar(10)
  itemLineageId    String?        @map("item_lineage_id") @db.Uuid
  billLineageId    String?        @map("bill_lineage_id") @db.Uuid
  sectionLineageId String?        @map("section_lineage_id") @db.Uuid
  newSectionCode   String?        @map("new_section_code") @db.VarChar(30)
  newSectionTitle  String?        @map("new_section_title") @db.VarChar(300)
  newLineageId     String?        @map("new_lineage_id") @db.Uuid
  ref              String?        @db.VarChar(30)
  description      String?        @db.VarChar(4000)
  unit             String?        @db.VarChar(10)
  unitRaw          String?        @map("unit_raw") @db.VarChar(30)
  kind             String?        @db.VarChar(20)
  quantity         Decimal?       @db.Decimal(20, 4)
  rate             Decimal?       @db.Decimal(20, 4)
  amountMinor      BigInt?        @map("amount_minor")
  note             String?        @db.VarChar(500)
  baseAmountMinor  BigInt         @map("base_amount_minor")
  newAmountMinor   BigInt         @map("new_amount_minor")
  deltaMinor       BigInt         @map("delta_minor")
  variation        VariationOrder @relation(fields: [tenantId, variationId, baseVersionId], references: [tenantId, id, baseVersionId], onDelete: Cascade)
  item             BqItem?        @relation(fields: [tenantId, baseVersionId, itemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  bill             BqBill?        @relation(fields: [tenantId, baseVersionId, billLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  section          BqSection?     @relation(fields: [tenantId, baseVersionId, sectionLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict, map: "variation_lines_base_version_section_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, variationId, lineNo])
  @@unique([tenantId, variationId, itemLineageId])
  @@unique([tenantId, newLineageId])
  @@map("variation_lines")
}

// Append-only status history of a variation (reasons are kept here, not in the audit log).
model VariationStatusChange {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  variationId    String         @map("variation_id") @db.Uuid
  fromStatus     String?        @map("from_status") @db.VarChar(20)
  toStatus       String         @map("to_status") @db.VarChar(20)
  action         String         @db.VarChar(20)
  reason         String?        @db.VarChar(500)
  snapshotDigest String?        @map("snapshot_digest") @db.Char(64)
  changedBy      String         @map("changed_by") @db.Uuid
  changedAt      DateTime       @default(now()) @map("changed_at") @db.Timestamptz
  variation      VariationOrder @relation(fields: [tenantId, variationId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, variationId, changedAt])
  @@map("variation_status_changes")
}

// A company's named composite rate per unit of work (D2.3). Editing appends a version; the header
// mirrors the newest one (app.check_buildup_totals).
model RateBuildup {
  id               String               @id @default(uuid(7)) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  code             String               @db.VarChar(30)
  name             String               @db.VarChar(150)
  unit             String               @db.VarChar(10)
  currentVersionNo Int                  @map("current_version_no")
  version          Int                  @default(1)
  createdBy        String               @map("created_by") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedBy        String               @map("updated_by") @db.Uuid
  updatedAt        DateTime             @default(now()) @map("updated_at") @db.Timestamptz
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions         RateBuildupVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("rate_buildups")
}

// One immutable version of a build-up with its rate (null while any line is unpriced).
model RateBuildupVersion {
  id            String                @id @default(uuid(7)) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  buildupId     String                @map("buildup_id") @db.Uuid
  versionNo     Int                   @map("version_no")
  name          String                @db.VarChar(150)
  unit          String                @db.VarChar(10)
  assumptions   String?               @db.VarChar(2000)
  rateMinor     BigInt?               @map("rate_minor")
  pricedMinor   BigInt                @map("priced_minor")
  unpricedLines Int                   @map("unpriced_lines")
  lineCount     Int                   @map("line_count")
  rounding      String                @db.VarChar(20)
  createdBy     String                @map("created_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz
  buildup       RateBuildup           @relation(fields: [tenantId, buildupId], references: [tenantId, id], onDelete: Restrict)
  lines         RateBuildupLine[]
  links         BqItemRateLink[]
  materialMaps  BuildupLineMaterial[]

  @@unique([tenantId, id])
  @@unique([tenantId, buildupId, id])
  @@unique([tenantId, buildupId, versionNo])
  @@map("rate_buildup_versions")
}

// A resource line: quantity per output unit, waste % and unit cost; amount rounded half-up per line.
model RateBuildupLine {
  id            String                @id @default(uuid(7)) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  versionId     String                @map("version_id") @db.Uuid
  lineNo        Int                   @map("line_no")
  kind          String                @db.VarChar(10)
  resourceName  String                @map("resource_name") @db.VarChar(120)
  unit          String                @db.VarChar(30)
  quantity      Decimal               @db.Decimal(15, 6)
  wastePercent  Decimal?              @map("waste_percent") @db.Decimal(7, 4)
  unitCostMinor BigInt?               @map("unit_cost_minor")
  amountMinor   BigInt?               @map("amount_minor")
  version       RateBuildupVersion    @relation(fields: [tenantId, versionId], references: [tenantId, id], onDelete: Cascade)
  materialMaps  BuildupLineMaterial[]

  @@unique([tenantId, id])
  @@unique([tenantId, versionId, id])
  @@unique([tenantId, versionId, lineNo])
  @@map("rate_buildup_lines")
}

// A BQ item (by lineage) linked to a build-up version; unlinking stamps unlinked_at, never deletes.
model BqItemRateLink {
  id               String             @id @default(uuid(7)) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  projectId        String             @map("project_id") @db.Uuid
  bqId             String             @map("bq_id") @db.Uuid
  versionId        String             @map("version_id") @db.Uuid
  itemLineageId    String             @map("item_lineage_id") @db.Uuid
  buildupId        String             @map("buildup_id") @db.Uuid
  buildupVersionId String             @map("buildup_version_id") @db.Uuid
  linkedBy         String             @map("linked_by") @db.Uuid
  linkedAt         DateTime           @default(now()) @map("linked_at") @db.Timestamptz
  unlinkedBy       String?            @map("unlinked_by") @db.Uuid
  unlinkedAt       DateTime?          @map("unlinked_at") @db.Timestamptz
  bq               Bq                 @relation(fields: [tenantId, projectId, bqId], references: [tenantId, projectId, id], onDelete: Cascade)
  version          BqVersion          @relation(fields: [tenantId, bqId, versionId], references: [tenantId, bqId, id], onDelete: Restrict)
  item             BqItem             @relation(fields: [tenantId, versionId, itemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  buildupVersion   RateBuildupVersion @relation(fields: [tenantId, buildupId, buildupVersionId], references: [tenantId, buildupId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, bqId, itemLineageId])
  @@index([tenantId, buildupId])
  @@map("bq_item_rate_links")
}

// D5.1 procurement catalogue (ARCHITECTURE §4.4). Standard units live in code
// (packages/domain STANDARD_UNITS); a company adds its own units here (immutable, only archived).
model Unit {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  code           String   @db.VarChar(20)
  name           String   @db.VarChar(60)
  nameSw         String?  @map("name_sw") @db.VarChar(60)
  dimension      String   @db.VarChar(10)
  equalsQuantity Decimal? @map("equals_quantity") @db.Decimal(20, 6)
  equalsUnit     String?  @map("equals_unit") @db.VarChar(20)
  status         String   @default("active") @db.VarChar(10)
  version        Int      @default(1)
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedBy      String   @map("updated_by") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("units")
}

// A catalogue material with its base unit and category attributes (bar diameter, gauge…).
model Material {
  id               String                @id @default(uuid(7)) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  code             String                @db.VarChar(20)
  name             String                @db.Citext
  nameSw           String?               @map("name_sw") @db.VarChar(150)
  category         String                @db.VarChar(20)
  baseUnit         String                @map("base_unit") @db.VarChar(20)
  spec             String?               @db.VarChar(200)
  attributes       Json                  @default("{}")
  notes            String?               @db.VarChar(2000)
  status           String                @default("active") @db.VarChar(10)
  version          Int                   @default(1)
  createdBy        String                @map("created_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedBy        String                @map("updated_by") @db.Uuid
  updatedAt        DateTime              @default(now()) @map("updated_at") @db.Timestamptz
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversions      UnitConversion[]
  prices           MaterialPrice[]
  requisitionLines RequisitionLine[]
  lpoLines         LpoLine[]
  stockBalances    StockBalance[]
  stockEntries     StockLedgerEntry[]
  movementLines    StockMovementLine[]
  transferLines    StockTransferLine[]
  stockTakeLines   StockTakeLine[]
  reorderLevels    StockReorderLevel[]
  buildupMaps      BuildupLineMaterial[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId, category])
  @@map("materials")
}

// An explicit, effective-dated factor for one material (optionally one supplier):
// from_quantity from_unit = to_quantity to_unit. Never edited; only ended.
model UnitConversion {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  materialId    String    @map("material_id") @db.Uuid
  supplierId    String?   @map("supplier_id") @db.Uuid
  fromUnit      String    @map("from_unit") @db.VarChar(20)
  fromQuantity  Decimal   @map("from_quantity") @db.Decimal(20, 6)
  toUnit        String    @map("to_unit") @db.VarChar(20)
  toQuantity    Decimal   @map("to_quantity") @db.Decimal(20, 6)
  pairKey       String    @map("pair_key") @db.VarChar(60)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  note          String?   @db.VarChar(300)
  createdBy     String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  endedBy       String?   @map("ended_by") @db.Uuid
  endedAt       DateTime? @map("ended_at") @db.Timestamptz
  material      Material  @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Restrict)
  supplier      Supplier? @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, materialId])
  @@map("unit_conversions")
}

// A supplier: the KRA PIN is stored encrypted with a blind index (unique per company) and a mask.
model Supplier {
  id                String                  @id @default(uuid(7)) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  code              String                  @db.VarChar(20)
  legalName         String                  @map("legal_name") @db.VarChar(200)
  tradingName       String?                 @map("trading_name") @db.VarChar(200)
  kraPinEnc         Bytes?                  @map("kra_pin_enc")
  kraPinBidx        String?                 @map("kra_pin_bidx") @db.Char(64)
  kraPinMasked      String?                 @map("kra_pin_masked") @db.VarChar(16)
  etimsStatus       String                  @default("unknown") @map("etims_status") @db.VarChar(20)
  etimsCheckedOn    DateTime?               @map("etims_checked_on") @db.Date
  status            String                  @default("active") @db.VarChar(10)
  statusReason      String?                 @map("status_reason") @db.VarChar(500)
  creditDays        Int                     @default(0) @map("credit_days")
  creditLimitMinor  BigInt?                 @map("credit_limit_minor")
  notes             String?                 @db.VarChar(2000)
  version           Int                     @default(1)
  createdBy         String                  @map("created_by") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedBy         String                  @map("updated_by") @db.Uuid
  updatedAt         DateTime                @default(now()) @map("updated_at") @db.Timestamptz
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts          SupplierContact[]
  phoneChanges      SupplierPhoneChange[]
  payoutVersions    SupplierPayoutVersion[]
  conversions       UnitConversion[]
  prices            MaterialPrice[]
  rfqs              RfqSupplier[]
  lpos              Lpo[]
  invoices          SupplierInvoice[]
  costEntries       CostEntry[]
  costJournalLines  CostJournalLine[]
  pettyCashExpenses PettyCashExpense[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, kraPinBidx])
  @@map("suppliers")
}

// A supplier contact; the phone is encrypted with a blind index; phone_changed_* are set by the
// database (app.record_contact_phone_change). At most one primary contact (partial index in SQL).
model SupplierContact {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  supplierId     String    @map("supplier_id") @db.Uuid
  name           String    @db.VarChar(100)
  role           String?   @db.VarChar(60)
  phoneEnc       Bytes?    @map("phone_enc")
  phoneBidx      String?   @map("phone_bidx") @db.Char(64)
  phoneMasked    String?   @map("phone_masked") @db.VarChar(20)
  phoneChangedBy String?   @map("phone_changed_by") @db.Uuid
  phoneChangedAt DateTime? @map("phone_changed_at") @db.Timestamptz
  email          String?   @db.VarChar(254)
  isPrimary      Boolean   @default(false) @map("is_primary")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  supplier       Supplier  @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, supplierId])
  @@index([tenantId, phoneBidx])
  @@map("supplier_contacts")
}

// Every change to a supplier contact's phone (append-only, written by a trigger).
model SupplierPhoneChange {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  contactId  String   @map("contact_id") @db.Uuid
  action     String   @db.VarChar(10)
  changedBy  String?  @map("changed_by") @db.Uuid
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamptz
  supplier   Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, supplierId, changedAt])
  @@map("supplier_phone_changes")
}

// One immutable version of a supplier's payout details (maker-checker): pending until a person
// who is not a contributor verifies it; a newer proposal supersedes it. One current version per
// supplier (partial unique index in SQL).
model SupplierPayoutVersion {
  id                   String           @id @default(uuid(7)) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  supplierId           String           @map("supplier_id") @db.Uuid
  versionNo            Int              @map("version_no")
  status               String           @default("pending") @db.VarChar(12)
  mpesaKind            String           @map("mpesa_kind") @db.VarChar(10)
  paybillNumber        String?          @map("paybill_number") @db.VarChar(7)
  accountReference     String?          @map("account_reference") @db.VarChar(20)
  tillNumber           String?          @map("till_number") @db.VarChar(7)
  bankName             String?          @map("bank_name") @db.VarChar(100)
  bankBranch           String?          @map("bank_branch") @db.VarChar(100)
  accountName          String?          @map("account_name") @db.VarChar(150)
  accountNumberEnc     Bytes?           @map("account_number_enc")
  accountNumberMasked  String?          @map("account_number_masked") @db.VarChar(10)
  proposedBy           String           @map("proposed_by") @db.Uuid
  proposedAt           DateTime         @default(now()) @map("proposed_at") @db.Timestamptz
  contributors         String[]         @default([]) @db.Uuid
  contactChangeWarning Boolean          @default(false) @map("contact_change_warning")
  verifiedBy           String?          @map("verified_by") @db.Uuid
  verifiedAt           DateTime?        @map("verified_at") @db.Timestamptz
  verificationMethod   String?          @map("verification_method") @db.VarChar(30)
  verificationNote     String?          @map("verification_note") @db.VarChar(500)
  rejectedBy           String?          @map("rejected_by") @db.Uuid
  rejectedAt           DateTime?        @map("rejected_at") @db.Timestamptz
  rejectionReason      String?          @map("rejection_reason") @db.VarChar(500)
  supersededBy         String?          @map("superseded_by") @db.Uuid
  supersededAt         DateTime?        @map("superseded_at") @db.Timestamptz
  supplier             Supplier         @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Cascade)
  payables             InvoicePayable[]

  @@unique([tenantId, id])
  @@unique([tenantId, supplierId, versionNo])
  @@map("supplier_payout_versions")
}

// Append-only price history: corrections are new rows (corrects_price_id); net/gross per VAT
// treatment and the comparable price per base unit are snapshotted with the conversion used.
model MaterialPrice {
  id                       String          @id @default(uuid(7)) @db.Uuid
  tenantId                 String          @map("tenant_id") @db.Uuid
  materialId               String          @map("material_id") @db.Uuid
  supplierId               String          @map("supplier_id") @db.Uuid
  unit                     String          @db.VarChar(20)
  unitPriceMinor           BigInt          @map("unit_price_minor")
  currency                 String          @default("KES") @db.Char(3)
  vatTreatment             String          @map("vat_treatment") @db.VarChar(15)
  vatRatePercent           Decimal?        @map("vat_rate_percent") @db.Decimal(7, 4)
  vatRuleStatus            String?         @map("vat_rule_status") @db.VarChar(20)
  netUnitPriceMinor        BigInt          @map("net_unit_price_minor")
  grossUnitPriceMinor      BigInt          @map("gross_unit_price_minor")
  effectiveOn              DateTime        @map("effective_on") @db.Date
  source                   String          @db.VarChar(10)
  sourceReference          String?         @map("source_reference") @db.VarChar(100)
  note                     String?         @db.VarChar(500)
  comparableUnit           String?         @map("comparable_unit") @db.VarChar(20)
  comparableUnitPriceMinor Decimal?        @map("comparable_unit_price_minor") @db.Decimal(30, 6)
  conversionSnapshot       Json?           @map("conversion_snapshot")
  previousPriceId          String?         @map("previous_price_id") @db.Uuid
  changePercent            Decimal?        @map("change_percent") @db.Decimal(14, 4)
  alertState               String          @map("alert_state") @db.VarChar(20)
  alertThresholdPercent    Decimal         @map("alert_threshold_percent") @db.Decimal(8, 4)
  correctsPriceId          String?         @map("corrects_price_id") @db.Uuid
  correctionReason         String?         @map("correction_reason") @db.VarChar(500)
  recordedBy               String          @map("recorded_by") @db.Uuid
  recordedAt               DateTime        @default(now()) @map("recorded_at") @db.Timestamptz
  material                 Material        @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Restrict)
  supplier                 Supplier        @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  previous                 MaterialPrice?  @relation("PricePrevious", fields: [tenantId, materialId, previousPriceId], references: [tenantId, materialId, id], onDelete: Restrict, map: "material_prices_previous_fkey")
  followers                MaterialPrice[] @relation("PricePrevious")
  quotationLines           QuotationLine[]
  corrects                 MaterialPrice?  @relation("PriceCorrection", fields: [tenantId, materialId, correctsPriceId], references: [tenantId, materialId, id], onDelete: Restrict, map: "material_prices_corrects_fkey")
  correctedBy              MaterialPrice[] @relation("PriceCorrection")

  @@unique([tenantId, id])
  @@unique([tenantId, materialId, id])
  @@unique([tenantId, correctsPriceId])
  @@index([tenantId, materialId, supplierId, effectiveOn], map: "material_prices_history_idx")
  @@index([tenantId, alertState])
  @@index([tenantId, supplierId])
  @@map("material_prices")
}

// Company procurement settings (absent row = defaults, e.g. a 10 % price-change alert).
model ProcurementSettings {
  tenantId                   String   @id @map("tenant_id") @db.Uuid
  priceChangeAlertPercent    Decimal  @map("price_change_alert_percent") @db.Decimal(8, 4)
  // D5.2: procurement.min_quotes and the three-way match settings (CONFIGURATION §5).
  minQuotes                  Int      @default(3) @map("min_quotes")
  qtyTolerancePercent        Decimal  @default(0) @map("qty_tolerance_percent") @db.Decimal(7, 4)
  priceTolerancePercent      Decimal  @default(0) @map("price_tolerance_percent") @db.Decimal(7, 4)
  blockPaymentWithoutEtims   Boolean  @default(true) @map("block_payment_without_etims")
  // D5.3: stores.consumption_variance_percent (CONFIGURATION §5).
  consumptionVariancePercent Decimal  @default(10) @map("consumption_variance_percent") @db.Decimal(7, 4)
  version                    Int      @default(1)
  updatedBy                  String   @map("updated_by") @db.Uuid
  updatedAt                  DateTime @default(now()) @map("updated_at") @db.Timestamptz
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("procurement_settings")
}

// Labour registry (D3.1, ARCHITECTURE §4.2). Identifiers are encrypted per field (AES-256-GCM,
// `*_enc` = format byte, key version, nonce, ciphertext, tag) with keyed blind indexes (`*_bidx`,
// HMAC-SHA-256) for exact matching; plaintext identifiers are never stored.

// A company trade (brief §5.4: configurable list) with English and Kiswahili names.
model Trade {
  id         String             @id @default(uuid(7)) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  key        String             @db.VarChar(40)
  nameEn     String             @map("name_en") @db.VarChar(80)
  nameSw     String             @map("name_sw") @db.VarChar(80)
  active     Boolean            @default(true)
  sortOrder  Int                @default(0) @map("sort_order")
  version    Int                @default(1)
  createdBy  String             @map("created_by") @db.Uuid
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  labourers  Labourer[]
  rates      LabourRate[]
  allowances PayrollAllowance[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("trades")
}

// A company skill level aligned to an NCA category (skilled, semi-skilled, unskilled, supervisor).
model SkillLevel {
  id                    String       @id @default(uuid(7)) @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  key                   String       @db.VarChar(40)
  nameEn                String       @map("name_en") @db.VarChar(80)
  nameSw                String       @map("name_sw") @db.VarChar(80)
  ncaCategory           String       @map("nca_category") @db.VarChar(20)
  accreditationExpected Boolean      @default(false) @map("accreditation_expected")
  active                Boolean      @default(true)
  sortOrder             Int          @default(0) @map("sort_order")
  version               Int          @default(1)
  createdBy             String       @map("created_by") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  tenant                Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  labourers             Labourer[]
  rates                 LabourRate[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("skill_levels")
}

// Company labour settings; no row means the defaults (alert lead time 30 days).
model LabourSettings {
  tenantId               String   @id @map("tenant_id") @db.Uuid
  accreditationAlertDays Int      @default(30) @map("accreditation_alert_days")
  version                Int      @default(1)
  updatedBy              String   @map("updated_by") @db.Uuid
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("labour_settings")
}

// A registered worker. `id` is chosen by the API before insert because each ciphertext's associated
// data binds it to (tenant, table, column, row). `registered_on` is set by the database (Africa/
// Nairobi date) and the minimum-age CHECK uses it. Rows are never deleted by the runtime role.
model Labourer {
  id             String                  @id @db.Uuid
  tenantId       String                  @map("tenant_id") @db.Uuid
  workerNo       String                  @map("worker_no") @db.VarChar(20)
  fullName       String                  @map("full_name") @db.VarChar(150)
  dateOfBirth    DateTime                @map("date_of_birth") @db.Date
  gender         String                  @db.VarChar(20)
  homeCounty     String?                 @map("home_county") @db.VarChar(30)
  tradeId        String                  @map("trade_id") @db.Uuid
  skillLevelId   String                  @map("skill_level_id") @db.Uuid
  engagementType String                  @map("engagement_type") @db.VarChar(20)
  rateBasis      String                  @default("daily") @map("rate_basis") @db.VarChar(10)
  status         String                  @default("active") @db.VarChar(20)
  idType         String                  @map("id_type") @db.VarChar(20)
  idNumberEnc    Bytes                   @map("id_number_enc")
  idNumberBidx   String                  @map("id_number_bidx") @db.Char(64)
  phoneEnc       Bytes?                  @map("phone_enc")
  phoneBidx      String?                 @map("phone_bidx") @db.Char(64)
  kraPinEnc      Bytes?                  @map("kra_pin_enc")
  kraPinBidx     String?                 @map("kra_pin_bidx") @db.Char(64)
  nssfNumberEnc  Bytes?                  @map("nssf_number_enc")
  shaNumberEnc   Bytes?                  @map("sha_number_enc")
  nextOfKinEnc   Bytes?                  @map("next_of_kin_enc")
  registeredOn   DateTime                @map("registered_on") @db.Date
  doNotRehire    Boolean                 @default(false) @map("do_not_rehire")
  doNotRehireAt  DateTime?               @map("do_not_rehire_at") @db.Timestamptz
  doNotRehireBy  String?                 @map("do_not_rehire_by") @db.Uuid
  version        Int                     @default(1)
  createdBy      String                  @map("created_by") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trade          Trade                   @relation(fields: [tenantId, tradeId], references: [tenantId, id], onDelete: NoAction)
  skillLevel     SkillLevel              @relation(fields: [tenantId, skillLevelId], references: [tenantId, id], onDelete: NoAction)
  engagements    LabourEngagement[]
  consents       LabourerConsent[]
  accreditations LabourerAccreditation[]
  dnrEvents      DoNotRehireEvent[]      @relation("DnrSubject")
  relatedDnr     DoNotRehireEvent[]      @relation("DnrRelated")
  rates          LabourRate[]
  ledGangs       Gang[]
  gangMembers    GangMembership[]
  attendance     AttendanceRecord[]
  corrections    AttendanceCorrection[]
  anomalies      AttendanceAnomaly[]
  timesheetLines TimesheetLine[]
  adjustments    TimesheetAdjustment[]
  allowances     PayrollAllowance[]
  outputs        PieceRateOutput[]
  outputShares   PieceRateOutputShare[]
  advances       SalaryAdvance[]
  payrollLines   PayrollLine[]
  dayClaims      PayrollDayClaim[]

  @@unique([tenantId, id])
  @@unique([tenantId, workerNo])
  @@unique([tenantId, idNumberBidx])
  @@unique([tenantId, kraPinBidx])
  @@index([tenantId, phoneBidx])
  @@index([tenantId, status])
  @@map("labourers")
}

// A labourer engaged on a project (start, optional end). At most one open engagement per labourer
// and project (trigger); the worker must be 18 on the start date (trigger); engaging a
// do-not-rehire labourer needs an override event in the same transaction (trigger).
model LabourEngagement {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  labourerId String    @map("labourer_id") @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  endReason  String?   @map("end_reason") @db.VarChar(500)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  endedBy    String?   @map("ended_by") @db.Uuid
  endedAt    DateTime? @map("ended_at") @db.Timestamptz
  labourer   Labourer  @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: Cascade)
  project    Project   @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, labourerId])
  @@index([tenantId, projectId])
  @@map("labour_engagements")
}

// Consent to process registration data (Kenya Data Protection Act 2019): which notice version and
// digest was shown, in which language, how it was captured and by whom. Append-only apart from a
// single withdrawal. Biometric consent kinds join in D3.4.
model LabourerConsent {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  labourerId        String    @map("labourer_id") @db.Uuid
  kind              String    @db.VarChar(30)
  noticeVersion     String    @map("notice_version") @db.VarChar(60)
  noticeDigest      String    @map("notice_digest") @db.Char(64)
  language          String    @db.VarChar(5)
  method            String    @db.VarChar(20)
  witnessName       String?   @map("witness_name") @db.VarChar(120)
  granted           Boolean
  capturedBy        String    @map("captured_by") @db.Uuid
  capturedAt        DateTime  @default(now()) @map("captured_at") @db.Timestamptz
  withdrawnAt       DateTime? @map("withdrawn_at") @db.Timestamptz
  withdrawnBy       String?   @map("withdrawn_by") @db.Uuid
  withdrawalMethod  String?   @map("withdrawal_method") @db.VarChar(20)
  withdrawalWitness String?   @map("withdrawal_witness") @db.VarChar(120)
  labourer          Labourer  @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, labourerId, capturedAt])
  @@map("labourer_consents")
}

// NCA accreditation cards (category, number, expiry). Renewal adds a card; the latest expiry counts.
model LabourerAccreditation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  labourerId String    @map("labourer_id") @db.Uuid
  category   String    @db.VarChar(30)
  cardNumber String    @map("card_number") @db.VarChar(40)
  issuedOn   DateTime? @map("issued_on") @db.Date
  expiresOn  DateTime  @map("expires_on") @db.Date
  version    Int       @default(1)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  labourer   Labourer  @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, labourerId])
  @@index([tenantId, expiresOn])
  @@map("labourer_accreditations")
}

// Append-only history of do-not-rehire decisions and overrides; the reason is encrypted free text.
model DoNotRehireEvent {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  labourerId        String    @map("labourer_id") @db.Uuid
  action            String    @db.VarChar(10)
  context           String?   @db.VarChar(20)
  projectId         String?   @map("project_id") @db.Uuid
  relatedLabourerId String?   @map("related_labourer_id") @db.Uuid
  reasonEnc         Bytes     @map("reason_enc")
  actorId           String    @map("actor_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  labourer          Labourer  @relation("DnrSubject", fields: [tenantId, labourerId], references: [tenantId, id], onDelete: Cascade)
  related           Labourer? @relation("DnrRelated", fields: [tenantId, relatedLabourerId], references: [tenantId, id], onDelete: NoAction)
  project           Project?  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, labourerId, createdAt])
  @@map("do_not_rehire_events")
}

// Effective-dated rates in KES minor units. Rows are never updated (a new rate is a new row that
// starts on or after today); only a rate that has not started yet can be deleted. `scope_key` is
// set by the database from (project, labourer, trade, skill level, basis).
model LabourRate {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  projectId       String?          @map("project_id") @db.Uuid
  labourerId      String?          @map("labourer_id") @db.Uuid
  tradeId         String?          @map("trade_id") @db.Uuid
  skillLevelId    String?          @map("skill_level_id") @db.Uuid
  basis           String           @db.VarChar(10)
  rateMinor       BigInt           @map("rate_minor")
  currency        String           @default("KES") @db.Char(3)
  effectiveFrom   DateTime         @map("effective_from") @db.Date
  scopeKey        String           @default("") @map("scope_key") @db.VarChar(200)
  createdBy       String           @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  project         Project?         @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction)
  labourer        Labourer?        @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: NoAction)
  trade           Trade?           @relation(fields: [tenantId, tradeId], references: [tenantId, id], onDelete: NoAction)
  skillLevel      SkillLevel?      @relation(fields: [tenantId, skillLevelId], references: [tenantId, id], onDelete: NoAction)
  payrollEarnings PayrollEarning[]

  @@unique([tenantId, id])
  @@unique([tenantId, scopeKey, effectiveFrom])
  @@index([tenantId, tradeId])
  @@index([tenantId, labourerId])
  @@map("labour_rates")
}

// A named gang (crew) on a project, optionally tied to one of its sites, with a leader who is a
// current member.
model Gang {
  id               String             @id @default(uuid(7)) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  projectId        String             @map("project_id") @db.Uuid
  siteId           String?            @map("site_id") @db.Uuid
  name             String             @db.VarChar(80)
  leaderLabourerId String?            @map("leader_labourer_id") @db.Uuid
  status           String             @default("active") @db.VarChar(20)
  version          Int                @default(1)
  createdBy        String             @map("created_by") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project          Project            @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  site             Site?              @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: NoAction)
  leader           Labourer?          @relation(fields: [tenantId, leaderLabourerId], references: [tenantId, id], onDelete: NoAction)
  members          GangMembership[]
  outputs          PieceRateOutput[]
  stockMovements   StockMovement[]
  stockEntries     StockLedgerEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, name])
  @@map("gangs")
}

// Gang membership history (join and leave dates). One open membership per labourer and project
// (trigger); the labourer must be engaged on the project on the join date (trigger).
model GangMembership {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  gangId     String    @map("gang_id") @db.Uuid
  labourerId String    @map("labourer_id") @db.Uuid
  joinedOn   DateTime  @map("joined_on") @db.Date
  leftOn     DateTime? @map("left_on") @db.Date
  addedBy    String    @map("added_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  removedBy  String?   @map("removed_by") @db.Uuid
  gang       Gang      @relation(fields: [tenantId, projectId, gangId], references: [tenantId, projectId, id], onDelete: Cascade)
  labourer   Labourer  @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, gangId])
  @@index([tenantId, labourerId])
  @@map("gang_memberships")
}

// A user's saved registry view (filters only), private to that user in that company.
model LabourSavedView {
  id         String     @id @default(uuid(7)) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  name       String     @db.VarChar(60)
  filters    Json       @default("{}")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  membership Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@unique([tenantId, userId, name])
  @@map("labour_saved_views")
}

// ---------------------------------------------------------------------------------------------
// Attendance and timesheets (D3.3, web-only slice; ARCHITECTURE §4.4). Business dates are
// Africa/Nairobi calendar dates; times of day are minutes after midnight; durations are integer
// minutes and day counts integer half days. Database triggers repeat the workflow rules (maker ≠
// checker, period locks, engagement on the date) so a bypassed API check still cannot break them.

// Company timesheet period settings (QUESTIONS Q-C4); no row means weekly, Thursday 18:00, Friday.
model AttendanceSettings {
  tenantId      String   @id @map("tenant_id") @db.Uuid
  frequency     String   @default("weekly") @db.VarChar(20)
  weekEndsOn    Int      @default(4) @map("week_ends_on") @db.SmallInt
  cutoffMinutes Int      @default(1080) @map("cutoff_minutes") @db.SmallInt
  paydayWeekday Int      @default(5) @map("payday_weekday") @db.SmallInt
  version       Int      @default(1)
  updatedBy     String   @map("updated_by") @db.Uuid
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("attendance_settings")
}

// Effective-dated timesheet rules: company default (project_id null) or a project override. Rows
// are never updated; only a version that has not started can be deleted; a version cannot take
// effect inside a submitted or approved period (trigger). `scope_key` is set by the database.
model TimesheetRuleVersion {
  id                      String           @id @default(uuid(7)) @db.Uuid
  tenantId                String           @map("tenant_id") @db.Uuid
  projectId               String?          @map("project_id") @db.Uuid
  scopeKey                String           @default("") @map("scope_key") @db.VarChar(40)
  effectiveFrom           DateTime         @map("effective_from") @db.Date
  normalMinutes           Int              @map("normal_minutes") @db.SmallInt
  defaultBreakMinutes     Int              @map("default_break_minutes") @db.SmallInt
  breakAfterMinutes       Int              @map("break_after_minutes") @db.SmallInt
  dayStartMinutes         Int              @map("day_start_minutes") @db.SmallInt
  lateGraceMinutes        Int              @map("late_grace_minutes") @db.SmallInt
  halfDayThresholdMinutes Int              @map("half_day_threshold_minutes") @db.SmallInt
  maxPlausibleMinutes     Int              @map("max_plausible_minutes") @db.SmallInt
  restDays                Int[]            @map("rest_days") @db.SmallInt
  otWeekdayMultiplier     Decimal          @map("ot_weekday_multiplier") @db.Decimal(4, 2)
  otRestDayMultiplier     Decimal          @map("ot_rest_day_multiplier") @db.Decimal(4, 2)
  otHolidayMultiplier     Decimal          @map("ot_holiday_multiplier") @db.Decimal(4, 2)
  complianceStatus        String           @default("unverified") @map("compliance_status") @db.VarChar(20)
  sourceReference         String           @map("source_reference") @db.VarChar(300)
  createdBy               String           @map("created_by") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  tenant                  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project                 Project?         @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: NoAction)
  payrollEarnings         PayrollEarning[]

  @@unique([tenantId, id])
  @@unique([tenantId, scopeKey, effectiveFrom])
  @@map("timesheet_rule_versions")
}

// A company's public holiday calendar (seeded from packages/types KENYA_PUBLIC_HOLIDAYS). Holidays
// inside a submitted or approved period cannot be added or removed (trigger); never updated.
model PublicHoliday {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  holidayDate      DateTime @map("holiday_date") @db.Date
  nameEn           String   @map("name_en") @db.VarChar(120)
  nameSw           String   @map("name_sw") @db.VarChar(120)
  kind             String   @db.VarChar(20)
  source           String   @db.VarChar(400)
  complianceStatus String   @default("unverified") @map("compliance_status") @db.VarChar(20)
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, holidayDate])
  @@map("public_holidays")
}

// A project's timesheet period: open → submitted → approved (locked), or submitted → rejected →
// open. The submitter cannot approve or reject (CHECK); approval snapshots timesheet_lines.
model TimesheetPeriod {
  id              String                @id @default(uuid(7)) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  projectId       String                @map("project_id") @db.Uuid
  startDate       DateTime              @map("start_date") @db.Date
  endDate         DateTime              @map("end_date") @db.Date
  cutoffAt        DateTime              @map("cutoff_at") @db.Timestamptz
  status          String                @default("open") @db.VarChar(20)
  version         Int                   @default(1)
  submittedBy     String?               @map("submitted_by") @db.Uuid
  submittedAt     DateTime?             @map("submitted_at") @db.Timestamptz
  submittedDigest String?               @map("submitted_digest") @db.Char(64)
  approvedBy      String?               @map("approved_by") @db.Uuid
  approvedAt      DateTime?             @map("approved_at") @db.Timestamptz
  rejectedBy      String?               @map("rejected_by") @db.Uuid
  rejectedAt      DateTime?             @map("rejected_at") @db.Timestamptz
  rejectionReason String?               @map("rejection_reason") @db.VarChar(500)
  createdBy       String                @map("created_by") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project         Project               @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  days            AttendanceDay[]
  lines           TimesheetLine[]       @relation("PeriodLines")
  carriedLines    TimesheetLine[]       @relation("LineOriginalPeriod")
  adjustments     TimesheetAdjustment[] @relation("AdjustmentOriginalPeriod")
  landed          TimesheetAdjustment[] @relation("AdjustmentTargetPeriod")

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, startDate])
  @@index([tenantId, projectId, status])
  @@map("timesheet_periods")
}

// A muster sheet: one project site on one date, draft → submitted → confirmed by someone who
// neither submitted it nor recorded any of its records (trigger).
model AttendanceDay {
  id           String                 @id @default(uuid(7)) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  projectId    String                 @map("project_id") @db.Uuid
  siteId       String                 @map("site_id") @db.Uuid
  workDate     DateTime               @map("work_date") @db.Date
  periodId     String                 @map("period_id") @db.Uuid
  status       String                 @default("draft") @db.VarChar(20)
  version      Int                    @default(1)
  submittedBy  String?                @map("submitted_by") @db.Uuid
  submittedAt  DateTime?              @map("submitted_at") @db.Timestamptz
  confirmedBy  String?                @map("confirmed_by") @db.Uuid
  confirmedAt  DateTime?              @map("confirmed_at") @db.Timestamptz
  returnedBy   String?                @map("returned_by") @db.Uuid
  returnedAt   DateTime?              @map("returned_at") @db.Timestamptz
  returnReason String?                @map("return_reason") @db.VarChar(500)
  createdBy    String                 @map("created_by") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  site         Site                   @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: Cascade)
  period       TimesheetPeriod        @relation(fields: [tenantId, projectId, periodId], references: [tenantId, projectId, id], onDelete: NoAction)
  records      AttendanceRecord[]
  corrections  AttendanceCorrection[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, siteId, workDate])
  @@unique([tenantId, siteId, workDate])
  @@index([tenantId, periodId])
  @@map("attendance_days")
}

// One labourer on one site on one date (unique). `capture_method` is the pluggable capture method:
// only `web_manual` is implemented; the evidence columns are reserved for the site app, kiosk and
// terminals and must stay empty for web entries (CHECK). Never deleted by the runtime role.
model AttendanceRecord {
  id               String                 @id @default(uuid(7)) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  dayId            String                 @map("day_id") @db.Uuid
  projectId        String                 @map("project_id") @db.Uuid
  siteId           String                 @map("site_id") @db.Uuid
  workDate         DateTime               @map("work_date") @db.Date
  labourerId       String                 @map("labourer_id") @db.Uuid
  status           String                 @db.VarChar(20)
  checkInMinutes   Int?                   @map("check_in_minutes") @db.SmallInt
  checkOutMinutes  Int?                   @map("check_out_minutes") @db.SmallInt
  overnight        Boolean                @default(false)
  breakMinutes     Int?                   @map("break_minutes") @db.SmallInt
  notes            String?                @db.VarChar(500)
  captureMethod    String                 @default("web_manual") @map("capture_method") @db.VarChar(20)
  deviceId         String?                @map("device_id") @db.Uuid
  deviceTime       DateTime?              @map("device_time") @db.Timestamptz
  serverReceivedAt DateTime               @default(now()) @map("server_received_at") @db.Timestamptz
  latitude         Decimal?               @db.Decimal(9, 6)
  longitude        Decimal?               @db.Decimal(9, 6)
  accuracyM        Decimal?               @map("accuracy_m") @db.Decimal(7, 1)
  geofenceResult   String?                @map("geofence_result") @db.VarChar(10)
  geofenceVersion  Int?                   @map("geofence_version")
  matchConfidence  Decimal?               @map("match_confidence") @db.Decimal(5, 4)
  photoFileId      String?                @map("photo_file_id") @db.Uuid
  clientEventId    String?                @map("client_event_id") @db.Uuid
  corrected        Boolean                @default(false)
  version          Int                    @default(1)
  createdBy        String                 @map("created_by") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedBy        String                 @map("updated_by") @db.Uuid
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  day              AttendanceDay          @relation(fields: [tenantId, dayId, siteId, workDate], references: [tenantId, id, siteId, workDate], onDelete: Cascade)
  site             Site                   @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: NoAction)
  labourer         Labourer               @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: NoAction)
  corrections      AttendanceCorrection[]
  anomalies        AttendanceAnomaly[]
  adjustments      TimesheetAdjustment[]

  @@unique([tenantId, id])
  @@unique([tenantId, siteId, labourerId, workDate])
  @@index([tenantId, labourerId, workDate])
  @@index([tenantId, projectId, workDate])
  @@map("attendance_records")
}

// A manual correction of a submitted or confirmed day: proposed values with a reason, applied only
// when someone other than the requester approves it (CHECK). Append-only apart from the decision.
model AttendanceCorrection {
  id           String              @id @default(uuid(7)) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  dayId        String              @map("day_id") @db.Uuid
  siteId       String              @map("site_id") @db.Uuid
  workDate     DateTime            @map("work_date") @db.Date
  recordId     String?             @map("record_id") @db.Uuid
  labourerId   String              @map("labourer_id") @db.Uuid
  proposed     Json
  previous     Json?
  reason       String              @db.VarChar(500)
  status       String              @default("pending") @db.VarChar(20)
  version      Int                 @default(1)
  requestedBy  String              @map("requested_by") @db.Uuid
  requestedAt  DateTime            @default(now()) @map("requested_at") @db.Timestamptz
  decidedBy    String?             @map("decided_by") @db.Uuid
  decidedAt    DateTime?           @map("decided_at") @db.Timestamptz
  decisionNote String?             @map("decision_note") @db.VarChar(500)
  day          AttendanceDay       @relation(fields: [tenantId, dayId, siteId, workDate], references: [tenantId, id, siteId, workDate], onDelete: Cascade)
  record       AttendanceRecord?   @relation(fields: [tenantId, recordId], references: [tenantId, id], onDelete: NoAction)
  labourer     Labourer            @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: NoAction)
  anomalies    AttendanceAnomaly[]

  @@unique([tenantId, id])
  @@index([tenantId, dayId])
  @@map("attendance_corrections")
}

// A review signal on a record (brief §5.5 anti-fraud). `open_marker` keeps one open anomaly per
// record and kind; closed anomalies are immutable.
model AttendanceAnomaly {
  id           String                @id @default(uuid(7)) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  projectId    String                @map("project_id") @db.Uuid
  siteId       String                @map("site_id") @db.Uuid
  recordId     String                @map("record_id") @db.Uuid
  labourerId   String                @map("labourer_id") @db.Uuid
  workDate     DateTime              @map("work_date") @db.Date
  kind         String                @db.VarChar(30)
  severity     String                @db.VarChar(10)
  details      Json                  @default("{}")
  status       String                @default("open") @db.VarChar(20)
  openMarker   String?               @default("open") @map("open_marker") @db.VarChar(4)
  correctionId String?               @map("correction_id") @db.Uuid
  detectedAt   DateTime              @default(now()) @map("detected_at") @db.Timestamptz
  reviewedBy   String?               @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?             @map("reviewed_at") @db.Timestamptz
  reviewNote   String?               @map("review_note") @db.VarChar(500)
  version      Int                   @default(1)
  record       AttendanceRecord      @relation(fields: [tenantId, recordId], references: [tenantId, id], onDelete: Cascade)
  correction   AttendanceCorrection? @relation(fields: [tenantId, correctionId], references: [tenantId, id], onDelete: NoAction)
  site         Site                  @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: NoAction)
  labourer     Labourer              @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, recordId, kind, openMarker])
  @@index([tenantId, projectId, status])
  @@index([tenantId, labourerId, workDate])
  @@map("attendance_anomalies")
}

// The approved, immutable timesheet (payroll-facing, D4.1): one line per labourer per approved
// period (`attendance`) plus one per adjustment landing in it (`adjustment`). Inserted only in the
// transaction that approves the period (trigger); never updated or deleted.
model TimesheetLine {
  id               String               @id @default(uuid(7)) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  projectId        String               @map("project_id") @db.Uuid
  periodId         String               @map("period_id") @db.Uuid
  labourerId       String               @map("labourer_id") @db.Uuid
  lineKey          String               @map("line_key") @db.VarChar(60)
  kind             String               @db.VarChar(20)
  adjustmentId     String?              @map("adjustment_id") @db.Uuid
  originalPeriodId String?              @map("original_period_id") @db.Uuid
  halfDays         Int                  @map("half_days")
  workedMinutes    Int                  @map("worked_minutes")
  normalMinutes    Int                  @map("normal_minutes")
  otWeekdayMinutes Int                  @map("ot_weekday_minutes")
  otRestDayMinutes Int                  @map("ot_rest_day_minutes")
  otHolidayMinutes Int                  @map("ot_holiday_minutes")
  lateMinutes      Int                  @map("late_minutes")
  presentCount     Int                  @map("present_count")
  halfDayCount     Int                  @map("half_day_count")
  absentCount      Int                  @map("absent_count")
  leaveCount       Int                  @map("leave_count")
  sickCount        Int                  @map("sick_count")
  ruleVersionIds   String[]             @map("rule_version_ids") @db.Uuid
  recordIds        String[]             @map("record_ids") @db.Uuid
  days             Json
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  period           TimesheetPeriod      @relation("PeriodLines", fields: [tenantId, projectId, periodId], references: [tenantId, projectId, id], onDelete: Cascade)
  originalPeriod   TimesheetPeriod?     @relation("LineOriginalPeriod", fields: [tenantId, projectId, originalPeriodId], references: [tenantId, projectId, id], onDelete: NoAction)
  labourer         Labourer             @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: NoAction)
  adjustment       TimesheetAdjustment? @relation(fields: [tenantId, adjustmentId], references: [tenantId, id], onDelete: NoAction)
  payrollEarnings  PayrollEarning[]
  consumptions     PayrollConsumption[]

  @@unique([tenantId, id])
  @@unique([tenantId, periodId, labourerId, lineKey])
  @@index([tenantId, labourerId])
  @@map("timesheet_lines")
}

// A correction after approval: never changes the approved period. Approved by someone other than
// the requester (CHECK); its delta lands in a later open period and appears there as an
// `adjustment` timesheet line when that period is approved.
model TimesheetAdjustment {
  id               String            @id @default(uuid(7)) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  projectId        String            @map("project_id") @db.Uuid
  originalPeriodId String            @map("original_period_id") @db.Uuid
  targetPeriodId   String?           @map("target_period_id") @db.Uuid
  labourerId       String            @map("labourer_id") @db.Uuid
  siteId           String            @map("site_id") @db.Uuid
  workDate         DateTime          @map("work_date") @db.Date
  recordId         String?           @map("record_id") @db.Uuid
  proposed         Json
  previous         Json?
  reason           String            @db.VarChar(500)
  status           String            @default("pending") @db.VarChar(20)
  version          Int               @default(1)
  delta            Json?
  ruleVersionId    String?           @map("rule_version_id") @db.Uuid
  requestedBy      String            @map("requested_by") @db.Uuid
  requestedAt      DateTime          @default(now()) @map("requested_at") @db.Timestamptz
  decidedBy        String?           @map("decided_by") @db.Uuid
  decidedAt        DateTime?         @map("decided_at") @db.Timestamptz
  decisionNote     String?           @map("decision_note") @db.VarChar(500)
  originalPeriod   TimesheetPeriod   @relation("AdjustmentOriginalPeriod", fields: [tenantId, projectId, originalPeriodId], references: [tenantId, projectId, id], onDelete: NoAction)
  targetPeriod     TimesheetPeriod?  @relation("AdjustmentTargetPeriod", fields: [tenantId, projectId, targetPeriodId], references: [tenantId, projectId, id], onDelete: NoAction)
  site             Site              @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: NoAction)
  labourer         Labourer          @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: NoAction)
  record           AttendanceRecord? @relation(fields: [tenantId, recordId], references: [tenantId, id], onDelete: NoAction)
  lines            TimesheetLine[]

  @@unique([tenantId, id])
  @@index([tenantId, projectId, status])
  @@index([tenantId, labourerId, workDate])
  @@map("timesheet_adjustments")
}

// Idempotency keys for attendance commands (WORKFLOWS shared rules): the key binds the company,
// operation and a fingerprint of caller and payload; a replay returns the stored response, a
// changed payload is refused. Insert-only for the runtime role (purge job: OPERATIONS).
model IdempotencyRecord {
  tenantId       String   @map("tenant_id") @db.Uuid
  operation      String   @db.VarChar(80)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  userId         String   @map("user_id") @db.Uuid
  fingerprint    String   @db.Char(64)
  response       Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, operation, idempotencyKey])
  @@map("idempotency_records")
}

// Transactional outbox: domain events written in the same transaction as the change (relay to the
// queue arrives with D4.2). Insert-only for the runtime role.
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  topic       String    @db.VarChar(80)
  aggregateId String    @map("aggregate_id") @db.Uuid
  payload     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------------------------
// Payroll engine (D4.1; ARCHITECTURE §4.5, ERD §7). Money is KES minor units (BIGINT); rates and
// quantities are decimals; business dates are Africa/Nairobi calendar dates. Statutory values are
// effective-dated rule versions (COMPLIANCE-REVIEW CR-PAY-*), never code. Triggers repeat every
// workflow rule: drafts change freely, a submitted batch and its lines never change, each timesheet
// line and output share is consumed by at most one non-cancelled batch, and attendance and piece
// rate never pay the same labourer-day.

// Company payroll settings (PRODUCT): advance limits and the recovery cap; no row = defaults.
model PayrollSettings {
  tenantId                   String   @id @map("tenant_id") @db.Uuid
  advanceMaxMinor            BigInt   @map("advance_max_minor")
  advanceMaxOutstandingMinor BigInt   @map("advance_max_outstanding_minor")
  recoveryMaxPercent         Decimal  @map("recovery_max_percent") @db.Decimal(5, 2)
  version                    Int      @default(1)
  updatedBy                  String   @map("updated_by") @db.Uuid
  updatedAt                  DateTime @default(now()) @map("updated_at") @db.Timestamptz
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payroll_settings")
}

// A project's pay calendar; no row = weekly periods following the timesheet weeks.
model PayCalendar {
  tenantId         String   @map("tenant_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  frequency        String   @db.VarChar(20)
  anchorDate       DateTime @map("anchor_date") @db.Date
  paydayOffsetDays Int      @map("payday_offset_days") @db.SmallInt
  minimumWageArea  String?  @map("minimum_wage_area") @db.VarChar(20)
  version          Int      @default(1)
  updatedBy        String   @map("updated_by") @db.Uuid
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz
  project          Project  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, projectId])
  @@map("pay_calendars")
}

// An effective-dated statutory rule version (PAYE, NSSF, SHIF, AHL, NITA, the non-monthly method or
// applicability per engagement type). Never edited: only unverified → verified (by someone other
// than its author, with a note); a new version supersedes it.
model StatutoryRuleVersion {
  id               String             @id @default(uuid(7)) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  kind             String             @db.VarChar(20)
  effectiveFrom    DateTime           @map("effective_from") @db.Date
  parameters       Json
  status           String             @default("unverified") @db.VarChar(20)
  sourceReference  String             @map("source_reference") @db.VarChar(2000)
  notes            String             @default("") @db.VarChar(1000)
  createdBy        String             @map("created_by") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz
  verifiedBy       String?            @map("verified_by") @db.Uuid
  verifiedAt       DateTime?          @map("verified_at") @db.Timestamptz
  verificationNote String?            @map("verification_note") @db.VarChar(500)
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deductions       PayrollDeduction[]

  @@unique([tenantId, id])
  @@unique([tenantId, kind, effectiveFrom])
  @@map("statutory_rule_versions")
}

// Minimum wages per area and occupation (a warning only; COMPLIANCE-REVIEW CR-PAY-09). Insert-only.
model MinimumWageRate {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  effectiveFrom    DateTime @map("effective_from") @db.Date
  area             String   @db.VarChar(20)
  occupation       String   @db.VarChar(30)
  monthlyMinor     BigInt   @map("monthly_minor")
  dailyMinor       BigInt?  @map("daily_minor")
  hourlyMinor      BigInt?  @map("hourly_minor")
  source           String   @db.VarChar(2000)
  complianceStatus String   @default("unverified") @map("compliance_status") @db.VarChar(20)
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, area, occupation, effectiveFrom])
  @@map("minimum_wage_rates")
}

// An allowance on a project, optionally for one trade or one labourer (the most specific wins per
// code). Never edited; it can only be ended once.
model PayrollAllowance {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  projectId     String           @map("project_id") @db.Uuid
  code          String           @db.VarChar(40)
  nameEn        String           @map("name_en") @db.VarChar(80)
  nameSw        String           @map("name_sw") @db.VarChar(80)
  basis         String           @db.VarChar(20)
  amountMinor   BigInt           @map("amount_minor")
  taxable       Boolean
  tradeId       String?          @map("trade_id") @db.Uuid
  labourerId    String?          @map("labourer_id") @db.Uuid
  effectiveFrom DateTime         @map("effective_from") @db.Date
  endedOn       DateTime?        @map("ended_on") @db.Date
  endedBy       String?          @map("ended_by") @db.Uuid
  createdBy     String           @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  project       Project          @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  trade         Trade?           @relation(fields: [tenantId, tradeId], references: [tenantId, id], onDelete: NoAction)
  labourer      Labourer?        @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: NoAction)
  earnings      PayrollEarning[]

  @@unique([tenantId, id])
  @@index([tenantId, projectId])
  @@map("payroll_allowances")
}

// Piece-rate output for one labourer or one gang on one day (optionally against a BQ item):
// quantity × rate per unit. Approved or rejected by someone other than the recorder; approval
// writes the shares (a gang's output split equally between its members that day).
model PieceRateOutput {
  id           String                 @id @default(uuid(7)) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  projectId    String                 @map("project_id") @db.Uuid
  workDate     DateTime               @map("work_date") @db.Date
  labourerId   String?                @map("labourer_id") @db.Uuid
  gangId       String?                @map("gang_id") @db.Uuid
  bqItemId     String?                @map("bq_item_id") @db.Uuid
  description  String                 @db.VarChar(200)
  unit         String                 @db.VarChar(20)
  quantity     Decimal                @db.Decimal(12, 3)
  rateMinor    BigInt                 @map("rate_minor")
  amountMinor  BigInt                 @map("amount_minor")
  status       String                 @default("pending") @db.VarChar(20)
  version      Int                    @default(1)
  recordedBy   String                 @map("recorded_by") @db.Uuid
  recordedAt   DateTime               @default(now()) @map("recorded_at") @db.Timestamptz
  decidedBy    String?                @map("decided_by") @db.Uuid
  decidedAt    DateTime?              @map("decided_at") @db.Timestamptz
  decisionNote String?                @map("decision_note") @db.VarChar(500)
  project      Project                @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  labourer     Labourer?              @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: NoAction)
  gang         Gang?                  @relation(fields: [tenantId, projectId, gangId], references: [tenantId, projectId, id], onDelete: NoAction)
  bqItem       BqItem?                @relation(fields: [tenantId, bqItemId], references: [tenantId, id], onDelete: NoAction)
  shares       PieceRateOutputShare[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@index([tenantId, projectId, workDate])
  @@map("piece_rate_outputs")
}

// One labourer's share of an approved output. Written once at approval; never changed.
model PieceRateOutputShare {
  id           String               @id @default(uuid(7)) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  projectId    String               @map("project_id") @db.Uuid
  outputId     String               @map("output_id") @db.Uuid
  labourerId   String               @map("labourer_id") @db.Uuid
  workDate     DateTime             @map("work_date") @db.Date
  amountMinor  BigInt               @map("amount_minor")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  output       PieceRateOutput      @relation(fields: [tenantId, projectId, outputId], references: [tenantId, projectId, id], onDelete: Cascade)
  labourer     Labourer             @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: NoAction)
  earnings     PayrollEarning[]
  consumptions PayrollConsumption[]

  @@unique([tenantId, id])
  @@unique([tenantId, outputId, labourerId])
  @@index([tenantId, projectId, workDate])
  @@map("piece_rate_output_shares")
}

// A salary advance: requested → approved (someone else, within the limits) → recorded as paid
// outside PM-Buddy (D4.1; M-Pesa in D4.3) → recovered by later batches. Outstanding = amount −
// recoveries of non-cancelled batches (never negative, enforced by trigger).
model SalaryAdvance {
  id                    String            @id @default(uuid(7)) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  projectId             String            @map("project_id") @db.Uuid
  labourerId            String            @map("labourer_id") @db.Uuid
  amountMinor           BigInt            @map("amount_minor")
  reason                String            @db.VarChar(500)
  instalmentMinor       BigInt?           @map("instalment_minor")
  maxRecoveryPercent    Decimal?          @map("max_recovery_percent") @db.Decimal(5, 2)
  status                String            @default("requested") @db.VarChar(20)
  version               Int               @default(1)
  requestedBy           String            @map("requested_by") @db.Uuid
  requestedAt           DateTime          @default(now()) @map("requested_at") @db.Timestamptz
  decidedBy             String?           @map("decided_by") @db.Uuid
  decidedAt             DateTime?         @map("decided_at") @db.Timestamptz
  decisionNote          String?           @map("decision_note") @db.VarChar(500)
  disbursementMethod    String?           @map("disbursement_method") @db.VarChar(20)
  disbursementReference String?           @map("disbursement_reference") @db.VarChar(60)
  paidOn                DateTime?         @map("paid_on") @db.Date
  evidenceNote          String?           @map("evidence_note") @db.VarChar(500)
  disbursedBy           String?           @map("disbursed_by") @db.Uuid
  disbursedAt           DateTime?         @map("disbursed_at") @db.Timestamptz
  cancelledBy           String?           @map("cancelled_by") @db.Uuid
  cancelledAt           DateTime?         @map("cancelled_at") @db.Timestamptz
  cancellationReason    String?           @map("cancellation_reason") @db.VarChar(500)
  project               Project           @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  labourer              Labourer          @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: NoAction)
  recoveries            AdvanceRecovery[]

  @@unique([tenantId, id])
  @@index([tenantId, labourerId])
  @@index([tenantId, projectId, status])
  @@map("salary_advances")
}

// A payroll batch: one project and one pay period. draft (recalculated freely) → submitted (the
// immutable snapshot whose digest D4.3 approves) or cancelled. `active_marker` is NULL once
// cancelled, so at most one live batch exists per project and period start.
model PayrollBatch {
  id                   String               @id @default(uuid(7)) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  projectId            String               @map("project_id") @db.Uuid
  periodStart          DateTime             @map("period_start") @db.Date
  periodEnd            DateTime             @map("period_end") @db.Date
  payDate              DateTime             @map("pay_date") @db.Date
  statutoryMonth       String               @map("statutory_month") @db.Char(7)
  frequency            String               @db.VarChar(20)
  status               String               @default("draft") @db.VarChar(20)
  version              Int                  @default(1)
  activeMarker         String?              @default("active") @map("active_marker") @db.VarChar(6)
  unverifiedRules      Boolean              @map("unverified_rules")
  lineCount            Int                  @map("line_count")
  grossMinor           BigInt               @map("gross_minor")
  totalDeductionsMinor BigInt               @map("total_deductions_minor")
  netMinor             BigInt               @map("net_minor")
  employerCostMinor    BigInt               @map("employer_cost_minor")
  totals               Json
  exclusions           Json
  ruleVersionIds       String[]             @map("rule_version_ids") @db.Uuid
  timesheetRuleIds     String[]             @map("timesheet_rule_ids") @db.Uuid
  mtdBatchIds          String[]             @map("mtd_batch_ids") @db.Uuid
  digest               String               @db.Char(64)
  calculatedBy         String               @map("calculated_by") @db.Uuid
  calculatedAt         DateTime             @default(now()) @map("calculated_at") @db.Timestamptz
  createdBy            String               @map("created_by") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  submittedBy          String?              @map("submitted_by") @db.Uuid
  submittedAt          DateTime?            @map("submitted_at") @db.Timestamptz
  cancelledBy          String?              @map("cancelled_by") @db.Uuid
  cancelledAt          DateTime?            @map("cancelled_at") @db.Timestamptz
  cancellationReason   String?              @map("cancellation_reason") @db.VarChar(500)
  project              Project              @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  lines                PayrollLine[]
  consumptions         PayrollConsumption[]
  claims               PayrollDayClaim[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, periodStart, activeMarker])
  @@index([tenantId, statutoryMonth, status])
  @@map("payroll_batches")
}

// One labourer's pay in a batch, with snapshots of the identity, engagement and month-to-date
// figures it was computed with. Rewritten only while the batch is a draft.
model PayrollLine {
  id                     String             @id @default(uuid(7)) @db.Uuid
  tenantId               String             @map("tenant_id") @db.Uuid
  projectId              String             @map("project_id") @db.Uuid
  batchId                String             @map("batch_id") @db.Uuid
  labourerId             String             @map("labourer_id") @db.Uuid
  workerNo               String             @map("worker_no") @db.VarChar(20)
  fullName               String             @map("full_name") @db.VarChar(150)
  tradeNameEn            String?            @map("trade_name_en") @db.VarChar(80)
  tradeNameSw            String?            @map("trade_name_sw") @db.VarChar(80)
  engagementType         String             @map("engagement_type") @db.VarChar(20)
  rateBasis              String             @map("rate_basis") @db.VarChar(10)
  halfDays               Int                @map("half_days")
  normalMinutes          Int                @map("normal_minutes")
  otWeekdayMinutes       Int                @map("ot_weekday_minutes")
  otRestDayMinutes       Int                @map("ot_rest_day_minutes")
  otHolidayMinutes       Int                @map("ot_holiday_minutes")
  daysWorked             Int                @map("days_worked")
  grossMinor             BigInt             @map("gross_minor")
  statutoryBaseMinor     BigInt             @map("statutory_base_minor")
  statutoryWithheldMinor BigInt             @map("statutory_withheld_minor")
  advanceRecoveryMinor   BigInt             @map("advance_recovery_minor")
  otherDeductionsMinor   BigInt             @map("other_deductions_minor")
  netMinor               BigInt             @map("net_minor")
  employerCostMinor      BigInt             @map("employer_cost_minor")
  statutoryMonth         String             @map("statutory_month") @db.Char(7)
  monthToDate            Json               @map("month_to_date")
  warnings               Json
  payeePhoneBidx         String?            @map("payee_phone_bidx") @db.Char(64)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz
  batch                  PayrollBatch       @relation(fields: [tenantId, projectId, batchId], references: [tenantId, projectId, id], onDelete: Cascade)
  labourer               Labourer           @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: NoAction)
  earnings               PayrollEarning[]
  deductions             PayrollDeduction[]
  recoveries             AdvanceRecovery[]

  @@unique([tenantId, id])
  @@unique([tenantId, batchId, id])
  @@unique([tenantId, batchId, labourerId])
  @@index([tenantId, labourerId, statutoryMonth])
  @@map("payroll_lines")
}

// One earnings component of a line, with the rate, rule and source it came from.
model PayrollEarning {
  id              String                @id @default(uuid(7)) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  batchId         String                @map("batch_id") @db.Uuid
  lineId          String                @map("line_id") @db.Uuid
  position        Int
  kind            String                @db.VarChar(20)
  category        String?               @db.VarChar(20)
  workDate        DateTime?             @map("work_date") @db.Date
  quantity        Decimal               @db.Decimal(14, 3)
  unit            String                @db.VarChar(20)
  rateMinor       BigInt?               @map("rate_minor")
  multiplier      Decimal?              @db.Decimal(6, 3)
  description     String                @db.VarChar(200)
  amountMinor     BigInt                @map("amount_minor")
  taxable         Boolean
  labourRateId    String?               @map("labour_rate_id") @db.Uuid
  timesheetRuleId String?               @map("timesheet_rule_id") @db.Uuid
  timesheetLineId String?               @map("timesheet_line_id") @db.Uuid
  shareId         String?               @map("share_id") @db.Uuid
  allowanceId     String?               @map("allowance_id") @db.Uuid
  line            PayrollLine           @relation(fields: [tenantId, batchId, lineId], references: [tenantId, batchId, id], onDelete: Cascade)
  labourRate      LabourRate?           @relation(fields: [tenantId, labourRateId], references: [tenantId, id], onDelete: NoAction)
  timesheetRule   TimesheetRuleVersion? @relation(fields: [tenantId, timesheetRuleId], references: [tenantId, id], onDelete: NoAction)
  timesheetLine   TimesheetLine?        @relation(fields: [tenantId, timesheetLineId], references: [tenantId, id], onDelete: NoAction)
  share           PieceRateOutputShare? @relation(fields: [tenantId, shareId], references: [tenantId, id], onDelete: NoAction)
  allowance       PayrollAllowance?     @relation(fields: [tenantId, allowanceId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, lineId, position])
  @@map("payroll_earnings")
}

// Employee statutory deductions (due, withheld, shortfall) and employer on-costs of a line, with
// the rule version used.
model PayrollDeduction {
  id             String               @id @default(uuid(7)) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  batchId        String               @map("batch_id") @db.Uuid
  lineId         String               @map("line_id") @db.Uuid
  party          String               @db.VarChar(10)
  kind           String               @db.VarChar(20)
  dueMinor       BigInt               @map("due_minor")
  withheldMinor  BigInt               @map("withheld_minor")
  shortfallMinor BigInt               @map("shortfall_minor")
  ruleVersionId  String               @map("rule_version_id") @db.Uuid
  line           PayrollLine          @relation(fields: [tenantId, batchId, lineId], references: [tenantId, batchId, id], onDelete: Cascade)
  ruleVersion    StatutoryRuleVersion @relation(fields: [tenantId, ruleVersionId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, lineId, kind])
  @@map("payroll_deductions")
}

// An advance recovery taken by a line (never more than the advance's outstanding balance).
model AdvanceRecovery {
  id                    String        @id @default(uuid(7)) @db.Uuid
  tenantId              String        @map("tenant_id") @db.Uuid
  batchId               String        @map("batch_id") @db.Uuid
  lineId                String        @map("line_id") @db.Uuid
  advanceId             String        @map("advance_id") @db.Uuid
  amountMinor           BigInt        @map("amount_minor")
  outstandingAfterMinor BigInt        @map("outstanding_after_minor")
  line                  PayrollLine   @relation(fields: [tenantId, batchId, lineId], references: [tenantId, batchId, id], onDelete: Cascade)
  advance               SalaryAdvance @relation(fields: [tenantId, advanceId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, lineId, advanceId])
  @@index([tenantId, advanceId])
  @@map("advance_recoveries")
}

// A source a batch pays: a timesheet line or an output share. Unique per source while active, so
// no two non-cancelled batches consume the same line (the marker is NULL once released).
model PayrollConsumption {
  id              String                @id @default(uuid(7)) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  projectId       String                @map("project_id") @db.Uuid
  batchId         String                @map("batch_id") @db.Uuid
  sourceKind      String                @map("source_kind") @db.VarChar(20)
  timesheetLineId String?               @map("timesheet_line_id") @db.Uuid
  shareId         String?               @map("share_id") @db.Uuid
  activeMarker    String?               @default("active") @map("active_marker") @db.VarChar(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  batch           PayrollBatch          @relation(fields: [tenantId, projectId, batchId], references: [tenantId, projectId, id], onDelete: Cascade)
  timesheetLine   TimesheetLine?        @relation(fields: [tenantId, timesheetLineId], references: [tenantId, id], onDelete: NoAction)
  share           PieceRateOutputShare? @relation(fields: [tenantId, shareId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, timesheetLineId, activeMarker])
  @@unique([tenantId, shareId, activeMarker])
  @@index([tenantId, batchId])
  @@map("payroll_consumptions")
}

// The basis on which a batch pays a labourer-day (attendance or piece rate). A trigger refuses an
// active claim of the other basis for the same labourer and date, company-wide.
model PayrollDayClaim {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  projectId    String       @map("project_id") @db.Uuid
  batchId      String       @map("batch_id") @db.Uuid
  labourerId   String       @map("labourer_id") @db.Uuid
  workDate     DateTime     @map("work_date") @db.Date
  basis        String       @db.VarChar(20)
  activeMarker String?      @default("active") @map("active_marker") @db.VarChar(6)
  batch        PayrollBatch @relation(fields: [tenantId, projectId, batchId], references: [tenantId, projectId, id], onDelete: Cascade)
  labourer     Labourer     @relation(fields: [tenantId, labourerId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, batchId, labourerId, workDate, basis])
  @@index([tenantId, labourerId, workDate])
  @@map("payroll_day_claims")
}

// A geotagged site photo (D6.1). Append-only evidence: the server reads the photo's own EXIF
// position and capture time and records its checks against the site geofence version in force
// at capture; `verified` = location inside and time ok. Originals and metadata-free thumbnails
// are private objects under tenant/project/photo keys.
model SitePhoto {
  id              String                     @id @db.Uuid
  tenantId        String                     @map("tenant_id") @db.Uuid
  projectId       String                     @map("project_id") @db.Uuid
  siteId          String                     @map("site_id") @db.Uuid
  diaryId         String?                    @map("diary_id") @db.Uuid
  caption         String?                    @db.VarChar(500)
  objectKey       String                     @map("object_key") @db.VarChar(300)
  thumbnailKey    String                     @map("thumbnail_key") @db.VarChar(300)
  fileSha256      String                     @map("file_sha256") @db.Char(64)
  sizeBytes       Int                        @map("size_bytes")
  width           Int
  height          Int
  scanStatus      String                     @map("scan_status") @db.VarChar(20)
  scanEngine      String                     @map("scan_engine") @db.VarChar(60)
  scannedAt       DateTime                   @map("scanned_at") @db.Timestamptz
  capturedAt      DateTime?                  @map("captured_at") @db.Timestamptz
  timeSource      String?                    @map("time_source") @db.VarChar(20)
  latitude        Decimal?                   @db.Decimal(9, 6)
  longitude       Decimal?                   @db.Decimal(9, 6)
  camera          String?                    @db.VarChar(120)
  geofenceVersion Int?                       @map("geofence_version")
  locationCheck   String                     @map("location_check") @db.VarChar(12)
  timeCheck       String                     @map("time_check") @db.VarChar(16)
  distanceM       Decimal?                   @map("distance_m") @db.Decimal(10, 1)
  verified        Boolean
  uploadedBy      String                     @map("uploaded_by") @db.Uuid
  uploadedAt      DateTime                   @default(now()) @map("uploaded_at") @db.Timestamptz
  site            Site                       @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: Restrict, onUpdate: NoAction, map: "site_photos_site_fkey")
  diary           SiteDiary?                 @relation(fields: [tenantId, siteId, diaryId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: NoAction, map: "site_photos_diary_fkey")
  inspectionItems InspectionItemPhoto[]
  snags           SnagPhoto[]
  measurements    ProgressMeasurementPhoto[]

  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, fileSha256])
  @@index([tenantId, projectId, id])
  @@map("site_photos")
}

// D5.2 procure-to-pay (ARCHITECTURE §4.5, WORKFLOWS "Procurement and certification"). State machines,
// maker-checker contributor lists, immutability and the three-way match backstop live in SQL
// triggers (migration 20261115100000_procure_to_pay); partial unique indexes are SQL-only.

// A site's material requisition (REQ-NNNN per company).
model Requisition {
  id              String            @id @default(uuid(7)) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  projectId       String            @map("project_id") @db.Uuid
  siteId          String?           @map("site_id") @db.Uuid
  number          String            @db.VarChar(20)
  status          String            @default("draft") @db.VarChar(20)
  neededBy        DateTime          @map("needed_by") @db.Date
  notes           String?           @db.VarChar(2000)
  lineCount       Int               @default(0) @map("line_count")
  contributors    String[]          @default([]) @db.Uuid
  version         Int               @default(1)
  createdBy       String            @map("created_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedBy       String            @map("updated_by") @db.Uuid
  updatedAt       DateTime          @default(now()) @map("updated_at") @db.Timestamptz
  submittedBy     String?           @map("submitted_by") @db.Uuid
  submittedAt     DateTime?         @map("submitted_at") @db.Timestamptz
  decidedBy       String?           @map("decided_by") @db.Uuid
  decidedAt       DateTime?         @map("decided_at") @db.Timestamptz
  rejectionReason String?           @map("rejection_reason") @db.VarChar(500)
  cancelledBy     String?           @map("cancelled_by") @db.Uuid
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz
  cancelReason    String?           @map("cancel_reason") @db.VarChar(500)
  project         Project           @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  site            Site?             @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict)
  lines           RequisitionLine[]
  rfqLinks        RfqRequisition[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, number])
  @@index([tenantId, projectId, status])
  @@map("requisitions")
}

// A requested material in any convertible unit, with its base quantity and optional BQ item tag.
model RequisitionLine {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  requisitionId   String          @map("requisition_id") @db.Uuid
  lineNo          Int             @map("line_no")
  materialId      String          @map("material_id") @db.Uuid
  quantity        Decimal         @db.Decimal(20, 6)
  unit            String          @db.VarChar(20)
  baseQuantity    Decimal         @map("base_quantity") @db.Decimal(20, 6)
  baseUnit        String          @map("base_unit") @db.VarChar(20)
  conversion      Json
  bqVersionId     String?         @map("bq_version_id") @db.Uuid
  bqItemLineageId String?         @map("bq_item_lineage_id") @db.Uuid
  note            String?         @db.VarChar(300)
  requisition     Requisition     @relation(fields: [tenantId, requisitionId], references: [tenantId, id], onDelete: Cascade)
  material        Material        @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Restrict)
  bqItem          BqItem?         @relation(fields: [tenantId, bqVersionId, bqItemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  quotationLines  QuotationLine[]
  lpoLines        LpoLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, requisitionId, lineNo])
  @@index([tenantId, requisitionId])
  @@map("requisition_lines")
}

// A request for quotations (RFQ-NNNN) for approved requisitions of one project.
model Rfq {
  id                   String           @id @default(uuid(7)) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  projectId            String           @map("project_id") @db.Uuid
  number               String           @db.VarChar(20)
  status               String           @default("open") @db.VarChar(20)
  respondBy            DateTime?        @map("respond_by") @db.Date
  notes                String?          @db.VarChar(2000)
  minQuotesApplied     Int?             @map("min_quotes_applied")
  exceptionReason      String?          @map("exception_reason") @db.VarChar(500)
  exceptionRequestedBy String?          @map("exception_requested_by") @db.Uuid
  exceptionRequestedAt DateTime?        @map("exception_requested_at") @db.Timestamptz
  exceptionApprovedBy  String?          @map("exception_approved_by") @db.Uuid
  exceptionApprovedAt  DateTime?        @map("exception_approved_at") @db.Timestamptz
  cancelledBy          String?          @map("cancelled_by") @db.Uuid
  cancelledAt          DateTime?        @map("cancelled_at") @db.Timestamptz
  cancelReason         String?          @map("cancel_reason") @db.VarChar(500)
  contributors         String[]         @default([]) @db.Uuid
  version              Int              @default(1)
  createdBy            String           @map("created_by") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedBy            String           @map("updated_by") @db.Uuid
  updatedAt            DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  project              Project          @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  requisitions         RfqRequisition[]
  suppliers            RfqSupplier[]
  quotations           Quotation[]
  lpos                 Lpo[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, number])
  @@index([tenantId, projectId, status])
  @@map("rfqs")
}

// The requisitions an RFQ covers (same project); released when the RFQ is cancelled.
model RfqRequisition {
  tenantId      String      @map("tenant_id") @db.Uuid
  rfqId         String      @map("rfq_id") @db.Uuid
  requisitionId String      @map("requisition_id") @db.Uuid
  projectId     String      @map("project_id") @db.Uuid
  releasedAt    DateTime?   @map("released_at") @db.Timestamptz
  rfq           Rfq         @relation(fields: [tenantId, projectId, rfqId], references: [tenantId, projectId, id], onDelete: Cascade)
  requisition   Requisition @relation(fields: [tenantId, projectId, requisitionId], references: [tenantId, projectId, id], onDelete: Restrict)

  @@id([tenantId, rfqId, requisitionId])
  @@index([tenantId, requisitionId])
  @@map("rfq_requisitions")
}

// A supplier invited to quote on an RFQ.
model RfqSupplier {
  tenantId   String      @map("tenant_id") @db.Uuid
  rfqId      String      @map("rfq_id") @db.Uuid
  supplierId String      @map("supplier_id") @db.Uuid
  addedAt    DateTime    @default(now()) @map("added_at") @db.Timestamptz
  rfq        Rfq         @relation(fields: [tenantId, rfqId], references: [tenantId, id], onDelete: Cascade)
  supplier   Supplier    @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  quotations Quotation[]

  @@id([tenantId, rfqId, supplierId])
  @@index([tenantId, supplierId])
  @@map("rfq_suppliers")
}

// A supplier's quotation on an RFQ; immutable once recorded (only withdrawn with a reason).
model Quotation {
  id              String                @id @default(uuid(7)) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  rfqId           String                @map("rfq_id") @db.Uuid
  supplierId      String                @map("supplier_id") @db.Uuid
  reference       String?               @db.VarChar(60)
  quotedOn        DateTime              @map("quoted_on") @db.Date
  validUntil      DateTime              @map("valid_until") @db.Date
  deliveryDays    Int                   @map("delivery_days")
  status          String                @default("received") @db.VarChar(12)
  complete        Boolean
  netTotalMinor   BigInt                @map("net_total_minor")
  vatRatePercent  Decimal               @map("vat_rate_percent") @db.Decimal(7, 4)
  vatRuleStatus   String                @map("vat_rule_status") @db.VarChar(30)
  withdrawnBy     String?               @map("withdrawn_by") @db.Uuid
  withdrawnAt     DateTime?             @map("withdrawn_at") @db.Timestamptz
  withdrawnReason String?               @map("withdrawn_reason") @db.VarChar(500)
  recordedBy      String                @map("recorded_by") @db.Uuid
  recordedAt      DateTime              @default(now()) @map("recorded_at") @db.Timestamptz
  rfq             Rfq                   @relation(fields: [tenantId, rfqId], references: [tenantId, id], onDelete: Cascade)
  invitation      RfqSupplier           @relation(fields: [tenantId, rfqId, supplierId], references: [tenantId, rfqId, supplierId], onDelete: Restrict)
  lines           QuotationLine[]
  lpos            Lpo[]
  documents       ProcurementDocument[]

  @@unique([tenantId, id])
  @@unique([tenantId, rfqId, id])
  @@index([tenantId, rfqId])
  @@map("quotations")
}

// A quoted (or no-bid) line: price per unit of sale and the net price per base unit.
model QuotationLine {
  id                    String          @id @default(uuid(7)) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  quotationId           String          @map("quotation_id") @db.Uuid
  requisitionLineId     String          @map("requisition_line_id") @db.Uuid
  status                String          @db.VarChar(10)
  priceUnit             String?         @map("price_unit") @db.VarChar(20)
  unitPriceMinor        BigInt?         @map("unit_price_minor")
  vatTreatment          String?         @map("vat_treatment") @db.VarChar(15)
  priceRatio            String?         @map("price_ratio") @db.VarChar(120)
  netUnitPriceBaseMinor Decimal?        @map("net_unit_price_base_minor") @db.Decimal(30, 6)
  netAmountMinor        BigInt?         @map("net_amount_minor")
  priceId               String?         @map("price_id") @db.Uuid
  quotation             Quotation       @relation(fields: [tenantId, quotationId], references: [tenantId, id], onDelete: Cascade)
  requisitionLine       RequisitionLine @relation(fields: [tenantId, requisitionLineId], references: [tenantId, id], onDelete: Restrict)
  price                 MaterialPrice?  @relation(fields: [tenantId, priceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, quotationId, requisitionLineId])
  @@index([tenantId, requisitionLineId])
  @@map("quotation_lines")
}

// A Local Purchase Order (LPO-NNNN): the awarded quotation, priced lines and a supplier snapshot.
// Approved LPOs are commitments and never change; an amendment is a cancellation and a reissue.
model Lpo {
  id                   String            @id @default(uuid(7)) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  projectId            String            @map("project_id") @db.Uuid
  number               String            @db.VarChar(20)
  rfqId                String            @map("rfq_id") @db.Uuid
  quotationId          String            @map("quotation_id") @db.Uuid
  supplierId           String            @map("supplier_id") @db.Uuid
  replacesLpoId        String?           @map("replaces_lpo_id") @db.Uuid
  status               String            @default("draft") @db.VarChar(20)
  deliverySiteId       String?           @map("delivery_site_id") @db.Uuid
  deliveryDate         DateTime?         @map("delivery_date") @db.Date
  terms                String?           @db.VarChar(2000)
  creditDays           Int               @map("credit_days")
  supplierName         String            @map("supplier_name") @db.VarChar(200)
  supplierKraPinMasked String?           @map("supplier_kra_pin_masked") @db.VarChar(16)
  supplierEtimsStatus  String            @map("supplier_etims_status") @db.VarChar(20)
  vatRatePercent       Decimal           @map("vat_rate_percent") @db.Decimal(7, 4)
  vatRuleStatus        String            @map("vat_rule_status") @db.VarChar(30)
  subtotalMinor        BigInt            @map("subtotal_minor")
  vatMinor             BigInt            @map("vat_minor")
  totalMinor           BigInt            @map("total_minor")
  contributors         String[]          @default([]) @db.Uuid
  version              Int               @default(1)
  createdBy            String            @map("created_by") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedBy            String            @map("updated_by") @db.Uuid
  updatedAt            DateTime          @default(now()) @map("updated_at") @db.Timestamptz
  submittedBy          String?           @map("submitted_by") @db.Uuid
  submittedAt          DateTime?         @map("submitted_at") @db.Timestamptz
  approvedBy           String?           @map("approved_by") @db.Uuid
  approvedAt           DateTime?         @map("approved_at") @db.Timestamptz
  returnReason         String?           @map("return_reason") @db.VarChar(500)
  cancelledBy          String?           @map("cancelled_by") @db.Uuid
  cancelledAt          DateTime?         @map("cancelled_at") @db.Timestamptz
  cancelReason         String?           @map("cancel_reason") @db.VarChar(500)
  project              Project           @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  rfq                  Rfq               @relation(fields: [tenantId, projectId, rfqId], references: [tenantId, projectId, id], onDelete: Restrict)
  quotation            Quotation         @relation(fields: [tenantId, rfqId, quotationId], references: [tenantId, rfqId, id], onDelete: Restrict)
  supplier             Supplier          @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  deliverySite         Site?             @relation(fields: [tenantId, deliverySiteId], references: [tenantId, id], onDelete: Restrict)
  replaces             Lpo?              @relation("LpoReissue", fields: [tenantId, replacesLpoId], references: [tenantId, id], onDelete: Restrict)
  replacedBy           Lpo[]             @relation("LpoReissue")
  lines                LpoLine[]
  grns                 Grn[]
  invoices             SupplierInvoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, number])
  @@index([tenantId, projectId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, rfqId])
  @@map("lpos")
}

// An ordered line: the requested quantity, the quoted price and the net amount (half-up once).
model LpoLine {
  id                    String                @id @default(uuid(7)) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  lpoId                 String                @map("lpo_id") @db.Uuid
  lineNo                Int                   @map("line_no")
  requisitionLineId     String                @map("requisition_line_id") @db.Uuid
  materialId            String                @map("material_id") @db.Uuid
  quantity              Decimal               @db.Decimal(20, 6)
  unit                  String                @db.VarChar(20)
  baseQuantity          Decimal               @map("base_quantity") @db.Decimal(20, 6)
  baseUnit              String                @map("base_unit") @db.VarChar(20)
  priceUnit             String                @map("price_unit") @db.VarChar(20)
  unitPriceMinor        BigInt                @map("unit_price_minor")
  vatTreatment          String                @map("vat_treatment") @db.VarChar(15)
  priceRatio            String                @map("price_ratio") @db.VarChar(120)
  netUnitPriceBaseMinor Decimal               @map("net_unit_price_base_minor") @db.Decimal(30, 6)
  netAmountMinor        BigInt                @map("net_amount_minor")
  lpo                   Lpo                   @relation(fields: [tenantId, lpoId], references: [tenantId, id], onDelete: Cascade)
  requisitionLine       RequisitionLine       @relation(fields: [tenantId, requisitionLineId], references: [tenantId, id], onDelete: Restrict)
  material              Material              @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Restrict)
  grnLines              GrnLine[]
  invoiceLines          SupplierInvoiceLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, lpoId, id])
  @@unique([tenantId, lpoId, lineNo])
  @@index([tenantId, requisitionLineId])
  @@map("lpo_lines")
}

// A Goods Received Note (GRN-NNNN): append-only delivery evidence with a client-generated ID and
// an idempotency key (offline sync), the device's capture time and the server's receipt time.
model Grn {
  id                        String                @id @db.Uuid
  tenantId                  String                @map("tenant_id") @db.Uuid
  projectId                 String                @map("project_id") @db.Uuid
  lpoId                     String                @map("lpo_id") @db.Uuid
  siteId                    String?               @map("site_id") @db.Uuid
  number                    String                @db.VarChar(20)
  status                    String                @default("recorded") @db.VarChar(10)
  idempotencyKey            String                @map("idempotency_key") @db.VarChar(100)
  requestDigest             String                @map("request_digest") @db.Char(64)
  capturedAt                DateTime              @map("captured_at") @db.Timestamptz
  receivedAt                DateTime              @default(now()) @map("received_at") @db.Timestamptz
  receivedByName            String                @map("received_by_name") @db.VarChar(100)
  recordedBy                String                @map("recorded_by") @db.Uuid
  vehicleRegistration       String                @map("vehicle_registration") @db.VarChar(15)
  vehicleRegistrationFormat String                @map("vehicle_registration_format") @db.VarChar(10)
  deliveryNoteNumber        String?               @map("delivery_note_number") @db.VarChar(60)
  latitude                  Decimal?              @db.Decimal(9, 6)
  longitude                 Decimal?              @db.Decimal(9, 6)
  accuracyM                 Decimal?              @map("accuracy_m") @db.Decimal(9, 1)
  locationState             String                @map("location_state") @db.VarChar(12)
  lowAccuracy               Boolean               @default(false) @map("low_accuracy")
  locationError             String?               @map("location_error") @db.VarChar(12)
  geofenceVersion           Int?                  @map("geofence_version")
  overDelivery              Boolean               @default(false) @map("over_delivery")
  lineCount                 Int                   @map("line_count")
  source                    String                @db.VarChar(10)
  notes                     String?               @db.VarChar(1000)
  voidedBy                  String?               @map("voided_by") @db.Uuid
  voidedAt                  DateTime?             @map("voided_at") @db.Timestamptz
  voidReason                String?               @map("void_reason") @db.VarChar(500)
  project                   Project               @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  lpo                       Lpo                   @relation(fields: [tenantId, projectId, lpoId], references: [tenantId, projectId, id], onDelete: Restrict)
  site                      Site?                 @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict)
  geofence                  SiteGeofence?         @relation(fields: [tenantId, siteId, geofenceVersion], references: [tenantId, siteId, version], onDelete: Restrict)
  lines                     GrnLine[]
  documents                 ProcurementDocument[]
  stockEntries              StockLedgerEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, lpoId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, projectId])
  @@map("grns")
}

// A counted line: received and rejected quantities in a unit, the accepted base quantity.
model GrnLine {
  id                   String             @id @default(uuid(7)) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  grnId                String             @map("grn_id") @db.Uuid
  lpoId                String             @map("lpo_id") @db.Uuid
  lpoLineId            String             @map("lpo_line_id") @db.Uuid
  lineNo               Int                @map("line_no")
  unit                 String             @db.VarChar(20)
  receivedQuantity     Decimal            @map("received_quantity") @db.Decimal(20, 6)
  rejectedQuantity     Decimal            @map("rejected_quantity") @db.Decimal(20, 6)
  rejectionReason      String?            @map("rejection_reason") @db.VarChar(300)
  acceptedBaseQuantity Decimal            @map("accepted_base_quantity") @db.Decimal(20, 6)
  overDelivery         Boolean            @default(false) @map("over_delivery")
  conversion           Json
  grn                  Grn                @relation(fields: [tenantId, lpoId, grnId], references: [tenantId, lpoId, id], onDelete: Cascade)
  lpoLine              LpoLine            @relation(fields: [tenantId, lpoId, lpoLineId], references: [tenantId, lpoId, id], onDelete: Restrict)
  stockEntries         StockLedgerEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, grnId, lpoLineId])
  @@index([tenantId, lpoLineId])
  @@map("grn_lines")
}

// A supplier invoice against one LPO with the KRA eTIMS number (CR-TAX-02). content_version
// increments with every content change; matches and payables bind to it.
model SupplierInvoice {
  id                    String                @id @default(uuid(7)) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  projectId             String                @map("project_id") @db.Uuid
  lpoId                 String                @map("lpo_id") @db.Uuid
  supplierId            String                @map("supplier_id") @db.Uuid
  invoiceNumber         String                @map("invoice_number") @db.VarChar(60)
  invoiceNumberKey      String                @map("invoice_number_key") @db.VarChar(60)
  invoiceDate           DateTime              @map("invoice_date") @db.Date
  dueDate               DateTime              @map("due_date") @db.Date
  etimsInvoiceNumber    String?               @map("etims_invoice_number") @db.VarChar(40)
  etimsFormat           String?               @map("etims_format") @db.VarChar(15)
  vatRatePercent        Decimal               @map("vat_rate_percent") @db.Decimal(7, 4)
  vatRuleStatus         String                @map("vat_rule_status") @db.VarChar(30)
  subtotalMinor         BigInt                @map("subtotal_minor")
  vatMinor              BigInt                @map("vat_minor")
  totalMinor            BigInt                @map("total_minor")
  computedSubtotalMinor BigInt                @map("computed_subtotal_minor")
  computedVatMinor      BigInt                @map("computed_vat_minor")
  status                String                @default("draft") @db.VarChar(20)
  contentVersion        Int                   @default(1) @map("content_version")
  notes                 String?               @db.VarChar(1000)
  contributors          String[]              @default([]) @db.Uuid
  version               Int                   @default(1)
  createdBy             String                @map("created_by") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedBy             String                @map("updated_by") @db.Uuid
  updatedAt             DateTime              @default(now()) @map("updated_at") @db.Timestamptz
  submittedBy           String?               @map("submitted_by") @db.Uuid
  submittedAt           DateTime?             @map("submitted_at") @db.Timestamptz
  cancelledBy           String?               @map("cancelled_by") @db.Uuid
  cancelledAt           DateTime?             @map("cancelled_at") @db.Timestamptz
  cancelReason          String?               @map("cancel_reason") @db.VarChar(500)
  project               Project               @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  lpo                   Lpo                   @relation(fields: [tenantId, projectId, lpoId], references: [tenantId, projectId, id], onDelete: Restrict)
  supplier              Supplier              @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  lines                 SupplierInvoiceLine[]
  matches               ThreeWayMatch[]
  payables              InvoicePayable[]
  documents             ProcurementDocument[]
  costEntries           CostEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, lpoId, id])
  @@unique([tenantId, projectId, id])
  @@index([tenantId, projectId, status])
  @@index([tenantId, supplierId])
  @@map("supplier_invoices")
}

// A billed line against an LPO line, in any convertible unit, net of VAT per base unit.
model SupplierInvoiceLine {
  id                    String          @id @default(uuid(7)) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  invoiceId             String          @map("invoice_id") @db.Uuid
  lpoId                 String          @map("lpo_id") @db.Uuid
  lpoLineId             String          @map("lpo_line_id") @db.Uuid
  lineNo                Int             @map("line_no")
  quantity              Decimal         @db.Decimal(20, 6)
  unit                  String          @db.VarChar(20)
  baseQuantity          Decimal         @map("base_quantity") @db.Decimal(20, 6)
  unitPriceMinor        BigInt          @map("unit_price_minor")
  vatTreatment          String          @map("vat_treatment") @db.VarChar(15)
  priceRatio            String          @map("price_ratio") @db.VarChar(120)
  netUnitPriceBaseMinor Decimal         @map("net_unit_price_base_minor") @db.Decimal(30, 6)
  netAmountMinor        BigInt          @map("net_amount_minor")
  conversion            Json
  invoice               SupplierInvoice @relation(fields: [tenantId, lpoId, invoiceId], references: [tenantId, lpoId, id], onDelete: Cascade)
  lpoLine               LpoLine         @relation(fields: [tenantId, lpoId, lpoLineId], references: [tenantId, lpoId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId, lpoLineId])
  @@index([tenantId, lpoLineId])
  @@map("supplier_invoice_lines")
}

// One run of the three-way match (append-only evidence). It is current only while the invoice's
// content version, the LPO's recorded GRNs and its other approved invoices are unchanged.
model ThreeWayMatch {
  id                    String           @id @default(uuid(7)) @db.Uuid
  tenantId              String           @map("tenant_id") @db.Uuid
  invoiceId             String           @map("invoice_id") @db.Uuid
  lpoId                 String           @map("lpo_id") @db.Uuid
  invoiceContentVersion Int              @map("invoice_content_version")
  grnIds                String[]         @map("grn_ids") @db.Uuid
  priorInvoiceIds       String[]         @map("prior_invoice_ids") @db.Uuid
  qtyTolerancePercent   Decimal          @map("qty_tolerance_percent") @db.Decimal(7, 4)
  priceTolerancePercent Decimal          @map("price_tolerance_percent") @db.Decimal(7, 4)
  blockWithoutEtims     Boolean          @map("block_without_etims")
  outcome               String           @db.VarChar(10)
  reasons               String[]
  evidence              Json
  computedBy            String           @map("computed_by") @db.Uuid
  computedAt            DateTime         @default(now()) @map("computed_at") @db.Timestamptz
  exceptionReason       String?          @map("exception_reason") @db.VarChar(500)
  exceptionBy           String?          @map("exception_by") @db.Uuid
  exceptionAt           DateTime?        @map("exception_at") @db.Timestamptz
  invoice               SupplierInvoice  @relation(fields: [tenantId, lpoId, invoiceId], references: [tenantId, lpoId, id], onDelete: Restrict)
  payables              InvoicePayable[]

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId, id])
  @@index([tenantId, invoiceId, computedAt])
  @@map("three_way_matches")
}

// A payable obligation: the approval snapshot of an invoice (content version, passing match,
// verified payee version, authorised amount). D4.2/D4.3 payment attempts settle these.
model InvoicePayable {
  id                    String                @id @default(uuid(7)) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  invoiceId             String                @map("invoice_id") @db.Uuid
  invoiceContentVersion Int                   @map("invoice_content_version")
  matchId               String                @map("match_id") @db.Uuid
  payoutVersionId       String                @map("payout_version_id") @db.Uuid
  authorisedMinor       BigInt                @map("authorised_minor")
  currency              String                @default("KES") @db.Char(3)
  approvedBy            String                @map("approved_by") @db.Uuid
  approvedAt            DateTime              @default(now()) @map("approved_at") @db.Timestamptz
  supersededBy          String?               @map("superseded_by") @db.Uuid
  supersededAt          DateTime?             @map("superseded_at") @db.Timestamptz
  invoice               SupplierInvoice       @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  match                 ThreeWayMatch         @relation(fields: [tenantId, invoiceId, matchId], references: [tenantId, invoiceId, id], onDelete: Restrict)
  payoutVersion         SupplierPayoutVersion @relation(fields: [tenantId, payoutVersionId], references: [tenantId, id], onDelete: Restrict)
  settlements           InvoiceSettlement[]

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId, id])
  @@index([tenantId, invoiceId])
  @@map("invoice_payables")
}

// A settlement recorded by hand (bank transfer, cheque, M-Pesa B2B done outside PM-Buddy).
// Append-only; the external reference is unique per company and method.
model InvoiceSettlement {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  invoiceId         String         @map("invoice_id") @db.Uuid
  payableId         String         @map("payable_id") @db.Uuid
  method            String         @db.VarChar(20)
  externalReference String         @map("external_reference") @db.VarChar(60)
  referenceKey      String         @map("reference_key") @db.VarChar(60)
  amountMinor       BigInt         @map("amount_minor")
  paidOn            DateTime       @map("paid_on") @db.Date
  note              String?        @db.VarChar(500)
  idempotencyKey    String         @map("idempotency_key") @db.VarChar(100)
  requestDigest     String         @map("request_digest") @db.Char(64)
  recordedBy        String         @map("recorded_by") @db.Uuid
  recordedAt        DateTime       @default(now()) @map("recorded_at") @db.Timestamptz
  payable           InvoicePayable @relation(fields: [tenantId, invoiceId, payableId], references: [tenantId, invoiceId, id], onDelete: Restrict)
  costEntries       CostEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId, id])
  @@unique([tenantId, method, referenceKey])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, invoiceId])
  @@map("invoice_settlements")
}

// A private file kept with a quotation, GRN or invoice (images or PDF; malware hook; never public).
model ProcurementDocument {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  kind        String           @db.VarChar(20)
  quotationId String?          @map("quotation_id") @db.Uuid
  grnId       String?          @map("grn_id") @db.Uuid
  invoiceId   String?          @map("invoice_id") @db.Uuid
  objectKey   String           @map("object_key") @db.VarChar(300)
  contentType String           @map("content_type") @db.VarChar(40)
  sizeBytes   Int              @map("size_bytes")
  sha256      String           @db.Char(64)
  scanStatus  String           @map("scan_status") @db.VarChar(15)
  scanEngine  String           @map("scan_engine") @db.VarChar(40)
  scannedAt   DateTime         @map("scanned_at") @db.Timestamptz
  uploadedBy  String           @map("uploaded_by") @db.Uuid
  uploadedAt  DateTime         @default(now()) @map("uploaded_at") @db.Timestamptz
  quotation   Quotation?       @relation(fields: [tenantId, quotationId], references: [tenantId, id], onDelete: Restrict)
  grn         Grn?             @relation(fields: [tenantId, grnId], references: [tenantId, id], onDelete: Restrict)
  invoice     SupplierInvoice? @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, objectKey])
  @@index([tenantId, quotationId])
  @@index([tenantId, grnId])
  @@index([tenantId, invoiceId])
  @@map("procurement_documents")
}

// D5.3 stores (ARCHITECTURE §4.6). One store per site, created explicitly or on the first GRN for
// the site; the storekeeper is optional (a company member, checked by app.guard_store).
model Store {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  projectId     String              @map("project_id") @db.Uuid
  siteId        String              @map("site_id") @db.Uuid
  name          String              @db.VarChar(120)
  storekeeperId String?             @map("storekeeper_user_id") @db.Uuid
  version       Int                 @default(1)
  createdBy     String              @map("created_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String              @map("updated_by") @db.Uuid
  updatedAt     DateTime            @default(now()) @map("updated_at") @db.Timestamptz
  site          Site                @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: Restrict)
  balances      StockBalance[]
  entries       StockLedgerEntry[]
  movements     StockMovement[]
  transfersOut  StockTransfer[]     @relation("TransferFrom")
  transfersIn   StockTransfer[]     @relation("TransferTo")
  stockTakes    StockTake[]
  reorderLevels StockReorderLevel[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, siteId])
  @@index([tenantId, projectId])
  @@map("stores")
}

// On-hand quantity (base unit) and value (KES minor units, weighted average) per store and
// material. Written only by the ledger trigger (app.post_stock_entry → app.apply_stock_entry); a
// guard refuses any other change. Never negative.
model StockBalance {
  tenantId    String             @map("tenant_id") @db.Uuid
  storeId     String             @map("store_id") @db.Uuid
  materialId  String             @map("material_id") @db.Uuid
  quantity    Decimal            @default(0) @db.Decimal(20, 6)
  valueMinor  Decimal            @default(0) @map("value_minor") @db.Decimal(30, 6)
  lastSeq     BigInt             @default(0) @map("last_seq")
  lastEntryAt DateTime?          @map("last_entry_at") @db.Timestamptz
  store       Store              @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  material    Material           @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Restrict)
  entries     StockLedgerEntry[]

  @@id([tenantId, storeId, materialId])
  @@index([tenantId, materialId])
  @@map("stock_balances")
}

// The append-only stock ledger: signed base-unit quantities with the value moved and the running
// balance, numbered per store and material (seq). Exactly one source document per entry; a
// correction is an entry of the same kind and opposite sign that names the entry it reverses.
model StockLedgerEntry {
  id                String             @id @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  projectId         String             @map("project_id") @db.Uuid
  storeId           String             @map("store_id") @db.Uuid
  materialId        String             @map("material_id") @db.Uuid
  baseUnit          String             @map("base_unit") @db.VarChar(20)
  seq               BigInt
  kind              String             @db.VarChar(15)
  quantity          Decimal            @db.Decimal(20, 6)
  unitCostMinor     Decimal            @map("unit_cost_minor") @db.Decimal(30, 6)
  valueMinor        Decimal            @map("value_minor") @db.Decimal(30, 6)
  balanceQuantity   Decimal            @map("balance_quantity") @db.Decimal(20, 6)
  balanceValueMinor Decimal            @map("balance_value_minor") @db.Decimal(30, 6)
  businessDate      DateTime           @map("business_date") @db.Date
  recordedBy        String             @map("recorded_by") @db.Uuid
  recordedAt        DateTime           @default(now()) @map("recorded_at") @db.Timestamptz
  grnId             String?            @map("grn_id") @db.Uuid
  grnLineId         String?            @map("grn_line_id") @db.Uuid
  movementId        String?            @map("movement_id") @db.Uuid
  movementLineId    String?            @map("movement_line_id") @db.Uuid
  transferId        String?            @map("transfer_id") @db.Uuid
  transferLineId    String?            @map("transfer_line_id") @db.Uuid
  stockTakeId       String?            @map("stock_take_id") @db.Uuid
  stockTakeLineId   String?            @map("stock_take_line_id") @db.Uuid
  bqVersionId       String?            @map("bq_version_id") @db.Uuid
  bqItemLineageId   String?            @map("bq_item_lineage_id") @db.Uuid
  gangId            String?            @map("gang_id") @db.Uuid
  reversesEntryId   String?            @map("reverses_entry_id") @db.Uuid
  store             Store              @relation(fields: [tenantId, projectId, storeId], references: [tenantId, projectId, id], onDelete: Restrict)
  balance           StockBalance       @relation(fields: [tenantId, storeId, materialId], references: [tenantId, storeId, materialId], onDelete: Restrict)
  material          Material           @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Restrict)
  grn               Grn?               @relation(fields: [tenantId, grnId], references: [tenantId, id], onDelete: Restrict)
  grnLine           GrnLine?           @relation(fields: [tenantId, grnLineId], references: [tenantId, id], onDelete: Restrict)
  movement          StockMovement?     @relation(fields: [tenantId, movementId], references: [tenantId, id], onDelete: Restrict)
  movementLine      StockMovementLine? @relation(fields: [tenantId, movementLineId], references: [tenantId, id], onDelete: Restrict)
  transfer          StockTransfer?     @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Restrict)
  transferLine      StockTransferLine? @relation(fields: [tenantId, transferLineId], references: [tenantId, id], onDelete: Restrict)
  stockTake         StockTake?         @relation(fields: [tenantId, stockTakeId], references: [tenantId, id], onDelete: Restrict)
  stockTakeLine     StockTakeLine?     @relation(fields: [tenantId, stockTakeLineId], references: [tenantId, id], onDelete: Restrict)
  bqItem            BqItem?            @relation(fields: [tenantId, bqVersionId, bqItemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  gang              Gang?              @relation(fields: [tenantId, projectId, gangId], references: [tenantId, projectId, id], onDelete: Restrict)
  reverses          StockLedgerEntry?  @relation("StockReversal", fields: [tenantId, reversesEntryId], references: [tenantId, id], onDelete: Restrict)
  reversedBy        StockLedgerEntry?  @relation("StockReversal")

  @@unique([tenantId, id])
  @@unique([tenantId, storeId, materialId, seq])
  @@unique([tenantId, reversesEntryId])
  @@index([tenantId, storeId, id])
  @@index([tenantId, projectId, bqItemLineageId])
  @@index([tenantId, grnId])
  @@index([tenantId, movementId])
  @@index([tenantId, transferId])
  @@index([tenantId, stockTakeId])
  @@map("stock_ledger_entries")
}

// An issue (to a BQ item and/or a gang), a return of issued material or a wastage record: one
// store, numbered ISS-/RTN-/WST-NNNN, offline-ready (client ID, idempotency key and digest).
// Posted once; a mistaken one is reversed with a reason, never edited.
model StockMovement {
  id              String              @id @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  projectId       String              @map("project_id") @db.Uuid
  storeId         String              @map("store_id") @db.Uuid
  kind            String              @db.VarChar(10)
  number          String              @db.VarChar(20)
  status          String              @default("posted") @db.VarChar(10)
  bqVersionId     String?             @map("bq_version_id") @db.Uuid
  bqItemLineageId String?             @map("bq_item_lineage_id") @db.Uuid
  gangId          String?             @map("gang_id") @db.Uuid
  issuedToName    String?             @map("issued_to_name") @db.VarChar(100)
  returnOfId      String?             @map("return_of_id") @db.Uuid
  wastageReason   String?             @map("wastage_reason") @db.VarChar(20)
  notes           String?             @db.VarChar(1000)
  idempotencyKey  String              @map("idempotency_key") @db.VarChar(100)
  requestDigest   String              @map("request_digest") @db.Char(64)
  capturedAt      DateTime            @map("captured_at") @db.Timestamptz
  businessDate    DateTime            @map("business_date") @db.Date
  source          String              @db.VarChar(10)
  lineCount       Int                 @map("line_count")
  recordedBy      String              @map("recorded_by") @db.Uuid
  recordedAt      DateTime            @default(now()) @map("recorded_at") @db.Timestamptz
  reversedBy      String?             @map("reversed_by") @db.Uuid
  reversedAt      DateTime?           @map("reversed_at") @db.Timestamptz
  reversalReason  String?             @map("reversal_reason") @db.VarChar(500)
  store           Store               @relation(fields: [tenantId, projectId, storeId], references: [tenantId, projectId, id], onDelete: Restrict)
  bqItem          BqItem?             @relation(fields: [tenantId, bqVersionId, bqItemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  gang            Gang?               @relation(fields: [tenantId, projectId, gangId], references: [tenantId, projectId, id], onDelete: Restrict)
  returnOf        StockMovement?      @relation("MovementReturns", fields: [tenantId, storeId, returnOfId], references: [tenantId, storeId, id], onDelete: Restrict)
  returns         StockMovement[]     @relation("MovementReturns")
  lines           StockMovementLine[]
  entries         StockLedgerEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, storeId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, storeId, kind])
  @@index([tenantId, projectId, bqItemLineageId])
  @@index([tenantId, returnOfId])
  @@map("stock_movements")
}

// A movement line: the quantity as entered, its base-unit quantity and the conversion used.
model StockMovementLine {
  id             String              @id @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  movementId     String              @map("movement_id") @db.Uuid
  lineNo         Int                 @map("line_no")
  materialId     String              @map("material_id") @db.Uuid
  quantity       Decimal             @db.Decimal(20, 6)
  unit           String              @db.VarChar(20)
  baseQuantity   Decimal             @map("base_quantity") @db.Decimal(20, 6)
  conversion     Json
  returnOfLineId String?             @map("return_of_line_id") @db.Uuid
  movement       StockMovement       @relation(fields: [tenantId, movementId], references: [tenantId, id], onDelete: Restrict)
  material       Material            @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Restrict)
  returnOfLine   StockMovementLine?  @relation("LineReturns", fields: [tenantId, returnOfLineId], references: [tenantId, id], onDelete: Restrict)
  returns        StockMovementLine[] @relation("LineReturns")
  entries        StockLedgerEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, movementId, lineNo])
  @@unique([tenantId, movementId, materialId])
  @@index([tenantId, returnOfLineId])
  @@map("stock_movement_lines")
}

// An inter-site transfer (TRF-NNNN): dispatched (in transit) → received | disputed → resolved, or
// cancelled while in transit. Dispatch and receipt are each offline-ready (client ID / key).
model StockTransfer {
  id                    String              @id @db.Uuid
  tenantId              String              @map("tenant_id") @db.Uuid
  number                String              @db.VarChar(20)
  fromProjectId         String              @map("from_project_id") @db.Uuid
  fromStoreId           String              @map("from_store_id") @db.Uuid
  toProjectId           String              @map("to_project_id") @db.Uuid
  toStoreId             String              @map("to_store_id") @db.Uuid
  status                String              @default("dispatched") @db.VarChar(12)
  source                String              @db.VarChar(10)
  idempotencyKey        String              @map("idempotency_key") @db.VarChar(100)
  requestDigest         String              @map("request_digest") @db.Char(64)
  capturedAt            DateTime            @map("captured_at") @db.Timestamptz
  dispatchedBy          String              @map("dispatched_by") @db.Uuid
  dispatchedAt          DateTime            @default(now()) @map("dispatched_at") @db.Timestamptz
  dispatchNotes         String?             @map("dispatch_notes") @db.VarChar(1000)
  receiveIdempotencyKey String?             @map("receive_idempotency_key") @db.VarChar(100)
  receiveDigest         String?             @map("receive_digest") @db.Char(64)
  receiveCapturedAt     DateTime?           @map("receive_captured_at") @db.Timestamptz
  receivedBy            String?             @map("received_by") @db.Uuid
  receivedAt            DateTime?           @map("received_at") @db.Timestamptz
  receiveNotes          String?             @map("receive_notes") @db.VarChar(1000)
  resolvedBy            String?             @map("resolved_by") @db.Uuid
  resolvedAt            DateTime?           @map("resolved_at") @db.Timestamptz
  resolutionNote        String?             @map("resolution_note") @db.VarChar(500)
  cancelledBy           String?             @map("cancelled_by") @db.Uuid
  cancelledAt           DateTime?           @map("cancelled_at") @db.Timestamptz
  cancelReason          String?             @map("cancel_reason") @db.VarChar(500)
  lineCount             Int                 @map("line_count")
  version               Int                 @default(1)
  fromStore             Store               @relation("TransferFrom", fields: [tenantId, fromProjectId, fromStoreId], references: [tenantId, projectId, id], onDelete: Restrict)
  toStore               Store               @relation("TransferTo", fields: [tenantId, toProjectId, toStoreId], references: [tenantId, projectId, id], onDelete: Restrict)
  lines                 StockTransferLine[]
  entries               StockLedgerEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, receiveIdempotencyKey])
  @@index([tenantId, fromStoreId, status])
  @@index([tenantId, toStoreId, status])
  @@map("stock_transfers")
}

// A transfer line: dispatched quantity and its value at the source's average cost, then what was
// received (base unit) with a reason for any difference.
model StockTransferLine {
  id                   String             @id @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  transferId           String             @map("transfer_id") @db.Uuid
  lineNo               Int                @map("line_no")
  materialId           String             @map("material_id") @db.Uuid
  quantity             Decimal            @db.Decimal(20, 6)
  unit                 String             @db.VarChar(20)
  baseQuantity         Decimal            @map("base_quantity") @db.Decimal(20, 6)
  conversion           Json
  unitCostMinor        Decimal            @map("unit_cost_minor") @db.Decimal(30, 6)
  dispatchedValueMinor Decimal            @map("dispatched_value_minor") @db.Decimal(30, 6)
  receivedBaseQuantity Decimal?           @map("received_base_quantity") @db.Decimal(20, 6)
  differenceReason     String?            @map("difference_reason") @db.VarChar(300)
  transfer             StockTransfer      @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Restrict)
  material             Material           @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Restrict)
  entries              StockLedgerEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, transferId, lineNo])
  @@unique([tenantId, transferId, materialId])
  @@map("stock_transfer_lines")
}

// A stock take (STK-NNNN): a count sheet with the system quantity at the start, counts compared
// with the system quantity when each line was counted, submitted and approved by someone who did
// not contribute (contributors only grow); approval posts the variances as adjustments.
model StockTake {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  projectId    String             @map("project_id") @db.Uuid
  storeId      String             @map("store_id") @db.Uuid
  number       String             @db.VarChar(20)
  status       String             @default("draft") @db.VarChar(12)
  notes        String?            @db.VarChar(1000)
  contributors String[]           @default([]) @db.Uuid
  lineCount    Int                @map("line_count")
  version      Int                @default(1)
  createdBy    String             @map("created_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedBy    String             @map("updated_by") @db.Uuid
  updatedAt    DateTime           @default(now()) @map("updated_at") @db.Timestamptz
  submittedBy  String?            @map("submitted_by") @db.Uuid
  submittedAt  DateTime?          @map("submitted_at") @db.Timestamptz
  approvedBy   String?            @map("approved_by") @db.Uuid
  approvedAt   DateTime?          @map("approved_at") @db.Timestamptz
  returnReason String?            @map("return_reason") @db.VarChar(500)
  cancelledBy  String?            @map("cancelled_by") @db.Uuid
  cancelledAt  DateTime?          @map("cancelled_at") @db.Timestamptz
  cancelReason String?            @map("cancel_reason") @db.VarChar(500)
  store        Store              @relation(fields: [tenantId, projectId, storeId], references: [tenantId, projectId, id], onDelete: Restrict)
  lines        StockTakeLine[]
  counts       StockTakeCount[]
  entries      StockLedgerEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, storeId, status])
  @@map("stock_takes")
}

// A count-sheet line: the snapshot at the start and the latest count with the system quantity
// (expected) and ledger position when it was counted.
model StockTakeLine {
  id               String             @id @default(uuid(7)) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  stockTakeId      String             @map("stock_take_id") @db.Uuid
  lineNo           Int                @map("line_no")
  materialId       String             @map("material_id") @db.Uuid
  snapshotQuantity Decimal            @map("snapshot_quantity") @db.Decimal(20, 6)
  snapshotSeq      BigInt             @map("snapshot_seq")
  countedQuantity  Decimal?           @map("counted_quantity") @db.Decimal(20, 6)
  expectedQuantity Decimal?           @map("expected_quantity") @db.Decimal(20, 6)
  countedSeq       BigInt?            @map("counted_seq")
  countedBy        String?            @map("counted_by") @db.Uuid
  countedAt        DateTime?          @map("counted_at") @db.Timestamptz
  countId          String?            @map("count_id") @db.Uuid
  stockTake        StockTake          @relation(fields: [tenantId, stockTakeId], references: [tenantId, id], onDelete: Restrict)
  material         Material           @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Restrict)
  counts           StockTakeCount[]
  entries          StockLedgerEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, stockTakeId, id])
  @@unique([tenantId, stockTakeId, lineNo])
  @@unique([tenantId, stockTakeId, materialId])
  @@map("stock_take_lines")
}

// Append-only count evidence (client ID, idempotency key and digest per batch).
model StockTakeCount {
  id               String        @id @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  stockTakeId      String        @map("stock_take_id") @db.Uuid
  lineId           String        @map("line_id") @db.Uuid
  countedQuantity  Decimal       @map("counted_quantity") @db.Decimal(20, 6)
  expectedQuantity Decimal       @map("expected_quantity") @db.Decimal(20, 6)
  countedSeq       BigInt        @map("counted_seq")
  idempotencyKey   String        @map("idempotency_key") @db.VarChar(100)
  requestDigest    String        @map("request_digest") @db.Char(64)
  capturedAt       DateTime      @map("captured_at") @db.Timestamptz
  countedBy        String        @map("counted_by") @db.Uuid
  countedAt        DateTime      @default(now()) @map("counted_at") @db.Timestamptz
  stockTake        StockTake     @relation(fields: [tenantId, stockTakeId], references: [tenantId, id], onDelete: Restrict)
  line             StockTakeLine @relation(fields: [tenantId, stockTakeId, lineId], references: [tenantId, stockTakeId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, idempotencyKey])
  @@index([tenantId, lineId])
  @@map("stock_take_counts")
}

// Reorder level per store and material (base unit); low stock when on hand ≤ level.
model StockReorderLevel {
  tenantId     String   @map("tenant_id") @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  materialId   String   @map("material_id") @db.Uuid
  reorderLevel Decimal  @map("reorder_level") @db.Decimal(20, 6)
  updatedBy    String   @map("updated_by") @db.Uuid
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz
  store        Store    @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  material     Material @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, storeId, materialId])
  @@map("stock_reorder_levels")
}

// Minimal progress measurement (ERD §4; D5.3 for consumption variance, D6.3 extends with
// submission, approval, photos and valuations): quantity completed to date of a BQ item lineage,
// append-only; a correction is a new row naming the one it corrects.
model ProgressMeasurement {
  id                String                     @id @default(uuid(7)) @db.Uuid
  tenantId          String                     @map("tenant_id") @db.Uuid
  projectId         String                     @map("project_id") @db.Uuid
  bqId              String                     @map("bq_id") @db.Uuid
  versionId         String                     @map("version_id") @db.Uuid
  itemLineageId     String                     @map("item_lineage_id") @db.Uuid
  measuredOn        DateTime                   @map("measured_on") @db.Date
  quantityToDate    Decimal                    @map("quantity_to_date") @db.Decimal(20, 4)
  status            String                     @default("recorded") @db.VarChar(12)
  note              String?                    @db.VarChar(500)
  correctsId        String?                    @map("corrects_id") @db.Uuid
  correctionReason  String?                    @map("correction_reason") @db.VarChar(500)
  measuredBy        String                     @map("measured_by") @db.Uuid
  recordedAt        DateTime                   @default(now()) @map("recorded_at") @db.Timestamptz
  // D6.3: quantity or percent (null on D5.3 rows), the reason for an over-measure, and the
  // offline contract (Idempotency-Key with the request digest).
  basis             String?                    @db.VarChar(10)
  overMeasureReason String?                    @map("over_measure_reason") @db.VarChar(500)
  idempotencyKey    String?                    @map("idempotency_key") @db.VarChar(100)
  requestDigest     String?                    @map("request_digest") @db.Char(64)
  bq                Bq                         @relation(fields: [tenantId, projectId, bqId], references: [tenantId, projectId, id], onDelete: Restrict)
  version           BqVersion                  @relation(fields: [tenantId, bqId, versionId], references: [tenantId, bqId, id], onDelete: Restrict)
  item              BqItem                     @relation(fields: [tenantId, versionId, itemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  corrects          ProgressMeasurement?       @relation("MeasurementCorrection", fields: [tenantId, correctsId], references: [tenantId, id], onDelete: Restrict)
  correctedBy       ProgressMeasurement?       @relation("MeasurementCorrection")
  photos            ProgressMeasurementPhoto[]
  review            ProgressMeasurementReview?
  valuationLines    ValuationLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, correctsId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, projectId, itemLineageId, measuredOn])
  @@map("progress_measurements")
}

// D6.3: site photos given as evidence of a measurement; added while it waits for review, never
// removed (append-only).
model ProgressMeasurementPhoto {
  tenantId      String              @map("tenant_id") @db.Uuid
  projectId     String              @map("project_id") @db.Uuid
  measurementId String              @map("measurement_id") @db.Uuid
  photoId       String              @map("photo_id") @db.Uuid
  addedBy       String              @map("added_by") @db.Uuid
  addedAt       DateTime            @default(now()) @map("added_at") @db.Timestamptz
  measurement   ProgressMeasurement @relation(fields: [tenantId, projectId, measurementId], references: [tenantId, projectId, id], onDelete: Restrict)
  photo         SitePhoto           @relation(fields: [tenantId, projectId, photoId], references: [tenantId, projectId, id], onDelete: Restrict)

  @@id([tenantId, measurementId, photoId])
  @@index([tenantId, projectId, photoId])
  @@map("progress_measurement_photos")
}

// D6.3: the independent review of a measurement (one per measurement, append-only).
model ProgressMeasurementReview {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  projectId     String              @map("project_id") @db.Uuid
  measurementId String              @map("measurement_id") @db.Uuid
  decision      String              @db.VarChar(10)
  reason        String?             @db.VarChar(500)
  decidedBy     String              @map("decided_by") @db.Uuid
  decidedAt     DateTime            @default(now()) @map("decided_at") @db.Timestamptz
  measurement   ProgressMeasurement @relation(fields: [tenantId, projectId, measurementId], references: [tenantId, projectId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, measurementId])
  @@index([tenantId, projectId, decidedAt])
  @@map("progress_measurement_reviews")
}

// D6.3: retention, VAT and materials-on-site terms of a project's contract; append-only versions,
// the newest in force; certificates store the version and the values they used.
model ContractSettings {
  tenantId                String   @map("tenant_id") @db.Uuid
  projectId               String   @map("project_id") @db.Uuid
  version                 Int
  retentionPercent        Decimal  @map("retention_percent") @db.Decimal(5, 2)
  retentionCapPercent     Decimal? @map("retention_cap_percent") @db.Decimal(5, 2)
  vatPercent              Decimal  @map("vat_percent") @db.Decimal(5, 2)
  materialsPercent        Decimal  @map("materials_percent") @db.Decimal(5, 2)
  practicalReleasePercent Decimal  @map("practical_release_percent") @db.Decimal(5, 2)
  createdBy               String   @map("created_by") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  project                 Project  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, projectId, version])
  @@map("contract_settings")
}

// D6.3: an interim valuation and its payment certificate (or a retention release). Figures are
// frozen at submission and never change once certified (database-enforced).
model Valuation {
  id                       String                @id @default(uuid(7)) @db.Uuid
  tenantId                 String                @map("tenant_id") @db.Uuid
  projectId                String                @map("project_id") @db.Uuid
  number                   Int
  certificateNumber        Int?                  @map("certificate_number")
  kind                     String                @db.VarChar(20)
  releaseStage             String?               @map("release_stage") @db.VarChar(10)
  status                   String                @default("draft") @db.VarChar(10)
  valuationDate            DateTime              @map("valuation_date") @db.Date
  notes                    String?               @db.VarChar(1000)
  materialsFromStores      Boolean               @default(false) @map("materials_from_stores")
  revision                 Int                   @default(0)
  bqVersionId              String?               @map("bq_version_id") @db.Uuid
  settingsVersion          Int?                  @map("settings_version")
  ruleVersion              String?               @map("rule_version") @db.VarChar(20)
  retentionPercent         Decimal?              @map("retention_percent") @db.Decimal(5, 2)
  retentionCapPercent      Decimal?              @map("retention_cap_percent") @db.Decimal(5, 2)
  vatPercent               Decimal?              @map("vat_percent") @db.Decimal(5, 2)
  materialsPercent         Decimal?              @map("materials_percent") @db.Decimal(5, 2)
  practicalReleasePercent  Decimal?              @map("practical_release_percent") @db.Decimal(5, 2)
  originalContractSumMinor BigInt?               @map("original_contract_sum_minor")
  revisedContractSumMinor  BigInt?               @map("revised_contract_sum_minor")
  workDoneMinor            BigInt?               @map("work_done_minor")
  materialsGrossMinor      BigInt?               @map("materials_gross_minor")
  materialsMinor           BigInt?               @map("materials_minor")
  grossMinor               BigInt?               @map("gross_minor")
  retentionStage           String?               @map("retention_stage") @db.VarChar(10)
  retentionCapMinor        BigInt?               @map("retention_cap_minor")
  retentionComputedMinor   BigInt?               @map("retention_computed_minor")
  retentionHeldMinor       BigInt?               @map("retention_held_minor")
  adjustmentsMinor         BigInt?               @map("adjustments_minor")
  adjustmentsToDateMinor   BigInt?               @map("adjustments_to_date_minor")
  netToDateMinor           BigInt?               @map("net_to_date_minor")
  previousCertifiedMinor   BigInt?               @map("previous_certified_minor")
  amountDueMinor           BigInt?               @map("amount_due_minor")
  vatMinor                 BigInt?               @map("vat_minor")
  totalMinor               BigInt?               @map("total_minor")
  lineCount                Int                   @default(0) @map("line_count")
  digest                   String?               @db.Char(64)
  contributors             String[]              @default([]) @db.Uuid
  createdBy                String                @map("created_by") @db.Uuid
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedBy                String                @map("updated_by") @db.Uuid
  updatedAt                DateTime              @default(now()) @map("updated_at") @db.Timestamptz
  submittedBy              String?               @map("submitted_by") @db.Uuid
  submittedAt              DateTime?             @map("submitted_at") @db.Timestamptz
  certifiedBy              String?               @map("certified_by") @db.Uuid
  certifiedAt              DateTime?             @map("certified_at") @db.Timestamptz
  cancelledBy              String?               @map("cancelled_by") @db.Uuid
  cancelledAt              DateTime?             @map("cancelled_at") @db.Timestamptz
  cancelReason             String?               @map("cancel_reason") @db.VarChar(500)
  returnReason             String?               @map("return_reason") @db.VarChar(500)
  version                  Int                   @default(1)
  project                  Project               @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  bqVersion                BqVersion?            @relation(fields: [tenantId, bqVersionId], references: [tenantId, id], onDelete: Restrict)
  lines                    ValuationLine[]
  materials                ValuationMaterial[]
  adjustments              ValuationAdjustment[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, number])
  @@unique([tenantId, projectId, certificateNumber])
  @@index([tenantId, projectId, status])
  @@map("valuations")
}

// D6.3: the lines frozen with each submission (revision) of a valuation: items valued from
// approved measurements, materials on site and agreed adjustments. Append-only.
model ValuationLine {
  tenantId        String               @map("tenant_id") @db.Uuid
  valuationId     String               @map("valuation_id") @db.Uuid
  revision        Int
  lineNo          Int                  @map("line_no")
  kind            String               @db.VarChar(12)
  bqVersionId     String?              @map("bq_version_id") @db.Uuid
  bqItemLineageId String?              @map("bq_item_lineage_id") @db.Uuid
  billLineageId   String?              @map("bill_lineage_id") @db.Uuid
  itemKind        String?              @map("item_kind") @db.VarChar(20)
  ref             String?              @db.VarChar(30)
  description     String               @db.VarChar(4000)
  unit            String?              @db.VarChar(20)
  basis           String?              @db.VarChar(10)
  itemQuantity    Decimal?             @map("item_quantity") @db.Decimal(20, 4)
  rate            Decimal?             @db.Decimal(20, 4)
  itemAmountMinor BigInt?              @map("item_amount_minor")
  measurementId   String?              @map("measurement_id") @db.Uuid
  measuredOn      DateTime?            @map("measured_on") @db.Date
  quantityToDate  Decimal?             @map("quantity_to_date") @db.Decimal(20, 4)
  percentComplete String?              @map("percent_complete") @db.VarChar(20)
  overMeasured    Boolean              @default(false) @map("over_measured")
  previousMinor   BigInt               @default(0) @map("previous_minor")
  amountMinor     BigInt               @map("amount_minor")
  source          String?              @db.VarChar(10)
  storeId         String?              @map("store_id") @db.Uuid
  materialId      String?              @map("material_id") @db.Uuid
  quantity        Decimal?             @db.Decimal(24, 6)
  reference       String?              @db.VarChar(60)
  adjustmentKind  String?              @map("adjustment_kind") @db.VarChar(20)
  valuation       Valuation            @relation(fields: [tenantId, valuationId], references: [tenantId, id], onDelete: Restrict)
  item            BqItem?              @relation(fields: [tenantId, bqVersionId, bqItemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  measurement     ProgressMeasurement? @relation(fields: [tenantId, measurementId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, valuationId, revision, lineNo])
  @@index([tenantId, measurementId])
  @@map("valuation_lines")
}

// D6.3: materials on site entered against a BQ item while a valuation is a draft.
model ValuationMaterial {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  valuationId     String    @map("valuation_id") @db.Uuid
  bqVersionId     String    @map("bq_version_id") @db.Uuid
  bqItemLineageId String    @map("bq_item_lineage_id") @db.Uuid
  description     String    @db.VarChar(200)
  unit            String?   @db.VarChar(20)
  quantity        Decimal   @db.Decimal(20, 4)
  amountMinor     BigInt    @map("amount_minor")
  reference       String?   @db.VarChar(60)
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  valuation       Valuation @relation(fields: [tenantId, projectId, valuationId], references: [tenantId, projectId, id], onDelete: Restrict)
  item            BqItem    @relation(fields: [tenantId, bqVersionId, bqItemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, valuationId])
  @@map("valuation_materials")
}

// D6.3: agreed adjustments (advance, recovery, contra charge, other) entered on a draft.
model ValuationAdjustment {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  valuationId String    @map("valuation_id") @db.Uuid
  kind        String    @db.VarChar(20)
  description String    @db.VarChar(200)
  amountMinor BigInt    @map("amount_minor")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  valuation   Valuation @relation(fields: [tenantId, projectId, valuationId], references: [tenantId, projectId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, valuationId])
  @@map("valuation_adjustments")
}

// Maps a material line of an (immutable) build-up version to a catalogue material and the
// catalogue unit its quantity is in, with the exact base units per that unit. Replacing a mapping
// stamps the old one unmapped (one active mapping per line); never deleted.
model BuildupLineMaterial {
  id               String             @id @default(uuid(7)) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  buildupId        String             @map("buildup_id") @db.Uuid
  buildupVersionId String             @map("buildup_version_id") @db.Uuid
  lineId           String             @map("line_id") @db.Uuid
  materialId       String             @map("material_id") @db.Uuid
  unit             String             @db.VarChar(20)
  baseUnit         String             @map("base_unit") @db.VarChar(20)
  basePerUnit      String             @map("base_per_unit") @db.VarChar(120)
  conversion       Json
  mappedBy         String             @map("mapped_by") @db.Uuid
  mappedAt         DateTime           @default(now()) @map("mapped_at") @db.Timestamptz
  unmappedBy       String?            @map("unmapped_by") @db.Uuid
  unmappedAt       DateTime?          @map("unmapped_at") @db.Timestamptz
  version          RateBuildupVersion @relation(fields: [tenantId, buildupId, buildupVersionId], references: [tenantId, buildupId, id], onDelete: Restrict)
  line             RateBuildupLine    @relation(fields: [tenantId, buildupVersionId, lineId], references: [tenantId, versionId, id], onDelete: Restrict)
  material         Material           @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, lineId])
  @@index([tenantId, materialId])
  @@map("rate_buildup_line_materials")
}

// ---------------------------------------------------------------------------------------------
// D6.2 Schedule (ARCHITECTURE §4.6, migration 20261119090000_schedule). Planned dates are computed
// (packages/domain computeSchedule), never stored on activities; baselines freeze them.
// ---------------------------------------------------------------------------------------------

// A project's working calendar. No row means the defaults (Monday–Saturday, public holidays off).
model ScheduleSettings {
  tenantId              String   @map("tenant_id") @db.Uuid
  projectId             String   @map("project_id") @db.Uuid
  workingWeekdays       Int[]    @map("working_weekdays")
  includePublicHolidays Boolean  @default(true) @map("include_public_holidays")
  version               Int      @default(1)
  updatedBy             String   @map("updated_by") @db.Uuid
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project               Project  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, projectId])
  @@map("schedule_settings")
}

// A schedule item: a task (duration, links, actuals, progress with a basis) or a milestone's link
// into the network (kind = milestone: zero duration; name and dates stay on the milestone).
model ScheduleActivity {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  projectId          String                  @map("project_id") @db.Uuid
  kind               String                  @db.VarChar(10)
  milestoneId        String?                 @map("milestone_id") @db.Uuid
  wbsNodeId          String?                 @map("wbs_node_id") @db.Uuid
  bqVersionId        String?                 @map("bq_version_id") @db.Uuid
  bqItemLineageId    String?                 @map("bq_item_lineage_id") @db.Uuid
  code               String?                 @db.VarChar(20)
  name               String?                 @db.VarChar(150)
  durationDays       Int                     @map("duration_days")
  startNoEarlierThan DateTime?               @map("start_no_earlier_than") @db.Date
  actualStart        DateTime?               @map("actual_start") @db.Date
  actualFinish       DateTime?               @map("actual_finish") @db.Date
  progressBasis      String?                 @map("progress_basis") @db.VarChar(10)
  percentComplete    Decimal?                @map("percent_complete") @db.Decimal(5, 2)
  quantityDone       Decimal?                @map("quantity_done") @db.Decimal(20, 4)
  quantityTotal      Decimal?                @map("quantity_total") @db.Decimal(20, 4)
  quantityUnit       String?                 @map("quantity_unit") @db.VarChar(20)
  version            Int                     @default(1)
  createdBy          String                  @map("created_by") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedBy          String                  @map("updated_by") @db.Uuid
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project            Project                 @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  milestone          Milestone?              @relation(fields: [tenantId, projectId, milestoneId], references: [tenantId, projectId, id], onDelete: Cascade)
  wbsNode            WbsNode?                @relation(fields: [tenantId, projectId, wbsNodeId], references: [tenantId, projectId, id], onDelete: NoAction)
  bqItem             BqItem?                 @relation(fields: [tenantId, bqVersionId, bqItemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  predecessors       ScheduleDependency[]    @relation("DependencySuccessor")
  successors         ScheduleDependency[]    @relation("DependencyPredecessor")
  delayLinks         ScheduleDelayActivity[]
  inspections        Inspection[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, code])
  @@unique([tenantId, projectId, milestoneId])
  @@map("schedule_activities")
}

// predecessor → successor (FS, SS, FF, SF) with a lag in working days. No cycles (trigger).
model ScheduleDependency {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  projectId     String           @map("project_id") @db.Uuid
  predecessorId String           @map("predecessor_id") @db.Uuid
  successorId   String           @map("successor_id") @db.Uuid
  type          String           @db.VarChar(2)
  lagDays       Int              @default(0) @map("lag_days")
  version       Int              @default(1)
  createdBy     String           @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String           @map("updated_by") @db.Uuid
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  predecessor   ScheduleActivity @relation("DependencyPredecessor", fields: [tenantId, projectId, predecessorId], references: [tenantId, projectId, id], onDelete: Cascade)
  successor     ScheduleActivity @relation("DependencySuccessor", fields: [tenantId, projectId, successorId], references: [tenantId, projectId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, predecessorId, successorId])
  @@index([tenantId, projectId, successorId])
  @@map("schedule_dependencies")
}

// A frozen snapshot of the schedule. Append-only (no UPDATE/DELETE, trigger); the newest is current.
model ScheduleBaseline {
  id                    String                 @id @default(uuid(7)) @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  projectId             String                 @map("project_id") @db.Uuid
  baselineNo            Int                    @map("baseline_no")
  name                  String                 @db.VarChar(120)
  reason                String                 @db.VarChar(500)
  dataDate              DateTime               @map("data_date") @db.Date
  startDate             DateTime               @map("start_date") @db.Date
  projectFinish         DateTime?              @map("project_finish") @db.Date
  workingWeekdays       Int[]                  @map("working_weekdays")
  includePublicHolidays Boolean                @map("include_public_holidays")
  itemCount             Int                    @map("item_count")
  createdBy             String                 @map("created_by") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz
  project               Project                @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  items                 ScheduleBaselineItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, baselineNo])
  @@map("schedule_baselines")
}

// One task or milestone as it was planned when the baseline was frozen (append-only).
model ScheduleBaselineItem {
  tenantId       String           @map("tenant_id") @db.Uuid
  baselineId     String           @map("baseline_id") @db.Uuid
  kind           String           @db.VarChar(10)
  // The task's activity ID or the milestone's ID (a snapshot reference, no foreign key).
  refId          String           @map("ref_id") @db.Uuid
  code           String?          @db.VarChar(20)
  name           String           @db.VarChar(150)
  wbsNodeId      String?          @map("wbs_node_id") @db.Uuid
  startDate      DateTime         @map("start_date") @db.Date
  finishDate     DateTime         @map("finish_date") @db.Date
  durationDays   Int              @map("duration_days")
  totalFloatDays Int?             @map("total_float_days")
  critical       Boolean
  baseline       ScheduleBaseline @relation(fields: [tenantId, baselineId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, baselineId, kind, refId])
  @@map("schedule_baseline_items")
}

// One version of a delay record. Append-only: a change or a withdrawal appends the next version
// (supersedes the previous, at most once); `delay_id` is the first version's ID.
model ScheduleDelay {
  id              String                  @id @default(uuid(7)) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  projectId       String                  @map("project_id") @db.Uuid
  delayId         String                  @map("delay_id") @db.Uuid
  delayNo         Int                     @map("delay_no")
  versionNo       Int                     @map("version_no")
  supersedesId    String?                 @map("supersedes_id") @db.Uuid
  status          String                  @db.VarChar(10)
  cause           String                  @db.VarChar(30)
  startDate       DateTime                @map("start_date") @db.Date
  endDate         DateTime?               @map("end_date") @db.Date
  workingDaysLost Decimal                 @map("working_days_lost") @db.Decimal(5, 1)
  description     String                  @db.VarChar(2000)
  siteDiaryId     String?                 @map("site_diary_id") @db.Uuid
  claimFlag       String                  @map("claim_flag") @db.VarChar(20)
  changeReason    String?                 @map("change_reason") @db.VarChar(500)
  recordedBy      String                  @map("recorded_by") @db.Uuid
  recordedAt      DateTime                @default(now()) @map("recorded_at") @db.Timestamptz
  project         Project                 @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  root            ScheduleDelay           @relation("DelayRoot", fields: [tenantId, projectId, delayId], references: [tenantId, projectId, id], onDelete: NoAction)
  versions        ScheduleDelay[]         @relation("DelayRoot")
  supersedes      ScheduleDelay?          @relation("DelaySupersedes", fields: [tenantId, projectId, supersedesId], references: [tenantId, projectId, id], onDelete: NoAction)
  supersededBy    ScheduleDelay?          @relation("DelaySupersedes")
  siteDiary       SiteDiary?              @relation(fields: [tenantId, projectId, siteDiaryId], references: [tenantId, projectId, id], onDelete: Restrict)
  activities      ScheduleDelayActivity[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, supersedesId])
  @@unique([tenantId, delayId, versionNo])
  @@index([tenantId, projectId, delayNo])
  @@map("schedule_delays")
}

// The activities a delay version affects (append-only, written with the version).
model ScheduleDelayActivity {
  tenantId       String           @map("tenant_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  delayVersionId String           @map("delay_version_id") @db.Uuid
  activityId     String           @map("activity_id") @db.Uuid
  delayVersion   ScheduleDelay    @relation(fields: [tenantId, projectId, delayVersionId], references: [tenantId, projectId, id], onDelete: Cascade)
  activity       ScheduleActivity @relation(fields: [tenantId, projectId, activityId], references: [tenantId, projectId, id], onDelete: Restrict)

  @@id([tenantId, delayVersionId, activityId])
  @@index([tenantId, projectId, activityId])
  @@map("schedule_delay_activities")
}

// D5.4 spending and cash flow (ARCHITECTURE §4.8, ERD §8). Company settings: budget alert
// threshold, unusual-spend rule, duplicate window, forecast horizon and the entered opening cash.
model SpendingSettings {
  tenantId               String    @id @map("tenant_id") @db.Uuid
  budgetAlertPercent     Int       @map("budget_alert_percent")
  unusualSpendMultiplier Decimal   @map("unusual_spend_multiplier") @db.Decimal(7, 2)
  unusualSpendMinSamples Int       @map("unusual_spend_min_samples")
  duplicateWindowDays    Int       @map("duplicate_window_days")
  forecastWeeks          Int       @map("forecast_weeks")
  openingCashMinor       BigInt?   @map("opening_cash_minor")
  openingCashOn          DateTime? @map("opening_cash_on") @db.Date
  version                Int       @default(1)
  updatedBy              String    @map("updated_by") @db.Uuid
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("spending_settings")
}

// A company cost code (configurable): a code, a name and the category it belongs to. Codes in use
// are deactivated, never deleted.
model CostCode {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  code              String             @db.VarChar(20)
  name              String             @db.VarChar(120)
  category          String             @db.VarChar(20)
  active            Boolean            @default(true)
  version           Int                @default(1)
  createdBy         String             @map("created_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedBy         String             @map("updated_by") @db.Uuid
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgetLines       BudgetLine[]
  costEntries       CostEntry[]
  journalLines      CostJournalLine[]
  pettyCashExpenses PettyCashExpense[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, active, code])
  @@map("cost_codes")
}

// A versioned project budget: draft → submitted → approved by someone who did not prepare it. The
// newest approved version is the budget in force; approved versions never change.
model Budget {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  projectId    String       @map("project_id") @db.Uuid
  versionNo    Int          @map("version_no")
  name         String       @db.VarChar(120)
  notes        String?      @db.VarChar(1000)
  status       String       @default("draft") @db.VarChar(12)
  bqVersionId  String?      @map("bq_version_id") @db.Uuid
  totalMinor   BigInt       @default(0) @map("total_minor")
  lineCount    Int          @default(0) @map("line_count")
  digest       String?      @db.Char(64)
  contributors String[]     @default([]) @db.Uuid
  version      Int          @default(1)
  createdBy    String       @map("created_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedBy    String       @map("updated_by") @db.Uuid
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz
  submittedBy  String?      @map("submitted_by") @db.Uuid
  submittedAt  DateTime?    @map("submitted_at") @db.Timestamptz
  approvedBy   String?      @map("approved_by") @db.Uuid
  approvedAt   DateTime?    @map("approved_at") @db.Timestamptz
  returnReason String?      @map("return_reason") @db.VarChar(500)
  cancelledBy  String?      @map("cancelled_by") @db.Uuid
  cancelledAt  DateTime?    @map("cancelled_at") @db.Timestamptz
  cancelReason String?      @map("cancel_reason") @db.VarChar(500)
  project      Project      @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  bqVersion    BqVersion?   @relation(fields: [tenantId, bqVersionId], references: [tenantId, id], onDelete: Restrict)
  lines        BudgetLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, versionNo])
  @@index([tenantId, projectId, status])
  @@map("budgets")
}

// A budget line: one BQ item (by lineage, in the budget's BQ version) or one cost code, with an
// amount in KES minor units. Lines change only while the budget is a draft.
model BudgetLine {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  budgetId        String    @map("budget_id") @db.Uuid
  lineNo          Int       @map("line_no")
  bqVersionId     String?   @map("bq_version_id") @db.Uuid
  bqItemLineageId String?   @map("bq_item_lineage_id") @db.Uuid
  costCodeId      String?   @map("cost_code_id") @db.Uuid
  category        String?   @db.VarChar(20)
  description     String    @db.VarChar(300)
  amountMinor     BigInt    @map("amount_minor")
  budget          Budget    @relation(fields: [tenantId, budgetId], references: [tenantId, id], onDelete: Restrict)
  bqItem          BqItem?   @relation(fields: [tenantId, bqVersionId, bqItemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  costCode        CostCode? @relation(fields: [tenantId, costCodeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, budgetId, lineNo])
  @@unique([tenantId, budgetId, bqItemLineageId])
  @@unique([tenantId, budgetId, costCodeId])
  @@map("budget_lines")
}

// A manual cost journal (adjustment lines, or the reversal of one entry), proposed by one person
// and approved or rejected by another; approval posts its lines to the cost ledger.
model CostJournal {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  projectId      String            @map("project_id") @db.Uuid
  number         String            @db.VarChar(20)
  kind           String            @db.VarChar(12)
  reason         String            @db.VarChar(500)
  status         String            @default("submitted") @db.VarChar(12)
  lineCount      Int               @map("line_count")
  version        Int               @default(1)
  createdBy      String            @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  decidedBy      String?           @map("decided_by") @db.Uuid
  decidedAt      DateTime?         @map("decided_at") @db.Timestamptz
  decisionReason String?           @map("decision_reason") @db.VarChar(500)
  project        Project           @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  lines          CostJournalLine[]
  entries        CostEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, number])
  @@index([tenantId, projectId, status])
  @@map("cost_journals")
}

// A journal line: what will be posted (measure, tags, amount), or the reversal of one entry.
model CostJournalLine {
  id               String      @id @default(uuid(7)) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  projectId        String      @map("project_id") @db.Uuid
  journalId        String      @map("journal_id") @db.Uuid
  lineNo           Int         @map("line_no")
  measure          String      @db.VarChar(8)
  category         String      @db.VarChar(20)
  costCodeId       String?     @map("cost_code_id") @db.Uuid
  bqVersionId      String?     @map("bq_version_id") @db.Uuid
  bqItemLineageId  String?     @map("bq_item_lineage_id") @db.Uuid
  siteId           String?     @map("site_id") @db.Uuid
  counterpartyKind String      @map("counterparty_kind") @db.VarChar(10)
  supplierId       String?     @map("supplier_id") @db.Uuid
  counterpartyName String?     @map("counterparty_name") @db.VarChar(200)
  paymentReference String?     @map("payment_reference") @db.VarChar(60)
  occurredOn       DateTime    @map("occurred_on") @db.Date
  amountMinor      BigInt      @map("amount_minor")
  reversesEntryId  String?     @map("reverses_entry_id") @db.Uuid
  journal          CostJournal @relation(fields: [tenantId, projectId, journalId], references: [tenantId, projectId, id], onDelete: Restrict)
  costCode         CostCode?   @relation(fields: [tenantId, costCodeId], references: [tenantId, id], onDelete: Restrict)
  bqItem           BqItem?     @relation(fields: [tenantId, bqVersionId, bqItemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  site             Site?       @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: Restrict)
  supplier         Supplier?   @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  reverses         CostEntry?  @relation("JournalReversal", fields: [tenantId, reversesEntryId], references: [tenantId, id], onDelete: Restrict)
  entries          CostEntry[] @relation("JournalLineEntries")

  @@unique([tenantId, id])
  @@unique([tenantId, journalId, id])
  @@unique([tenantId, journalId, lineNo])
  @@map("cost_journal_lines")
}

// The append-only cost ledger: every shilling tagged with project, site, BQ item or cost code,
// category, counterparty and payment reference, in one of two measures (accrued, paid). Exactly
// one source per entry, posted once per purpose; a correction is a reversing entry (journal).
model CostEntry {
  id               String             @id @default(uuid(7)) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  projectId        String             @map("project_id") @db.Uuid
  siteId           String?            @map("site_id") @db.Uuid
  measure          String             @db.VarChar(8)
  category         String             @db.VarChar(20)
  costCodeId       String?            @map("cost_code_id") @db.Uuid
  bqVersionId      String?            @map("bq_version_id") @db.Uuid
  bqItemLineageId  String?            @map("bq_item_lineage_id") @db.Uuid
  counterpartyKind String             @map("counterparty_kind") @db.VarChar(10)
  supplierId       String?            @map("supplier_id") @db.Uuid
  counterpartyName String?            @map("counterparty_name") @db.VarChar(200)
  paymentReference String?            @map("payment_reference") @db.VarChar(60)
  amountMinor      BigInt             @map("amount_minor")
  occurredOn       DateTime           @map("occurred_on") @db.Date
  source           String             @db.VarChar(20)
  purpose          String             @db.VarChar(20)
  invoiceId        String?            @map("invoice_id") @db.Uuid
  settlementId     String?            @map("settlement_id") @db.Uuid
  expenseId        String?            @map("expense_id") @db.Uuid
  floatCountId     String?            @map("float_count_id") @db.Uuid
  journalId        String?            @map("journal_id") @db.Uuid
  journalLineId    String?            @map("journal_line_id") @db.Uuid
  reversesEntryId  String?            @map("reverses_entry_id") @db.Uuid
  recordedBy       String             @map("recorded_by") @db.Uuid
  recordedAt       DateTime           @default(now()) @map("recorded_at") @db.Timestamptz
  businessDate     DateTime           @map("business_date") @db.Date
  project          Project            @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  site             Site?              @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: Restrict)
  costCode         CostCode?          @relation(fields: [tenantId, costCodeId], references: [tenantId, id], onDelete: Restrict)
  bqItem           BqItem?            @relation(fields: [tenantId, bqVersionId, bqItemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  supplier         Supplier?          @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  invoice          SupplierInvoice?   @relation(fields: [tenantId, projectId, invoiceId], references: [tenantId, projectId, id], onDelete: Restrict)
  settlement       InvoiceSettlement? @relation(fields: [tenantId, invoiceId, settlementId], references: [tenantId, invoiceId, id], onDelete: Restrict)
  expense          PettyCashExpense?  @relation(fields: [tenantId, projectId, expenseId], references: [tenantId, projectId, id], onDelete: Restrict)
  floatCount       PettyCashCount?    @relation(fields: [tenantId, projectId, floatCountId], references: [tenantId, projectId, id], onDelete: Restrict)
  journal          CostJournal?       @relation(fields: [tenantId, projectId, journalId], references: [tenantId, projectId, id], onDelete: Restrict)
  journalLine      CostJournalLine?   @relation("JournalLineEntries", fields: [tenantId, journalId, journalLineId], references: [tenantId, journalId, id], onDelete: Restrict)
  reverses         CostEntry?         @relation("CostReversal", fields: [tenantId, reversesEntryId], references: [tenantId, id], onDelete: Restrict)
  reversedBy       CostEntry?         @relation("CostReversal")
  reversalLines    CostJournalLine[]  @relation("JournalReversal")

  @@unique([tenantId, id])
  @@unique([tenantId, reversesEntryId])
  @@index([tenantId, projectId, recordedAt])
  @@index([tenantId, projectId, bqItemLineageId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, expenseId])
  @@index([tenantId, costCodeId])
  @@map("cost_entries")
}

// A site's petty-cash float: a custodian, a limit and a book balance that only its own
// append-only ledger moves (never below zero).
model PettyCashFloat {
  id              String             @id @default(uuid(7)) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  projectId       String             @map("project_id") @db.Uuid
  siteId          String             @map("site_id") @db.Uuid
  name            String             @db.VarChar(120)
  custodianUserId String             @map("custodian_user_id") @db.Uuid
  limitMinor      BigInt             @map("limit_minor")
  balanceMinor    BigInt             @default(0) @map("balance_minor")
  lastSeq         BigInt             @default(0) @map("last_seq")
  lastEntryAt     DateTime?          @map("last_entry_at") @db.Timestamptz
  status          String             @default("active") @db.VarChar(10)
  version         Int                @default(1)
  createdBy       String             @map("created_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedBy       String             @map("updated_by") @db.Uuid
  updatedAt       DateTime           @default(now()) @map("updated_at") @db.Timestamptz
  site            Site               @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: Restrict)
  entries         PettyCashEntry[]
  topUps          PettyCashTopUp[]
  expenses        PettyCashExpense[]
  counts          PettyCashCount[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, siteId])
  @@index([tenantId, projectId])
  @@map("petty_cash_floats")
}

// The float's own append-only ledger: top-ups in, expenses out (back in if rejected) and approved
// count variances, numbered per float with the running balance.
model PettyCashEntry {
  id           String            @id @default(uuid(7)) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  floatId      String            @map("float_id") @db.Uuid
  seq          BigInt
  kind         String            @db.VarChar(20)
  amountMinor  BigInt            @map("amount_minor")
  balanceMinor BigInt            @map("balance_minor")
  topUpId      String?           @map("top_up_id") @db.Uuid
  expenseId    String?           @map("expense_id") @db.Uuid
  countId      String?           @map("count_id") @db.Uuid
  recordedBy   String            @map("recorded_by") @db.Uuid
  recordedAt   DateTime          @default(now()) @map("recorded_at") @db.Timestamptz
  businessDate DateTime          @map("business_date") @db.Date
  float        PettyCashFloat    @relation(fields: [tenantId, floatId], references: [tenantId, id], onDelete: Restrict)
  topUp        PettyCashTopUp?   @relation(fields: [tenantId, floatId, topUpId], references: [tenantId, floatId, id], onDelete: Restrict)
  expense      PettyCashExpense? @relation(fields: [tenantId, floatId, expenseId], references: [tenantId, floatId, id], onDelete: Restrict)
  count        PettyCashCount?   @relation(fields: [tenantId, floatId, countId], references: [tenantId, floatId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, floatId, seq])
  @@index([tenantId, floatId, recordedAt])
  @@map("petty_cash_entries")
}

// A top-up: requested → approved (payments.approve) → paid (payments.disburse, someone else).
model PettyCashTopUp {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  floatId        String           @map("float_id") @db.Uuid
  number         String           @db.VarChar(20)
  amountMinor    BigInt           @map("amount_minor")
  reason         String           @db.VarChar(500)
  status         String           @default("requested") @db.VarChar(12)
  requestedBy    String           @map("requested_by") @db.Uuid
  requestedAt    DateTime         @default(now()) @map("requested_at") @db.Timestamptz
  decidedBy      String?          @map("decided_by") @db.Uuid
  decidedAt      DateTime?        @map("decided_at") @db.Timestamptz
  decisionReason String?          @map("decision_reason") @db.VarChar(500)
  paidBy         String?          @map("paid_by") @db.Uuid
  paidAt         DateTime?        @map("paid_at") @db.Timestamptz
  paidOn         DateTime?        @map("paid_on") @db.Date
  method         String?          @db.VarChar(15)
  reference      String?          @db.VarChar(60)
  referenceKey   String?          @map("reference_key") @db.VarChar(60)
  cancelledBy    String?          @map("cancelled_by") @db.Uuid
  cancelledAt    DateTime?        @map("cancelled_at") @db.Timestamptz
  cancelReason   String?          @map("cancel_reason") @db.VarChar(500)
  version        Int              @default(1)
  float          PettyCashFloat   @relation(fields: [tenantId, projectId, floatId], references: [tenantId, projectId, id], onDelete: Restrict)
  entries        PettyCashEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, floatId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, method, referenceKey])
  @@index([tenantId, floatId, status])
  @@map("petty_cash_top_ups")
}

// A petty-cash expense: offline-ready (client ID, idempotency key and digest), tagged like every
// cost, with an optional M-Pesa code (unique among expenses not rejected) and receipt photos.
model PettyCashExpense {
  id               String             @id @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  projectId        String             @map("project_id") @db.Uuid
  floatId          String             @map("float_id") @db.Uuid
  siteId           String             @map("site_id") @db.Uuid
  number           String             @db.VarChar(20)
  spentOn          DateTime           @map("spent_on") @db.Date
  amountMinor      BigInt             @map("amount_minor")
  chargeMinor      BigInt             @default(0) @map("charge_minor")
  category         String             @db.VarChar(20)
  costCodeId       String?            @map("cost_code_id") @db.Uuid
  bqVersionId      String?            @map("bq_version_id") @db.Uuid
  bqItemLineageId  String?            @map("bq_item_lineage_id") @db.Uuid
  counterpartyKind String             @map("counterparty_kind") @db.VarChar(10)
  supplierId       String?            @map("supplier_id") @db.Uuid
  payeeName        String             @map("payee_name") @db.VarChar(200)
  payeeAccount     String?            @map("payee_account") @db.VarChar(40)
  payeePhoneMasked String?            @map("payee_phone_masked") @db.VarChar(16)
  paymentMethod    String             @map("payment_method") @db.VarChar(10)
  mpesaCode        String?            @map("mpesa_code") @db.Char(10)
  parsedFromSms    Boolean            @default(false) @map("parsed_from_sms")
  smsKind          String?            @map("sms_kind") @db.VarChar(10)
  description      String             @db.VarChar(500)
  status           String             @default("submitted") @db.VarChar(10)
  idempotencyKey   String             @map("idempotency_key") @db.VarChar(100)
  requestDigest    String             @map("request_digest") @db.Char(64)
  capturedAt       DateTime           @map("captured_at") @db.Timestamptz
  source           String             @db.VarChar(10)
  recordedBy       String             @map("recorded_by") @db.Uuid
  recordedAt       DateTime           @default(now()) @map("recorded_at") @db.Timestamptz
  decidedBy        String?            @map("decided_by") @db.Uuid
  decidedAt        DateTime?          @map("decided_at") @db.Timestamptz
  decisionReason   String?            @map("decision_reason") @db.VarChar(500)
  version          Int                @default(1)
  float            PettyCashFloat     @relation(fields: [tenantId, projectId, floatId], references: [tenantId, projectId, id], onDelete: Restrict)
  site             Site               @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: Restrict)
  costCode         CostCode?          @relation(fields: [tenantId, costCodeId], references: [tenantId, id], onDelete: Restrict)
  bqItem           BqItem?            @relation(fields: [tenantId, bqVersionId, bqItemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  supplier         Supplier?          @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  entries          PettyCashEntry[]
  receipts         PettyCashReceipt[]
  costEntries      CostEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, floatId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, floatId, recordedAt])
  @@map("petty_cash_expenses")
}

// A receipt photo of an expense: private object storage, content sniffed, insert-only.
model PettyCashReceipt {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  expenseId   String           @map("expense_id") @db.Uuid
  objectKey   String           @map("object_key") @db.VarChar(300)
  contentType String           @map("content_type") @db.VarChar(40)
  sizeBytes   Int              @map("size_bytes")
  sha256      String           @db.Char(64)
  scanStatus  String           @map("scan_status") @db.VarChar(15)
  scanEngine  String           @map("scan_engine") @db.VarChar(40)
  scannedAt   DateTime         @map("scanned_at") @db.Timestamptz
  uploadedBy  String           @map("uploaded_by") @db.Uuid
  uploadedAt  DateTime         @default(now()) @map("uploaded_at") @db.Timestamptz
  expense     PettyCashExpense @relation(fields: [tenantId, projectId, expenseId], references: [tenantId, projectId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, objectKey])
  @@index([tenantId, expenseId])
  @@map("petty_cash_receipts")
}

// A cash count: counted cash against the book balance at that moment; approved (variance posted)
// or returned by someone who neither counted nor holds the float.
model PettyCashCount {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  floatId        String           @map("float_id") @db.Uuid
  number         String           @db.VarChar(20)
  countedMinor   BigInt           @map("counted_minor")
  bookMinor      BigInt           @map("book_minor")
  bookSeq        BigInt           @map("book_seq")
  varianceMinor  BigInt           @map("variance_minor")
  note           String?          @db.VarChar(500)
  status         String           @default("submitted") @db.VarChar(10)
  countedBy      String           @map("counted_by") @db.Uuid
  countedAt      DateTime         @default(now()) @map("counted_at") @db.Timestamptz
  decidedBy      String?          @map("decided_by") @db.Uuid
  decidedAt      DateTime?        @map("decided_at") @db.Timestamptz
  decisionReason String?          @map("decision_reason") @db.VarChar(500)
  version        Int              @default(1)
  float          PettyCashFloat   @relation(fields: [tenantId, projectId, floatId], references: [tenantId, projectId, id], onDelete: Restrict)
  entries        PettyCashEntry[]
  costEntries    CostEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, floatId, id])
  @@unique([tenantId, number])
  @@map("petty_cash_counts")
}

// A manual cash-flow line: an expected client receipt (until certificates exist, D6.3/D7.1) or
// another expected payment, with what was actually received.
model CashFlowItem {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  direction     String    @db.VarChar(3)
  description   String    @db.VarChar(200)
  expectedOn    DateTime  @map("expected_on") @db.Date
  amountMinor   BigInt    @map("amount_minor")
  status        String    @default("expected") @db.VarChar(10)
  receivedOn    DateTime? @map("received_on") @db.Date
  receivedMinor BigInt?   @map("received_minor")
  reference     String?   @db.VarChar(60)
  version       Int       @default(1)
  createdBy     String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedBy     String    @map("updated_by") @db.Uuid
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  project       Project   @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, projectId, status, expectedOn])
  @@map("cash_flow_items")
}

// ---------------------------------------------------------------------------------------------
// Quality (D6.1; ARCHITECTURE §4.7, WORKFLOWS "Quality"). State machines, maker-checker sign-offs,
// numbering, the concrete rules and immutability live in SQL triggers (migration
// 20261122100000_quality); partial unique indexes are SQL-only.

// Company quality settings; no row means the defaults (DLP 6 months, cube grace 2 days).
model QualitySettings {
  tenantId             String   @id @map("tenant_id") @db.Uuid
  dlpMonths            Int      @default(6) @map("dlp_months")
  cubeOverdueGraceDays Int      @default(2) @map("cube_overdue_grace_days")
  version              Int      @default(1)
  updatedBy            String   @map("updated_by") @db.Uuid
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("quality_settings")
}

// One version of a company checklist template (append-only). `lineage_id` is version 1's ID; a
// revision or retirement appends the next version; inspections keep the version they used.
model ChecklistTemplate {
  id          String                  @id @db.Uuid
  tenantId    String                  @map("tenant_id") @db.Uuid
  lineageId   String                  @map("lineage_id") @db.Uuid
  version     Int
  name        String                  @db.VarChar(120)
  category    String                  @db.VarChar(20)
  description String?                 @db.VarChar(500)
  retired     Boolean                 @default(false)
  itemCount   Int                     @map("item_count")
  createdBy   String                  @map("created_by") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineage     ChecklistTemplate       @relation("TemplateLineage", fields: [tenantId, lineageId], references: [tenantId, id], onDelete: NoAction)
  versions    ChecklistTemplate[]     @relation("TemplateLineage")
  items       ChecklistTemplateItem[]
  inspections Inspection[]

  @@unique([tenantId, id])
  @@unique([tenantId, lineageId, version])
  @@map("checklist_templates")
}

// A template version's checklist item (written with its version, append-only).
model ChecklistTemplateItem {
  id         String            @id @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  templateId String            @map("template_id") @db.Uuid
  position   Int
  text       String            @db.VarChar(300)
  template   ChecklistTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, templateId, position])
  @@map("checklist_template_items")
}

// An inspection of work on a site against a template version: draft → submitted → signed off by
// an independent quality.manage holder (locked), or returned to draft with a reason.
model Inspection {
  id                 String            @id @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  projectId          String            @map("project_id") @db.Uuid
  siteId             String            @map("site_id") @db.Uuid
  number             Int
  templateId         String            @map("template_id") @db.Uuid
  category           String            @db.VarChar(20)
  location           String            @db.VarChar(200)
  inspectorType      String            @map("inspector_type") @db.VarChar(12)
  inspectorName      String?           @map("inspector_name") @db.VarChar(150)
  inspectedOn        DateTime          @map("inspected_on") @db.Date
  wbsNodeId          String?           @map("wbs_node_id") @db.Uuid
  scheduleActivityId String?           @map("schedule_activity_id") @db.Uuid
  bqVersionId        String?           @map("bq_version_id") @db.Uuid
  bqItemLineageId    String?           @map("bq_item_lineage_id") @db.Uuid
  notes              String?           @db.VarChar(2000)
  status             String            @default("draft") @db.VarChar(12)
  result             String?           @db.VarChar(4)
  version            Int               @default(1)
  createdBy          String            @map("created_by") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  submittedBy        String?           @map("submitted_by") @db.Uuid
  submittedAt        DateTime?         @map("submitted_at") @db.Timestamptz
  signedOffBy        String?           @map("signed_off_by") @db.Uuid
  signedOffAt        DateTime?         @map("signed_off_at") @db.Timestamptz
  returnedBy         String?           @map("returned_by") @db.Uuid
  returnedAt         DateTime?         @map("returned_at") @db.Timestamptz
  returnReason       String?           @map("return_reason") @db.VarChar(500)
  updatedBy          String            @map("updated_by") @db.Uuid
  updatedAt          DateTime          @default(now()) @map("updated_at") @db.Timestamptz
  site               Site              @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: Restrict)
  template           ChecklistTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)
  wbsNode            WbsNode?          @relation(fields: [tenantId, projectId, wbsNodeId], references: [tenantId, projectId, id], onDelete: Restrict)
  scheduleActivity   ScheduleActivity? @relation(fields: [tenantId, projectId, scheduleActivityId], references: [tenantId, projectId, id], onDelete: Restrict)
  bqItem             BqItem?           @relation(fields: [tenantId, bqVersionId, bqItemLineageId], references: [tenantId, versionId, lineageId], onDelete: Restrict)
  items              InspectionItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, number])
  @@index([tenantId, projectId, status])
  @@map("inspections")
}

// A checklist item on an inspection (its text is copied from the template version).
model InspectionItem {
  id           String                @id @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  projectId    String                @map("project_id") @db.Uuid
  inspectionId String                @map("inspection_id") @db.Uuid
  position     Int
  text         String                @db.VarChar(300)
  result       String                @default("pending") @db.VarChar(8)
  note         String?               @db.VarChar(1000)
  updatedBy    String                @map("updated_by") @db.Uuid
  updatedAt    DateTime              @default(now()) @map("updated_at") @db.Timestamptz
  inspection   Inspection            @relation(fields: [tenantId, projectId, inspectionId], references: [tenantId, projectId, id], onDelete: Cascade)
  photos       InspectionItemPhoto[]
  snags        Snag[]

  @@unique([tenantId, projectId, id])
  @@unique([tenantId, inspectionId, position])
  @@map("inspection_items")
}

// A site photo attached to a checklist item while its inspection is a draft.
model InspectionItemPhoto {
  tenantId  String         @map("tenant_id") @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  itemId    String         @map("item_id") @db.Uuid
  photoId   String         @map("photo_id") @db.Uuid
  item      InspectionItem @relation(fields: [tenantId, projectId, itemId], references: [tenantId, projectId, id], onDelete: Cascade)
  photo     SitePhoto      @relation(fields: [tenantId, projectId, photoId], references: [tenantId, projectId, id], onDelete: Restrict)

  @@id([tenantId, itemId, photoId])
  @@index([tenantId, projectId, photoId])
  @@map("inspection_item_photos")
}

// A snag or defect: open → fixed → closed (verified by someone other than the fixer) or reopened.
// `phase` is dlp when raised after practical completion was certified.
model Snag {
  id               String          @id @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  projectId        String          @map("project_id") @db.Uuid
  siteId           String          @map("site_id") @db.Uuid
  number           Int
  location         String          @db.VarChar(200)
  description      String          @db.VarChar(2000)
  severity         String          @db.VarChar(10)
  responsibleKind  String          @map("responsible_kind") @db.VarChar(15)
  responsibleName  String          @map("responsible_name") @db.VarChar(150)
  dueOn            DateTime?       @map("due_on") @db.Date
  phase            String          @db.VarChar(12)
  inspectionItemId String?         @map("inspection_item_id") @db.Uuid
  status           String          @default("open") @db.VarChar(8)
  fixNote          String?         @map("fix_note") @db.VarChar(1000)
  reopenCount      Int             @default(0) @map("reopen_count")
  lastReopenReason String?         @map("last_reopen_reason") @db.VarChar(500)
  raisedBy         String          @map("raised_by") @db.Uuid
  raisedAt         DateTime        @default(now()) @map("raised_at") @db.Timestamptz
  fixedBy          String?         @map("fixed_by") @db.Uuid
  fixedAt          DateTime?       @map("fixed_at") @db.Timestamptz
  closedBy         String?         @map("closed_by") @db.Uuid
  closedAt         DateTime?       @map("closed_at") @db.Timestamptz
  version          Int             @default(1)
  updatedBy        String          @map("updated_by") @db.Uuid
  updatedAt        DateTime        @default(now()) @map("updated_at") @db.Timestamptz
  site             Site            @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: Restrict)
  inspectionItem   InspectionItem? @relation(fields: [tenantId, projectId, inspectionItemId], references: [tenantId, projectId, id], onDelete: Restrict)
  photos           SnagPhoto[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, number])
  @@index([tenantId, projectId, status])
  @@map("snags")
}

// A site photo of a snag when raised or when recorded as fixed (append-only).
model SnagPhoto {
  tenantId  String    @map("tenant_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  snagId    String    @map("snag_id") @db.Uuid
  photoId   String    @map("photo_id") @db.Uuid
  stage     String    @db.VarChar(8)
  /// The snag's reopen count when a fix photo was added (0 for photos taken when it was raised).
  fixRound  Int       @default(0) @map("fix_round")
  addedBy   String    @map("added_by") @db.Uuid
  addedAt   DateTime  @default(now()) @map("added_at") @db.Timestamptz
  snag      Snag      @relation(fields: [tenantId, projectId, snagId], references: [tenantId, projectId, id], onDelete: Cascade)
  photo     SitePhoto @relation(fields: [tenantId, projectId, photoId], references: [tenantId, projectId, id], onDelete: Restrict)

  @@id([tenantId, snagId, photoId, stage, fixRound])
  @@index([tenantId, projectId, photoId])
  @@map("snag_photos")
}

// A set of concrete test cubes cast from one pour. Fixed once recorded; it can only be voided
// (entered in error) with a reason.
model CubeSet {
  id                String       @id @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  projectId         String       @map("project_id") @db.Uuid
  siteId            String       @map("site_id") @db.Uuid
  number            Int
  element           String       @db.VarChar(200)
  concreteClass     String       @map("concrete_class") @db.VarChar(4)
  specifiedStrength Int          @map("specified_strength")
  castOn            DateTime     @map("cast_on") @db.Date
  cubesPerAge       Int          @map("cubes_per_age")
  batchReference    String?      @map("batch_reference") @db.VarChar(60)
  notes             String?      @db.VarChar(1000)
  status            String       @default("active") @db.VarChar(6)
  voidReason        String?      @map("void_reason") @db.VarChar(500)
  voidedBy          String?      @map("voided_by") @db.Uuid
  voidedAt          DateTime?    @map("voided_at") @db.Timestamptz
  version           Int          @default(1)
  createdBy         String       @map("created_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  site              Site         @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: Restrict)
  results           CubeResult[]
  slumpTests        SlumpTest[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, number])
  @@index([tenantId, projectId, castOn])
  @@map("cube_sets")
}

// One age's crushing results (append-only). A correction is a new row that supersedes the
// original once, with a reason; the stored mean and outcome are re-checked by the database.
model CubeResult {
  id               String      @id @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  projectId        String      @map("project_id") @db.Uuid
  cubeSetId        String      @map("cube_set_id") @db.Uuid
  ageDays          Int         @map("age_days")
  testedOn         DateTime    @map("tested_on") @db.Date
  strengths        Decimal[]   @db.Decimal(4, 1)
  meanStrength     Decimal     @map("mean_strength") @db.Decimal(5, 2)
  minStrength      Decimal     @map("min_strength") @db.Decimal(4, 1)
  outcome          String      @db.VarChar(16)
  ruleVersion      String      @map("rule_version") @db.VarChar(20)
  laboratory       String?     @db.VarChar(120)
  reportReference  String?     @map("report_reference") @db.VarChar(60)
  supersedesId     String?     @map("supersedes_id") @db.Uuid
  correctionReason String?     @map("correction_reason") @db.VarChar(500)
  recordedBy       String      @map("recorded_by") @db.Uuid
  recordedAt       DateTime    @default(now()) @map("recorded_at") @db.Timestamptz
  cubeSet          CubeSet     @relation(fields: [tenantId, projectId, cubeSetId], references: [tenantId, projectId, id], onDelete: Cascade)
  supersedes       CubeResult? @relation("CubeCorrection", fields: [tenantId, projectId, supersedesId], references: [tenantId, projectId, id], onDelete: NoAction)
  supersededBy     CubeResult? @relation("CubeCorrection")

  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, supersedesId])
  @@index([tenantId, cubeSetId, ageDays])
  @@map("cube_results")
}

// A slump test (append-only; a correction supersedes the original once and keeps its number).
model SlumpTest {
  id               String     @id @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  projectId        String     @map("project_id") @db.Uuid
  siteId           String     @map("site_id") @db.Uuid
  number           Int
  testedOn         DateTime   @map("tested_on") @db.Date
  element          String     @db.VarChar(200)
  concreteClass    String?    @map("concrete_class") @db.VarChar(4)
  cubeSetId        String?    @map("cube_set_id") @db.Uuid
  targetMm         Int        @map("target_mm")
  toleranceMm      Int        @map("tolerance_mm")
  measuredMm       Int        @map("measured_mm")
  outcome          String     @db.VarChar(4)
  ruleVersion      String     @map("rule_version") @db.VarChar(20)
  notes            String?    @db.VarChar(1000)
  supersedesId     String?    @map("supersedes_id") @db.Uuid
  correctionReason String?    @map("correction_reason") @db.VarChar(500)
  recordedBy       String     @map("recorded_by") @db.Uuid
  recordedAt       DateTime   @default(now()) @map("recorded_at") @db.Timestamptz
  site             Site       @relation(fields: [tenantId, projectId, siteId], references: [tenantId, projectId, id], onDelete: Restrict)
  cubeSet          CubeSet?   @relation(fields: [tenantId, projectId, cubeSetId], references: [tenantId, projectId, id], onDelete: Restrict)
  supersedes       SlumpTest? @relation("SlumpCorrection", fields: [tenantId, projectId, supersedesId], references: [tenantId, projectId, id], onDelete: NoAction)
  supersededBy     SlumpTest? @relation("SlumpCorrection")

  @@unique([tenantId, projectId, id])
  @@unique([tenantId, projectId, supersedesId])
  @@index([tenantId, projectId, number])
  @@map("slump_tests")
}

// Practical or final completion: proposed → certified by an independent quality.manage holder
// (locked) or withdrawn with a reason. One live (not withdrawn) certificate per project and kind.
model ProjectCompletion {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  kind              String    @db.VarChar(10)
  status            String    @default("proposed") @db.VarChar(10)
  completionDate    DateTime  @map("completion_date") @db.Date
  dlpMonths         Int?      @map("dlp_months")
  dlpEndsOn         DateTime? @map("dlp_ends_on") @db.Date
  openCriticalSnags Int       @map("open_critical_snags")
  openSnags         Int       @map("open_snags")
  exceptionReason   String?   @map("exception_reason") @db.VarChar(500)
  notes             String?   @db.VarChar(1000)
  version           Int       @default(1)
  proposedBy        String    @map("proposed_by") @db.Uuid
  proposedAt        DateTime  @default(now()) @map("proposed_at") @db.Timestamptz
  certifiedBy       String?   @map("certified_by") @db.Uuid
  certifiedAt       DateTime? @map("certified_at") @db.Timestamptz
  withdrawnBy       String?   @map("withdrawn_by") @db.Uuid
  withdrawnAt       DateTime? @map("withdrawn_at") @db.Timestamptz
  withdrawReason    String?   @map("withdraw_reason") @db.VarChar(500)
  project           Project   @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, projectId, kind])
  @@map("project_completions")
}
