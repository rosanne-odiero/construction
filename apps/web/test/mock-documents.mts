/** A field of a multipart body (text parts only). */
const field = (raw: string, name: string) =>
  new RegExp(`name="${name}"\\r\\n\\r\\n([^\\r]*)\\r\\n`).exec(raw)?.[1];

/** The uploaded file of a multipart body: its name and bytes. */
function filePart(raw: Buffer): { name: string; content: Buffer } | null {
  const text = raw.toString("latin1");
  const header = /name="file"; filename="([^"]*)"\r\n(?:[^\r\n]+\r\n)*\r\n/.exec(text);
  if (!header) return null;
  const start = header.index + header[0].length;
  const boundary = text.slice(0, text.indexOf("\r\n"));
  const end = text.indexOf(`\r\n${boundary}`, start);
  return {
    name: header[1]!,
    content: raw.subarray(start, end === -1 ? raw.length : end),
  };
}

/** Content-only type detection, as the API does it (a subset: PDF, PNG, JPEG). */
function detect(content: Buffer): DocumentContentType | null {
  if (content.subarray(0, 5).toString("latin1") === "%PDF-") return "application/pdf";
  if (content.subarray(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])))
    return "image/png";
  if (content[0] === 0xff && content[1] === 0xd8 && content[2] === 0xff) return "image/jpeg";
  return null;
}

export function handleDocuments(
  deps: DocumentsDeps,
  state: DocumentsState,
  method: string,
  path: string,
  query: URLSearchParams,
  body: unknown,
  raw: Buffer,
): Reply | null {
  const { fail, parse, actor } = deps;
  const today = nairobiDate();
  const now = new Date().toISOString();
  const project = (id: string) => deps.projects.find((entry) => entry.id === id) ?? null;
  const perms = (id: string) => project(id)?.permissions ?? [];
  const writable = (id: string) => !["closed", "cancelled"].includes(project(id)?.status ?? "");
  const canRead = (id: string) =>
    perms(id).includes("projects.view") && has(perms(id), DOCUMENT_READ_PERMISSIONS);
  const confidential = (id: string) =>
    canRead(id) && has(perms(id), DOCUMENT_CONFIDENTIAL_PERMISSIONS);
  const manage = (id: string) => canRead(id) && perms(id).includes("documents.manage");
  const recordInstruction = (id: string) =>
    canRead(id) && has(perms(id), INSTRUCTION_RECORD_PERMISSIONS);
  const manageInstruction = (id: string) =>
    canRead(id) && has(perms(id), INSTRUCTION_MANAGE_PERMISSIONS);
  const configure = deps.companyPermissions.includes("config.manage");
  const readable = deps.projects.filter((entry) => canRead(entry.id));

  const versionsOf = (documentId: string) =>
    state.versions
      .filter((version) => version.documentId === documentId)
      .sort((a, b) => b.versionNo - a.versionNo);
  const currentOf = (documentId: string) =>
    state.versions.find((version) => version.documentId === documentId && !version.supersededAt)!;
  const visible = (doc: Doc) =>
    !isConfidentialCategory(doc.category) || confidential(doc.projectId);
  const latestApproval = (versionId: string) => {
    const found = state.approvals
      .filter((approval) => approval.versionId === versionId)
      .sort((a, b) => b.number - a.number)[0];
    return found ? { id: found.id, code: code(found.number), status: approvalState(found) } : null;
  };
  const code = (number: number) => `APR-${String(number).padStart(4, "0")}`;
  const approvalState = (approval: Approval) =>
    approval.response?.decision ?? (approval.cancellation ? "cancelled" : "pending");
  const summary = (doc: Doc) => {
    const current = currentOf(doc.id);
    return {
      id: doc.id,
      projectId: doc.projectId,
      category: doc.category,
      title: doc.title,
      drawingNumber: doc.drawingNumber,
      discipline: doc.discipline,
      reference: doc.reference,
      status: doc.status,
      confidential: isConfidentialCategory(doc.category),
      current: {
        id: current.id,
        versionNo: current.versionNo,
        revision: current.revision,
        issuePurpose: current.issuePurpose,
        fileName: current.fileName,
        contentType: current.contentType,
        sizeBytes: current.content.length,
        uploadedBy: current.uploadedBy,
        uploadedAt: current.uploadedAt,
        state: "current" as const,
        approval: latestApproval(current.id),
      },
      versionCount: versionsOf(doc.id).length,
      updatedAt: doc.updatedAt,
      version: doc.version,
    };
  };
  const detail = (doc: Doc) => {
    const ok = manage(doc.projectId) && writable(doc.projectId) && doc.status === "active";
    return {
      document: {
        ...summary(doc),
        versions: versionsOf(doc.id).map((version) => ({
          id: version.id,
          versionNo: version.versionNo,
          revision: version.revision,
          issuePurpose: version.issuePurpose,
          changeNote: version.changeNote,
          fileName: version.fileName,
          contentType: version.contentType,
          sizeBytes: version.content.length,
          sha256: version.sha256,
          scanStatus: "clean" as const,
          uploadedBy: version.uploadedBy,
          uploadedAt: version.uploadedAt,
          state: version.supersededAt ? ("superseded" as const) : ("current" as const),
          supersededAt: version.supersededAt,
          supersededBy: version.supersededById
            ? {
                id: version.supersededById,
                revision: state.versions.find((entry) => entry.id === version.supersededById)!
                  .revision,
              }
            : null,
          approval: latestApproval(version.id),
        })),
        createdBy: doc.createdBy,
        createdAt: doc.createdAt,
        withdrawal: doc.withdrawal,
        nextRevision: suggestNextRevision(currentOf(doc.id).revision),
        permissions: {
          canUpload: ok,
          canEdit: ok,
          canWithdraw: ok,
          canRaiseApproval: ok,
        },
      },
    };
  };
  const linked = (versionId: string, viewerProject: string | null) => {
    const version = state.versions.find((entry) => entry.id === versionId);
    const doc = version ? state.documents.find((entry) => entry.id === version.documentId) : null;
    if (!version || !doc) return null;
    const seen = viewerProject === null ? canRead(doc.projectId) && visible(doc) : visible(doc);
    return { version, doc, seen };
  };
  const evidenceOf = (versionId: string | null, viewerProject: string | null) => {
    if (!versionId) return null;
    const found = linked(versionId, viewerProject);
    if (!found) return null;
    if (!found.seen) return { restricted: true as const };
    return {
      restricted: false as const,
      documentId: found.doc.id,
      versionId: found.version.id,
      projectId: found.doc.projectId,
      title: found.doc.title,
      revision: found.version.revision,
      state: found.version.supersededAt ? ("superseded" as const) : ("current" as const),
      documentStatus: found.doc.status,
    };
  };

  // Compliance --------------------------------------------------------------------------------
  const recordWire = (row: ComplianceRecordRow, viewerProject: string | null) => ({
    id: row.id,
    kind: row.kind,
    referenceNo: row.referenceNo,
    issuer: row.issuer,
    issuedOn: row.issuedOn,
    expiresOn: row.expiresOn,
    notes: row.notes,
    reason: row.reason,
    evidence: evidenceOf(row.evidenceVersionId, viewerProject),
    recordedBy: row.recordedBy,
    recordedAt: row.recordedAt,
    state: row.current ? ("current" as const) : ("superseded" as const),
  });
  const itemOf = (type: ComplianceType, projectId: string | null): ComplianceItem => {
    const scopeProject = type.scope === "company" ? null : projectId;
    const rows = state.records.filter(
      (row) => row.typeId === type.id && row.projectId === scopeProject,
    );
    const current = rows.find((row) => row.current) ?? null;
    const derived = complianceStatus(current, type, today);
    return {
      type,
      status: derived.status,
      daysLeft: derived.daysLeft,
      remindFrom: derived.remindFrom,
      current: current ? recordWire(current, projectId) : null,
      historyCount: rows.length,
      canRecord:
        type.active &&
        (type.scope === "company"
          ? configure
          : projectId !== null && manage(projectId) && writable(projectId)),
    };
  };
  const reminderOf = (item: ComplianceItem, entry: Project | null): DocumentReminder | null => {
    const kind = reminderKindOf(item.status);
    if (!kind) return null;
    return {
      kind,
      project:
        entry && item.type.scope === "project"
          ? { id: entry.id, code: entry.code, name: entry.name }
          : null,
      type: { id: item.type.id, key: item.type.key, label: item.type.label },
      approval: null,
      expiresOn: item.current?.expiresOn ?? null,
      dueOn: null,
      daysLeft: item.daysLeft,
    };
  };
  const approvalReminders = (projectId: string): DocumentReminder[] => {
    const entry = project(projectId)!;
    return state.approvals
      .filter(
        (approval) =>
          approval.projectId === projectId &&
          approvalOverdue(approvalState(approval), approval.dueOn, today),
      )
      .map((approval) => ({
        kind: "approval_overdue" as const,
        project: { id: entry.id, code: entry.code, name: entry.name },
        type: null,
        approval: { id: approval.id, code: code(approval.number), title: approval.title },
        expiresOn: null,
        dueOn: approval.dueOn,
        daysLeft: -approvalDaysOverdue(approvalState(approval), approval.dueOn, today),
      }));
  };
  const sortReminders = (list: DocumentReminder[]) =>
    list.sort((a, b) =>
      compareReminders(
        { kind: a.kind, daysLeft: a.daysLeft, label: a.type?.key ?? a.approval?.code ?? "" },
        { kind: b.kind, daysLeft: b.daysLeft, label: b.type?.key ?? b.approval?.code ?? "" },
      ),
    );
  const activeTypes = () =>
    state.types.filter((type) => type.active).sort((a, b) => a.sortOrder - b.sortOrder);
  const projectSummary = (projectId: string) => {
    const items = activeTypes().map((type) => itemOf(type, projectId));
    const entry = project(projectId)!;
    const docs = state.documents.filter(
      (doc) => doc.projectId === projectId && doc.status === "active" && visible(doc),
    );
    const instructions = state.instructions.filter((entry) => entry.projectId === projectId);
    const approvals = state.approvals.filter((approval) => approval.projectId === projectId);
    return {
      documents: {
        active: docs.length,
        drawings: docs.filter((doc) => doc.category === "drawing").length,
      },
      compliance: complianceCounts(items.map((item) => item.status)),
      reminders: sortReminders([
        ...items.flatMap((item) => reminderOf(item, entry) ?? []),
        ...approvalReminders(projectId),
      ]),
      instructions: {
        open: instructions.filter((entry) => entry.status !== "closed").length,
        costOrTime: instructions.filter(
          (entry) => entry.status !== "closed" && (entry.costImplication || entry.timeImplication),
        ).length,
      },
      approvals: {
        pending: approvals.filter((approval) => approvalState(approval) === "pending").length,
        overdue: approvals.filter((approval) =>
          approvalOverdue(approvalState(approval), approval.dueOn, today),
        ).length,
      },
    };
  };
  const recordCompliance = (projectId: string | null) => {
    const input = parse(recordComplianceRequestSchema, body);
    const type = state.types.find((entry) => entry.id === input.typeId);
    if (!type) throw fail(404, "not-found");
    if (projectId === null ? type.scope !== "company" : type.scope !== "project")
      throw fail(409, "invalid-transition");
    if (!type.active) throw fail(409, "compliance-type-retired");
    if (input.kind === "record") {
      const problem = complianceDatesProblem(
        {
          issuedOn: input.issuedOn ?? null,
          expiresOn: type.expires ? (input.expiresOn ?? null) : null,
          expires: type.expires,
        },
        today,
      );
      if (problem) throw fail(422, problem);
      if (input.evidenceVersionId) {
        const found = linked(input.evidenceVersionId, projectId);
        if (!found || !found.seen || (projectId !== null && found.doc.projectId !== projectId))
          throw fail(422, "evidence-not-found");
      }
    }
    const current = state.records.find(
      (row) => row.typeId === type.id && row.projectId === projectId && row.current,
    );
    if ((current?.id ?? null) !== input.supersedesId) throw fail(409, "compliance-stale");
    if (current) current.current = false;
    state.records.push({
      id: randomUUID(),
      typeId: type.id,
      projectId,
      kind: input.kind,
      referenceNo: input.kind === "record" ? (input.referenceNo ?? null) : null,
      issuer: input.kind === "record" ? (input.issuer ?? null) : null,
      issuedOn: input.kind === "record" ? (input.issuedOn ?? null) : null,
      expiresOn: input.kind === "record" && type.expires ? (input.expiresOn ?? null) : null,
      notes: input.notes ?? null,
      reason: input.kind === "not_applicable" ? (input.reason ?? null) : null,
      evidenceVersionId: input.kind === "record" ? (input.evidenceVersionId ?? null) : null,
      recordedBy: actor,
      recordedAt: now,
      current: true,
    });
    return history(type, projectId, 201);
  };
  const history = (type: ComplianceType, projectId: string | null, status = 200): Reply => ({
    status,
    body: {
      item: itemOf(type, projectId),
      records: state.records
        .filter(
          (row) =>
            row.typeId === type.id &&
            row.projectId === (type.scope === "company" ? null : projectId),
        )
        .sort((a, b) => b.recordedAt.localeCompare(a.recordedAt))
        .map((row) => recordWire(row, projectId)),
    },
    schema: complianceHistoryResponseSchema,
  });

  // Company routes ------------------------------------------------------------------------------
  if (path === "/documents" && method === "GET") {
    if (!readable.length && !configure) throw fail(403, "forbidden");
    const companyItems = activeTypes()
      .filter((type) => type.scope === "company")
      .map((type) => itemOf(type, null));
    const summaries = readable.map((entry) => ({
      id: entry.id,
      code: entry.code,
      name: entry.name,
      status: entry.status,
      summary: projectSummary(entry.id),
    }));
    const reminders = sortReminders([
      ...companyItems.flatMap((item) => reminderOf(item, null) ?? []),
      ...summaries.flatMap((entry) =>
        entry.summary.reminders.filter((reminder) => reminder.project !== null),
      ),
    ]);
    return {
      body: {
        today,
        projects: summaries,
        companyItems,
        reminders,
        permissions: { canRecordCompany: configure, canConfigure: configure },
      },
      schema: documentsOverviewResponseSchema,
    };
  }
  if (path === "/documents/compliance-types") {
    if (method === "GET")
      return {
        body: {
          types: [...state.types].sort((a, b) => a.sortOrder - b.sortOrder),
          permissions: { canConfigure: configure },
        },
        schema: complianceTypesResponseSchema,
      };
    if (!configure) throw fail(403, "forbidden");
    const input = parse(createComplianceTypeRequestSchema, body);
    const created: ComplianceType = {
      id: randomUUID(),
      key: `custom_${state.types.filter((type) => !type.starter).length + 1}`,
      label: input.label,
      starter: false,
      complianceReview: false,
      scope: input.scope,
      expires: input.expires,
      reminderDays: input.reminderDays,
      active: true,
      sortOrder: state.types.length + 1,
      version: 1,
    };
    state.types.push(created);
    return { status: 201, body: { type: created }, schema: complianceTypeResponseSchema };
  }
  const typeRoute = /^\/documents\/compliance-types\/([^/]+)$/.exec(path);
  if (typeRoute && method === "PATCH") {
    if (!configure) throw fail(403, "forbidden");
    const type = state.types.find((entry) => entry.id === typeRoute[1]);
    if (!type) throw fail(404, "not-found");
    const input = parse(updateComplianceTypeRequestSchema, body);
    if (input.version !== type.version) throw fail(409, "version-conflict");
    if (type.starter && input.label !== undefined) throw fail(409, "invalid-transition");
    Object.assign(type, {
      ...(input.label !== undefined ? { label: input.label } : {}),
      ...(input.expires !== undefined ? { expires: input.expires } : {}),
      ...(input.reminderDays !== undefined ? { reminderDays: input.reminderDays } : {}),
      ...(input.active !== undefined ? { active: input.active } : {}),
      version: type.version + 1,
    });
    return { body: { type }, schema: complianceTypeResponseSchema };
  }
  if (path === "/documents/compliance" && method === "POST") {
    if (!configure) throw fail(403, "forbidden");
    return recordCompliance(null);
  }
  const companyItem = /^\/documents\/compliance\/([^/]+)$/.exec(path);
  if (companyItem && method === "GET") {
    if (!readable.length && !configure) throw fail(403, "forbidden");
    const type = state.types.find(
      (entry) => entry.id === companyItem[1] && entry.scope === "company",
    );
    if (!type) throw fail(404, "not-found");
    return history(type, null);
  }

  // Project routes ------------------------------------------------------------------------------
  const match =
    /^\/projects\/([^/]+)\/(documents|compliance|instructions|approvals)(?:\/(.*))?$/.exec(path);
  if (!match) return null;
  const [, projectId = "", area, rest = ""] = match;
  if (!project(projectId)) throw fail(404, "not-found");
  if (!canRead(projectId)) throw fail(403, "forbidden");
  const requireWrite = (allowed: boolean) => {
    if (!allowed) throw fail(403, "forbidden");
    if (!writable(projectId)) throw fail(409, "project-read-only");
  };

  if (area === "documents") {
    const docs = state.documents.filter((doc) => doc.projectId === projectId && visible(doc));
    if (rest === "" && method === "GET") {
      const category = query.get("category");
      const discipline = query.get("discipline");
      const status = query.get("status") ?? "active";
      const search = query.get("search")?.toLowerCase();
      const cursor = Number(query.get("cursor") ?? 0);
      const limit = Number(query.get("limit") ?? 30);
      const filtered = docs
        .filter((doc) => !category || doc.category === category)
        .filter((doc) => !discipline || doc.discipline === discipline)
        .filter((doc) => status === "all" || doc.status === status)
        .filter(
          (doc) =>
            !search ||
            [doc.title, doc.drawingNumber, doc.reference].some((value) =>
              value?.toLowerCase().includes(search),
            ),
        )
        .sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
      const counts = Object.fromEntries(
        DOCUMENT_CATEGORIES.map((key) => [
          key,
          docs.filter((doc) => doc.category === key && doc.status === "active").length,
        ]),
      );
      return {
        body: {
          documents: filtered.slice(cursor, cursor + limit).map(summary),
          counts,
          total: filtered.length,
          nextCursor: cursor + limit < filtered.length ? cursor + limit : null,
          permissions: {
            canUpload: manage(projectId) && writable(projectId),
            canSeeConfidential: confidential(projectId),
          },
        },
        schema: documentListResponseSchema,
      };
    }
    if (rest === "drawings" && method === "GET") {
      const discipline = query.get("discipline");
      const search = query.get("search")?.toLowerCase();
      const drawings = docs.filter((doc) => doc.category === "drawing" && doc.status === "active");
      return {
        body: {
          drawings: drawings
            .filter((doc) => !discipline || doc.discipline === discipline)
            .filter(
              (doc) =>
                !search ||
                [doc.title, doc.drawingNumber].some((value) =>
                  value?.toLowerCase().includes(search),
                ),
            )
            .sort((a, b) => (a.drawingNumber ?? "").localeCompare(b.drawingNumber ?? ""))
            .map(summary),
          disciplines: Object.fromEntries(
            DRAWING_DISCIPLINES.map((key) => [
              key,
              drawings.filter((doc) => doc.discipline === key).length,
            ]),
          ),
        },
        schema: drawingRegisterResponseSchema,
      };
    }
    if (rest === "summary" && method === "GET")
      return {
        body: { summary: projectSummary(projectId) },
        schema: projectDocumentsSummaryResponseSchema,
      };
    const upload = () => {
      const text = raw.toString("latin1");
      const file = filePart(raw);
      if (!file || file.content.length === 0) throw fail(400, "file-required");
      const contentType = detect(file.content);
      if (!contentType) throw fail(415, "unsupported-file-type");
      return { text, file, contentType };
    };
    if (rest === "" && method === "POST") {
      requireWrite(manage(projectId));
      const { text, file, contentType } = upload();
      const category = field(text, "category") as DocumentCategory;
      if (isConfidentialCategory(category) && !confidential(projectId))
        throw fail(403, "confidential-category");
      const drawingNumber = field(text, "drawingNumber") || null;
      if (
        drawingNumber &&
        state.documents.some(
          (doc) =>
            doc.projectId === projectId &&
            doc.drawingNumber?.toUpperCase() === drawingNumber.toUpperCase(),
        )
      )
        throw fail(409, "drawing-number-taken");
      const revision = field(text, "revision") ?? "";
      const check = checkNextRevision([], null, revision);
      if (!check.ok) throw fail(409, check.problem);
      const doc: Doc = {
        id: randomUUID(),
        projectId,
        category,
        title: field(text, "title") ?? "",
        drawingNumber,
        discipline: (field(text, "discipline") || null) as DrawingDiscipline | null,
        reference: field(text, "reference") || null,
        status: "active",
        createdBy: actor,
        createdAt: now,
        updatedAt: now,
        version: 1,
        withdrawal: null,
      };
      state.documents.push(doc);
      state.versions.push({
        id: randomUUID(),
        documentId: doc.id,
        versionNo: 1,
        revision,
        issuePurpose: (field(text, "issuePurpose") || null) as IssuePurpose | null,
        changeNote: field(text, "changeNote") || null,
        fileName: file.name,
        contentType,
        content: file.content,
        sha256: sha(file.content),
        uploadedBy: actor,
        uploadedAt: now,
        supersededAt: null,
        supersededById: null,
      });
      return { status: 201, body: detail(doc), schema: documentResponseSchema };
    }
    const docRoute = /^([^/]+)(?:\/(withdraw|versions))?$/.exec(rest);
    const doc = docRoute ? docs.find((entry) => entry.id === docRoute[1]) : undefined;
    if (!docRoute || !doc) throw fail(404, "not-found");
    const action = docRoute[2];
    if (!action && method === "GET") return { body: detail(doc), schema: documentResponseSchema };
    requireWrite(manage(projectId));
    if (doc.status === "withdrawn") throw fail(409, "document-withdrawn");
    if (!action && method === "PATCH") {
      const input = parse(updateDocumentRequestSchema, body);
      if (input.version !== doc.version) throw fail(409, "version-conflict");
      Object.assign(doc, {
        ...(input.title !== undefined ? { title: input.title } : {}),
        ...(input.drawingNumber !== undefined ? { drawingNumber: input.drawingNumber } : {}),
        ...(input.discipline !== undefined ? { discipline: input.discipline } : {}),
        ...(input.reference !== undefined ? { reference: input.reference } : {}),
        version: doc.version + 1,
        updatedAt: now,
      });
      return { body: detail(doc), schema: documentResponseSchema };
    }
    if (action === "withdraw" && method === "POST") {
      const input = parse(withdrawDocumentRequestSchema, body);
      if (input.version !== doc.version) throw fail(409, "version-conflict");
      Object.assign(doc, {
        status: "withdrawn",
        withdrawal: { by: actor, at: now, reason: input.reason },
        version: doc.version + 1,
        updatedAt: now,
      });
      return { body: detail(doc), schema: documentResponseSchema };
    }
    if (action === "versions" && method === "POST") {
      const { text, file, contentType } = upload();
      const current = currentOf(doc.id);
      if (field(text, "basedOnVersionId") !== current.id) throw fail(409, "version-stale");
      const revision = field(text, "revision") ?? "";
      const check = checkNextRevision(
        versionsOf(doc.id).map((version) => version.revision),
        current.revision,
        revision,
      );
      if (!check.ok) throw fail(409, check.problem);
      const created: Version = {
        id: randomUUID(),
        documentId: doc.id,
        versionNo: current.versionNo + 1,
        revision,
        issuePurpose: (field(text, "issuePurpose") || null) as IssuePurpose | null,
        changeNote: field(text, "changeNote") || null,
        fileName: file.name,
        contentType,
        content: file.content,
        sha256: sha(file.content),
        uploadedBy: actor,
        uploadedAt: now,
        supersededAt: null,
        supersededById: null,
      };
      current.supersededAt = now;
      current.supersededById = created.id;
      state.versions.push(created);
      Object.assign(doc, { version: doc.version + 1, updatedAt: now });
      return { status: 201, body: detail(doc), schema: documentResponseSchema };
    }
    throw fail(404, "not-found");
  }

  if (area === "compliance") {
    if (rest === "" && method === "GET") {
      const items = activeTypes().map((type) => itemOf(type, projectId));
      const entry = project(projectId)!;
      return {
        body: {
          project: { id: entry.id, code: entry.code, name: entry.name },
          today,
          items,
          counts: complianceCounts(items.map((item) => item.status)),
          reminders: sortReminders(items.flatMap((item) => reminderOf(item, entry) ?? [])),
          permissions: {
            canRecord: manage(projectId) && writable(projectId),
            canRecordCompany: configure,
            canExport: true,
            canConfigure: configure,
          },
        },
        schema: complianceRegisterResponseSchema,
      };
    }
    if (rest === "" && method === "POST") {
      requireWrite(manage(projectId));
      return recordCompliance(projectId);
    }
    const item = /^items\/([^/]+)$/.exec(rest);
    if (item && method === "GET") {
      const type = state.types.find((entry) => entry.id === item[1]);
      if (!type) throw fail(404, "not-found");
      return history(type, projectId);
    }
    throw fail(404, "not-found");
  }

  if (area === "instructions") {
    const list = state.instructions.filter((entry) => entry.projectId === projectId);
    const row = (entry: Instruction) => ({
      id: entry.id,
      number: entry.number,
      kind: entry.kind,
      subject: entry.subject,
      issuerName: entry.issuerName,
      issuerRole: entry.issuerRole,
      issuerFirm: entry.issuerFirm,
      issuedOn: entry.issuedOn,
      receivedOn: entry.receivedOn,
      status: entry.status,
      costImplication: entry.costImplication,
      timeImplication: entry.timeImplication,
      attachments: entry.attachments.length,
      responses: entry.responses.length,
      variations: 0,
      delayLinked: false,
      version: entry.version,
    });
    const versionLink = (versionId: string) => {
      const found = linked(versionId, projectId);
      if (!found || !found.seen) return null;
      return {
        documentId: found.doc.id,
        versionId: found.version.id,
        title: found.doc.title,
        category: found.doc.category,
        revision: found.version.revision,
        state: found.version.supersededAt ? ("superseded" as const) : ("current" as const),
      };
    };
    const instructionDetail = (entry: Instruction, replayed?: boolean) => {
      const record = recordInstruction(projectId) && writable(projectId);
      const manageIt = manageInstruction(projectId) && writable(projectId);
      const issuer = entry.issuedBy?.id === actor.id;
      return {
        instruction: {
          ...row(entry),
          description: entry.description,
          issuedBy: entry.issuedBy,
          delay: null,
          variationList: [],
          legacyAttachments: [],
          attachmentList: entry.attachments.map((attachment) => {
            const document = attachment.versionId ? versionLink(attachment.versionId) : null;
            const photo = attachment.photoId
              ? (deps.photos(projectId).find((candidate) => candidate.id === attachment.photoId) ??
                null)
              : null;
            return {
              id: attachment.id,
              kind: attachment.versionId ? ("document_version" as const) : ("site_photo" as const),
              document,
              photo,
              restricted: attachment.versionId !== null && document === null,
              addedBy: attachment.addedBy,
              addedAt: attachment.addedAt,
            };
          }),
          responseList: entry.responses,
          createdBy: entry.createdBy,
          createdAt: entry.createdAt,
          updatedAt: entry.updatedAt,
          permissions: {
            canEdit: manageIt && entry.status !== "closed",
            canNote: record && entry.status !== "closed",
            canAttach: record && entry.status !== "closed" && entry.attachments.length < 10,
            moves: instructionMoves(entry.status).filter((move) =>
              move === "close" || move === "reopen" ? manageIt : record && !issuer,
            ),
          },
        },
        ...(replayed ? { replayed: true } : {}),
      };
    };
    if (rest === "" && method === "GET") {
      const status = query.get("status");
      const kind = query.get("kind");
      const flag = query.get("flag");
      const search = query.get("search")?.toLowerCase();
      const filtered = list
        .filter((entry) =>
          !status ? true : status === "open" ? entry.status !== "closed" : entry.status === status,
        )
        .filter((entry) => !kind || entry.kind === kind)
        .filter(
          (entry) => !flag || (flag === "cost" ? entry.costImplication : entry.timeImplication),
        )
        .filter(
          (entry) =>
            !search ||
            [entry.number, entry.subject, entry.issuerName, entry.issuerFirm].some((value) =>
              value?.toLowerCase().includes(search),
            ),
        )
        .sort(
          (a, b) => b.receivedOn.localeCompare(a.receivedOn) || b.number.localeCompare(a.number),
        );
      const count = (test: (entry: Instruction) => boolean) => list.filter(test).length;
      return {
        body: {
          instructions: filtered.map(row),
          counts: {
            received: count((entry) => entry.status === "received"),
            acknowledged: count((entry) => entry.status === "acknowledged"),
            actioned: count((entry) => entry.status === "actioned"),
            closed: count((entry) => entry.status === "closed"),
            cost: count((entry) => entry.costImplication),
            time: count((entry) => entry.timeImplication),
          },
          total: filtered.length,
          nextCursor: null,
          permissions: { canRecord: recordInstruction(projectId) && writable(projectId) },
        },
        schema: instructionLogListResponseSchema,
      };
    }
    if (rest === "options" && method === "GET") {
      const numbers = list.map((entry) => entry.number);
      return {
        body: {
          nextNumbers: Object.fromEntries(
            INSTRUCTION_KINDS.map((kind) => [kind, suggestInstructionNumber(numbers, kind)]),
          ),
          delays: [],
          versions: state.versions
            .filter((version) => {
              const doc = state.documents.find((entry) => entry.id === version.documentId)!;
              return doc.projectId === projectId && visible(doc);
            })
            .map((version) => versionLink(version.id)!),
          photos: deps.photos(projectId),
          isConsultant: false,
        },
        schema: instructionOptionsResponseSchema,
      };
    }
    if (rest === "" && method === "POST") {
      requireWrite(recordInstruction(projectId));
      const input = parse(recordInstructionRequestSchema, body);
      const existing = state.instructions.find((entry) => entry.id === input.id);
      if (existing)
        return { body: instructionDetail(existing, true), schema: instructionLogResponseSchema };
      if (input.issuedOn > today || input.receivedOn > today)
        throw fail(422, "instruction-date-future");
      if (list.some((entry) => entry.number.toUpperCase() === input.number.toUpperCase()))
        throw fail(409, "instruction-number-taken");
      const created: Instruction = {
        id: input.id,
        projectId,
        number: input.number,
        kind: input.kind,
        issuerName: input.issuerName,
        issuerRole: input.issuerRole,
        issuerFirm: input.issuerFirm ?? null,
        issuedOn: input.issuedOn,
        receivedOn: input.receivedOn,
        subject: input.subject,
        description: input.description ?? null,
        status: "received",
        costImplication: input.costImplication,
        timeImplication: input.timeImplication,
        issuedBy: input.issuedByMe ? actor : null,
        createdBy: actor,
        createdAt: now,
        updatedAt: now,
        version: 1,
        idempotencyKey: null,
        responses: [],
        attachments: [],
      };
      state.instructions.push(created);
      return {
        status: 201,
        body: instructionDetail(created),
        schema: instructionLogResponseSchema,
      };
    }
    const route = /^([^/]+)(?:\/(responses|attachments))?$/.exec(rest);
    const entry = route ? list.find((candidate) => candidate.id === route[1]) : undefined;
    if (!route || !entry) throw fail(404, "not-found");
    const action = route[2];
    if (!action && method === "GET")
      return { body: instructionDetail(entry), schema: instructionLogResponseSchema };
    if (!action && method === "PATCH") {
      requireWrite(manageInstruction(projectId));
      if (entry.status === "closed") throw fail(409, "instruction-closed");
      const input = parse(updateInstructionLogRequestSchema, body);
      if (input.version !== entry.version) throw fail(409, "version-conflict");
      const fields = Object.fromEntries(
        Object.entries(input).filter(([key]) => key !== "version" && key !== "delayId"),
      );
      Object.assign(entry, fields, { version: entry.version + 1, updatedAt: now });
      return { body: instructionDetail(entry), schema: instructionLogResponseSchema };
    }
    if (action === "responses" && method === "POST") {
      const input = parse(instructionResponseRequestSchema, body);
      const closing = input.kind === "close" || input.kind === "reopen";
      requireWrite(closing ? manageInstruction(projectId) : recordInstruction(projectId));
      if (input.version !== entry.version) throw fail(409, "version-conflict");
      const result = instructionResponse({
        kind: input.kind,
        status: entry.status,
        body: input.body ?? null,
        actorId: actor.id,
        issuedBy: entry.issuedBy?.id ?? null,
      });
      if (!result.ok)
        throw fail(result.problem === "invalid-transition" ? 409 : 422, result.problem);
      entry.responses.push({
        id: randomUUID(),
        kind: input.kind,
        body: input.body ?? null,
        fromStatus: entry.status,
        toStatus: result.to,
        recordedBy: actor,
        recordedAt: now,
      });
      Object.assign(entry, { status: result.to, version: entry.version + 1, updatedAt: now });
      return { status: 201, body: instructionDetail(entry), schema: instructionLogResponseSchema };
    }
    if (action === "attachments" && method === "POST") {
      requireWrite(recordInstruction(projectId));
      if (entry.status === "closed") throw fail(409, "instruction-closed");
      const input = parse(instructionAttachmentRequestSchema, body);
      if (input.documentVersionId && !versionLink(input.documentVersionId))
        throw fail(422, "attachment-not-found");
      if (input.photoId) {
        const photo = deps.photos(projectId).find((candidate) => candidate.id === input.photoId);
        if (!photo) throw fail(422, "attachment-not-found");
        if (!photo.verified) throw fail(422, "photo-not-verified");
      }
      entry.attachments.push({
        id: randomUUID(),
        versionId: input.documentVersionId ?? null,
        photoId: input.photoId ?? null,
        addedBy: actor,
        addedAt: now,
      });
      return { status: 201, body: instructionDetail(entry), schema: instructionLogResponseSchema };
    }
    throw fail(404, "not-found");
  }

  // Approval requests ---------------------------------------------------------------------------
  const list = state.approvals.filter((approval) => approval.projectId === projectId);
  const sent = (approval: Approval) => {
    const found = linked(approval.versionId, projectId)!;
    return found;
  };
  const approvalRow = (approval: Approval) => {
    const found = sent(approval);
    const status = approvalState(approval);
    return {
      id: approval.id,
      code: code(approval.number),
      number: approval.number,
      kind: approval.kind,
      title: approval.title,
      addressedTo: approval.addressedTo,
      sentOn: approval.sentOn,
      dueOn: approval.dueOn,
      status,
      overdue: approvalOverdue(status, approval.dueOn, today),
      daysOverdue: approvalDaysOverdue(status, approval.dueOn, today),
      document: found.seen
        ? {
            restricted: false as const,
            documentId: found.doc.id,
            versionId: found.version.id,
            title: found.doc.title,
            category: found.doc.category,
            revision: found.version.revision,
            state: found.version.supersededAt ? ("superseded" as const) : ("current" as const),
            sha256: found.version.sha256,
            fileName: found.version.fileName,
            uploadedBy: found.version.uploadedBy,
          }
        : { restricted: true as const },
      raisedBy: approval.raisedBy,
      version: approval.version,
    };
  };
  const approvalDetail = (approval: Approval) => {
    const base = approvalRow(approval);
    const found = sent(approval);
    const pending = base.status === "pending";
    const manageIt = manage(projectId) && writable(projectId);
    const blocked = approvalResponseProblem({
      channel: "in_app",
      actorId: actor.id,
      raisedBy: approval.raisedBy.id,
      uploadedBy: found.version.uploadedBy.id,
    });
    const resubmission = state.approvals.find((entry) => entry.resubmissionOfId === approval.id);
    const original = approval.resubmissionOfId
      ? state.approvals.find((entry) => entry.id === approval.resubmissionOfId)
      : undefined;
    return {
      approval: {
        ...base,
        description: approval.description,
        raisedAt: approval.raisedAt,
        resubmissionOf: original ? { id: original.id, code: code(original.number) } : null,
        resubmittedAs: resubmission
          ? { id: resubmission.id, code: code(resubmission.number) }
          : null,
        response: approval.response
          ? (({ evidenceVersionId, ...response }) => ({
              ...response,
              evidence: evidenceOf(evidenceVersionId, projectId),
            }))(approval.response)
          : null,
        cancellation: approval.cancellation,
        permissions: {
          canRespond: manageIt && pending && blocked === null && found.seen,
          canRecordPaper: manageIt && pending && found.seen,
          canCancel: manageIt && pending && approval.raisedBy.id === actor.id,
          canResubmit:
            manageIt && (base.status === "rejected" || base.status === "resubmit") && !resubmission,
          respondBlockedBy: pending && manageIt ? blocked : null,
        },
      },
    };
  };
  if (rest === "" && method === "GET") {
    const status = query.get("status") ?? "all";
    const kind = query.get("kind");
    const search = query.get("search")?.toLowerCase();
    const rows = list.map(approvalRow);
    const filtered = rows
      .filter((entry) =>
        status === "all"
          ? true
          : status === "overdue"
            ? entry.overdue
            : status === "decided"
              ? !["pending", "cancelled"].includes(entry.status)
              : entry.status === status,
      )
      .filter((entry) => !kind || entry.kind === kind)
      .filter(
        (entry) =>
          !search ||
          [entry.code, entry.title, entry.addressedTo].some((value) =>
            value.toLowerCase().includes(search),
          ),
      )
      .sort((a, b) => b.number - a.number);
    return {
      body: {
        approvals: filtered,
        counts: {
          pending: rows.filter((entry) => entry.status === "pending").length,
          overdue: rows.filter((entry) => entry.overdue).length,
          decided: rows.filter((entry) => !["pending", "cancelled"].includes(entry.status)).length,
          cancelled: rows.filter((entry) => entry.status === "cancelled").length,
        },
        total: filtered.length,
        nextCursor: null,
        permissions: { canRaise: manage(projectId) && writable(projectId) },
      },
      schema: approvalListResponseSchema,
    };
  }
  if (rest === "" && method === "POST") {
    requireWrite(manage(projectId));
    const input = parse(raiseApprovalRequestSchema, body);
    const found = linked(input.documentVersionId, projectId);
    if (!found || found.doc.projectId !== projectId) throw fail(422, "attachment-not-found");
    if (!found.seen) throw fail(403, "confidential-category");
    if (found.version.supersededAt || found.doc.status !== "active")
      throw fail(409, "approval-document-not-current");
    if (input.sentOn > today) throw fail(422, "approval-date-invalid");
    const created: Approval = {
      id: randomUUID(),
      projectId,
      number: list.length + 1,
      kind: input.kind,
      title: input.title,
      description: input.description ?? null,
      versionId: input.documentVersionId,
      addressedTo: input.addressedTo,
      sentOn: input.sentOn,
      dueOn: input.dueOn,
      raisedBy: actor,
      raisedAt: now,
      resubmissionOfId: input.resubmissionOfId ?? null,
      response: null,
      cancellation: null,
      version: 1,
    };
    state.approvals.push(created);
    return { status: 201, body: approvalDetail(created), schema: approvalResponseSchema };
  }
  const route = /^([^/]+)(?:\/(response|cancel))?$/.exec(rest);
  const approval = route ? list.find((entry) => entry.id === route[1]) : undefined;
  if (!route || !approval) throw fail(404, "not-found");
  if (!route[2] && method === "GET")
    return { body: approvalDetail(approval), schema: approvalResponseSchema };
  requireWrite(manage(projectId));
  if (approvalState(approval) !== "pending") throw fail(409, "approval-not-pending");
  if (route[2] === "response" && method === "POST") {
    const input = parse(approvalResponseRequestSchema, body);
    if (input.version !== approval.version) throw fail(409, "version-conflict");
    const found = sent(approval);
    const problem = approvalResponseProblem({
      channel: input.channel,
      actorId: actor.id,
      raisedBy: approval.raisedBy.id,
      uploadedBy: found.version.uploadedBy.id,
    });
    if (problem) throw fail(403, problem);
    if (input.documentSha256 !== found.version.sha256) throw fail(409, "approval-digest-mismatch");
    if (input.respondedOn < approval.sentOn || input.respondedOn > today)
      throw fail(422, "approval-date-invalid");
    if (input.channel === "paper") {
      const evidence = linked(input.evidenceVersionId!, projectId);
      if (!evidence || !evidence.seen || evidence.doc.projectId !== projectId)
        throw fail(422, "approval-evidence-invalid");
    }
    approval.response = {
      decision: input.decision,
      comments: input.comments ?? null,
      respondedOn: input.respondedOn,
      channel: input.channel,
      responderName: input.channel === "paper" ? input.responderName! : actor.displayName,
      responderFirm: input.channel === "paper" ? (input.responderFirm ?? null) : null,
      responder: input.channel === "in_app" ? actor : null,
      evidenceVersionId: input.channel === "paper" ? (input.evidenceVersionId ?? null) : null,
      reviewedSha256: input.documentSha256,
      recordedBy: actor,
      recordedAt: now,
    };
    approval.version += 1;
    return { status: 201, body: approvalDetail(approval), schema: approvalResponseSchema };
  }
  if (route[2] === "cancel" && method === "POST") {
    const input = parse(cancelApprovalRequestSchema, body);
    if (approval.raisedBy.id !== actor.id) throw fail(403, "forbidden");
    if (input.version !== approval.version) throw fail(409, "version-conflict");
    approval.cancellation = { by: actor, at: now, reason: input.reason };
    approval.version += 1;
    return { body: approvalDetail(approval), schema: approvalResponseSchema };
  }
  throw fail(404, "not-found");
}

/** A version's bytes for the download route (or null when the caller may not see it). */
export function documentDownload(
  deps: Pick<DocumentsDeps, "projects">,
  state: DocumentsState,
  projectId: string,
  documentId: string,
  versionId: string,
): { content: Buffer; contentType: string; fileName: string; state: string } | null {
  const entry = deps.projects.find((candidate) => candidate.id === projectId);
  const permissions = entry?.permissions ?? [];
  if (!permissions.includes("projects.view") || !has(permissions, DOCUMENT_READ_PERMISSIONS))
    return null;
  const doc = state.documents.find((candidate) => candidate.id === documentId);
  if (!doc || doc.projectId !== projectId) return null;
  if (isConfidentialCategory(doc.category) && !has(permissions, DOCUMENT_CONFIDENTIAL_PERMISSIONS))
    return null;
  const version = state.versions.find(
    (candidate) => candidate.id === versionId && candidate.documentId === documentId,
  );
  if (!version) return null;
  const superseded = version.supersededAt !== null;
  const stem = version.fileName.replace(/\.[^.]+$/, "");
  const extension = version.fileName.slice(stem.length) || ".pdf";
  return {
    content: version.content,
    contentType: version.contentType,
    fileName: `${stem}_rev-${version.revision}${superseded ? "_SUPERSEDED" : ""}${extension}`,
    state: superseded ? "superseded" : "current",
  };
}
