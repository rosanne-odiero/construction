export type DocumentsState = {
  documents: Doc[];
  versions: Version[];
  types: ComplianceType[];
  records: ComplianceRecordRow[];
  instructions: Instruction[];
  approvals: Approval[];
};

const has = (permissions: readonly string[], list: readonly string[]) =>
  list.some((key) => permissions.includes(key));
const sha = (content: Buffer) => createHash("sha256").update(content).digest("hex");
const pdf = (label: string) =>
  Buffer.from(`%PDF-1.4\n1 0 obj << /Title (${label}) >> endobj\ntrailer << >>\n%%EOF\n`, "latin1");
const at = (date: string, time = "09:00") => `${date}T${time}:00+03:00`;
const typeIdOf = (index: number) =>
  `8a000000-0000-4000-8000-${String(index + 1).padStart(12, "0")}`;

