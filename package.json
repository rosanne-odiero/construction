{
  "name": "pm-buddy",
  "private": true,
  "description": "PM-Buddy: construction project management for Kenya",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "i18n:check": "turbo run i18n:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose -f infra/docker/compose.yaml up -d --wait",
    "services:down": "docker compose -f infra/docker/compose.yaml down",
    "db:migrate": "turbo run db:migrate --filter=@pm-buddy/api",
    "db:seed": "turbo run db:seed --filter=@pm-buddy/api"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
