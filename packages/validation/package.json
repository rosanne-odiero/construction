{
  "name": "@pm-buddy/validation",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas shared by PM-Buddy web, site app and API",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware src",
    "test": "vitest run"
  },
  "dependencies": {
    "@pm-buddy/domain": "workspace:*",
    "@pm-buddy/types": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pm-buddy/config": "workspace:*",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
