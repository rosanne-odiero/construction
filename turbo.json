{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".oxlintrc.json", "packages/config/tsconfig/*.json"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_MIGRATION_URL",
    "REDIS_URL",
    "S3_*",
    "OTEL_*",
    "PORT",
    "LOG_LEVEL",
    "APP_VERSION",
    "GIT_SHA",
    "API_DOCS_ENABLED",
    "HEALTH_CHECK_TIMEOUT_MS",
    "API_INTERNAL_URL",
    "PLAYWRIGHT_WEB_PORT",
    "PLAYWRIGHT_MOCK_API_PORT",
    "CI"
  ],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "env": ["API_INTERNAL_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    "i18n:check": {},
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["NODE_ENV"]
    }
  }
}
